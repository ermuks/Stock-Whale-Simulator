    "numberWrap": false,
    "numericLayoutReservedWidth": true,
    "buttonAutoResizeMax2Lines": false
  },
  "states": {
    "normal": "solid white icon / secondary contrast",
    "hover": "surface hover",
    "selected": "teal icon or underline, not a large gradient",
    "disabled": "muted and noninteractive",
    "running": "teal status and progress",
    "completed": "check",
    "failed": "failed icon + short cause",
    "locked": "lock icon only for Tablet 2 lock screen"
