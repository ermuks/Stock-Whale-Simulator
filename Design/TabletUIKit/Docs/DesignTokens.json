    "panelRadius": 8,
    "buttonRadius": 6,
    "dividerPx": 1
  },
  "component": {
    "primaryButtonMinHeight": 52,
    "secondaryButtonMinHeight": 44,
    "inputMinHeight": 48,
    "tabMinHeight": 48,
    "listRowMinHeight": 54,
    "iconToolbarPx": 24,
    "iconFeaturePx": 32,
    "minScreenReadableTextPx": 16,
    "mainValuePx": "28-34 at source scale; verify perceived size on world-space tablet"
