{
  "name": "DonDon Tablet UI",
  "design": "Dark Minimal / Solid Icons / Flat UI",
  "colors": {
    "background": "#0C141B",
    "panel": "#121E26",
    "panelHover": "#1A2A33",
    "divider": "#2A3B45",
    "textPrimary": "#F4F7F9",
    "textSecondary": "#A6B4C0",
    "textMuted": "#6E818E",
    "accent": "#2EE8CF",
    "profitKR": "#F16C73",
    "lossKR": "#5AAAF5",
    "warning": "#F2BC64",
    "disabled": "#53636C",
    "iconSource": "#FFFFFF",
    "notes": "Sprite pixels remain white; apply state colors with Unity Image.color"
