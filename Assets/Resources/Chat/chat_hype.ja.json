{
  "schemaVersion": 1,
  "clockFormat": "{h}時{m}分",
  "breath": {
    "spaced": false, "afterWholeWord": false, "minPiece": 4, "minTotal": 12,
    "gapBaseSec": 0.6, "gapPerCharSec": 0.08, "gapMaxSec": 2.4, "dropTail": "。",
    "openers": ["っていうか", "ていうか", "てか", "いや", "まあ", "正直", "ちなみに", "なんか", "でも", "あと", "待って", "ねえ", "うわ", "やば", "え", "あ"],
    "after": ["んだけど", "けれど", "けど", "のに", "ので", "だし", "じゃん", "だよね", "んだよね"],
    "before": []
  },
  "crowd": [
    { "key": "discover", "holding": "any", "texts": ["え、{stockName}なに", "{stockName}どうした", "{stockName}の出来高見て", "{stockName}なんか出た？", "ちょっと{stockName}のチャート見て", "{stockName}急に動いた", "誰か{stockName}触った？", "{stockName}いま{movePct}%ってマジ？"] },
    { "key": "flood", "holding": "any", "texts": ["やば", "え", "まじか", "うおおお", "草", "なにこれ", "ガチで？", "{movePct}%は草", "どこまで行くの", "祭りだ", "爆上げ", "きたきた", "えぐい", "これは夢", "{stockName}なにごと"] },
    { "key": "flood", "holding": "held", "texts": ["乗ってる", "握ってた", "やっと来た", "売らなくてよかった", "まだ売らない", "耐えた甲斐あった", "もっと行け", "ガチホ"] },
    { "key": "flood", "holding": "notHeld", "texts": ["俺だけ持ってない", "今から乗っていい？", "乗った人いる？", "買っとけばよかった", "乗り遅れた", "見てるだけ", "昨日買おうとしたのに", "つら"] },
    { "key": "flood", "holding": "any", "tone": "formal", "texts": ["すごいですね", "これは何事ですか", "{stockName}、何があったんですか", "{movePct}%ですか", "どこまで行くんでしょう", "信じられないです"] },
    { "key": "flood", "holding": "held", "tone": "formal", "texts": ["持っていてよかったです", "もう少し持ちます", "やっと来ましたね"] },
    { "key": "flood", "holding": "notHeld", "tone": "formal", "texts": ["私だけ持ってないです", "今から入ってもいいですか", "乗り遅れました"] },
    { "key": "heat", "holding": "any", "texts": ["{stockName}見てるってさっきから言ってた", "今からじゃ遅い？", "遅いって言う人が一番最後に乗る", "こういうのは初動で乗るもの", "ここからまだ行ったら本物", "出来高的にまだ終わってない", "ここで入るのは怖い", "{movePct}%ならそろそろ休む"] },
    { "key": "heat", "holding": "held", "texts": ["どこで売るか悩む", "半分だけ売ろうかな", "持ってる人、手あげて", "今回は初動で乗れた", "売ったらもっと上がりそうで売れない"] },
    { "key": "heat", "holding": "notHeld", "texts": ["押したら買う", "乗らない。見るのはタダ", "乗りたいのに指が動かない", "次こそ乗る", "他人の祭りを見学中"] },
    { "key": "break", "holding": "any", "texts": ["…", "あ", "誰か投げた？", "ちょっと待って", "なんで折れた", "急に静か", "いまの何"] },
    { "key": "break", "holding": "held", "texts": ["あ", "売っとけばよかった", "まだ持ってるけど", "大丈夫、戻る。たぶん", "チャート見てない"] },
    { "key": "break", "holding": "notHeld", "texts": ["乗らなくてよかった", "ふう", "ほんと見るのはタダ", "危うく買うとこだった"] },

    { "key": "crashDiscover", "holding": "any", "texts": ["え、{stockName}なんで下げてる", "{stockName}なにがあった", "{stockName}急にどうした", "ちょっと{stockName}見て", "{stockName}誰が投げてる", "{stockName}{movePct}%ってなに"] },
    { "key": "crashFlood", "holding": "any", "texts": ["やば", "え", "うわ", "なにごと", "ナイアガラ", "{movePct}%はえぐい", "底どこ", "まだ下あった", "止まらん", "これはひどい", "助けて"] },
    { "key": "crashFlood", "holding": "held", "texts": ["あ", "捕まった", "損切りかな", "助けてください", "耐えるべき？", "目つぶった", "これ持ってるの俺だけ？", "口座見ない"] },
    { "key": "crashFlood", "holding": "notHeld", "texts": ["買わなくてよかった", "見てるだけでよかった", "持ってる人大丈夫？", "拾っていい？", "落ちるナイフ見学中"] },
    { "key": "crashFlood", "holding": "any", "tone": "formal", "texts": ["何があったんですか", "これは何事ですか", "下げすぎです", "底はどこでしょう"] },
    { "key": "crashFlood", "holding": "held", "tone": "formal", "texts": ["困りました", "耐えるべきでしょうか", "口座が見られません"] },
    { "key": "crashFlood", "holding": "notHeld", "tone": "formal", "texts": ["買わなくてよかったです", "お持ちの方は大丈夫ですか"] },
    { "key": "crashHeat", "holding": "any", "texts": ["こうなると思ってたって人、必ず出る", "下げるのに理由はいらない", "ここで反発しなかったら本物", "出来高見て、みんな投げてる", "{movePct}%はさすがにやりすぎ", "さっき気をつけてって言った"] },
    { "key": "crashHeat", "holding": "held", "texts": ["いま売ったら底になりそうで売れない", "ナンピンすべき？", "建値に戻ったら売る", "取得単価の話はしないで"] },
    { "key": "crashHeat", "holding": "notHeld", "texts": ["もっと下で買う", "いま入る人は勇者", "底を確認してから", "現金が一番楽"] },
    { "key": "crashBreak", "holding": "any", "texts": ["あ", "反発？", "戻ってきた", "え、なにこれ", "誰が拾った", "だまされるな"] },
    { "key": "crashBreak", "holding": "held", "texts": ["助かった", "そのまま行って", "まだ遠い", "売った人いないよね"] },
    { "key": "crashBreak", "holding": "notHeld", "texts": ["買っとけばよかった", "底で買えなかった", "また逃した"] }
  ],
  "setups": [
    { "key": "catEars", "when": "surge", "lean": "up", "topic": "猫の話", "text": "さっきのローソク足3本、猫の耳の形でした。猫は落ちても着地します。" },
    { "key": "nameLength", "when": "surge", "lean": "up", "topic": "文字数の話", "text": "{stockName}は{nameLen}文字です。{nameLen}文字の名前は粘ります。" },
    { "key": "ramen", "when": "surge", "lean": "up", "topic": "ラーメンの話", "text": "{movePct}%動きました。うちの近所のラーメンもこれくらい値上げして、戻りませんでした。" },
    { "key": "stairs", "when": "surge", "lean": "up", "topic": "階段の話", "text": "チャートが階段の形です。階段は上るために作ります。" },
    { "key": "digit", "when": "surge", "lean": "down", "topic": "数字の話", "text": "いまの値段、最後の数字が{digit}です。好きな数字ではありません。" },
    { "key": "height", "when": "surge", "lean": "down", "topic": "身長の話", "text": "このローソク足、私の身長と同じです。私は高校から伸びていません。" },
    { "key": "thirsty", "when": "surge", "lean": "down", "text": "チャットが{count}行流れました。よくしゃべる日は、株ものどが渇きます。" },
    { "key": "dog", "when": "surge", "lean": "down", "topic": "犬の話", "text": "いま{clock}です。この時間はうちの犬も興奮します。犬はすぐ疲れます。" },
    { "key": "thin", "when": "surge", "lean": "down", "topic": "細長い話", "text": "ローソク足が上に細長いです。細長いものはよく曲がります。" },
    { "key": "whereTo", "when": "surge", "lean": "any", "text": "みなさん「行け」と言っています。どこへ行くのかは誰も言っていません。" },

    { "key": "library", "when": "break", "lean": "up", "topic": "図書館の話", "text": "静かになりました。図書館も静かです。図書館ではみんな何かを積み上げています。" },
    { "key": "exclamation", "when": "break", "lean": "up", "topic": "びっくりマークの話", "text": "いま落ちた足、びっくりマークの形です。びっくりマークは文の最後にしか来ません。" },
    { "key": "breathing", "when": "break", "lean": "up", "text": "{stockName}はいま息をしただけです。人も息をしないと大変です。" },
    { "key": "handWash", "when": "break", "lean": "up", "topic": "手洗いの話", "text": "天井で売った人は、いま手を洗っています。洗い終わると暇になります。" },
    { "key": "nap", "when": "break", "lean": "up", "topic": "昼寝の話", "text": "{clock}に折れました。私もこの時間に昼寝します。起きるとすっきりします。" },
    { "key": "umbrella", "when": "break", "lean": "down", "topic": "傘の話", "text": "折れた角度がうちの傘と同じです。その傘は去年捨てました。" },
    { "key": "teacher", "when": "break", "lean": "down", "topic": "先生の話", "text": "みなさん黙りました。うちのクラスも先生が来る直前はこうでした。" },

    { "key": "grip", "when": "crash", "lean": "down", "topic": "手の力の話", "text": "みなさん驚いています。驚くと手の力が抜けます。力が抜けると物を落とします。" },
    { "key": "elevator", "when": "crash", "lean": "up", "topic": "エレベーターの話", "text": "落ちる速さがうちのエレベーターと同じです。あのエレベーターは1階で必ず止まります。" },
    { "key": "weight", "when": "crash", "lean": "up", "topic": "体重の話", "text": "{movePct}%動きました。私の体重もこれくらい減って、全部戻りました。" },
    { "key": "icicle", "when": "crash", "lean": "down", "topic": "つららの話", "text": "足が下に細長いです。つららも細長いです。つららは春まで残ります。" },
    { "key": "helpWho", "when": "crash", "lean": "any", "text": "チャットが{count}行流れました。みなさん助けてと言っていますが、誰に言っているのか分かりません。" },
    { "key": "easyRead", "when": "crash", "lean": "up", "topic": "読みやすい数字の話", "text": "{stockName}はいま{price}ウォンです。さっきより読みやすくなりました。読みやすい数字には情がわきます。" },

    { "key": "doubleClick", "when": "playerBuy", "lean": "any", "text": "いま大きく買った方、手が震えて2回押しています。だから量が2倍です。" },
    { "key": "chairEdge", "when": "playerBuy", "lean": "down", "topic": "椅子の話", "text": "いま買った方は椅子に浅く座っています。浅く座ると長くはもちません。" },
    { "key": "bigHand", "when": "playerBuy", "lean": "down", "text": "大きいのが入りました。大口は手が大きいので、ボタンを押し間違えます。" },
    { "key": "noWater", "when": "playerBuy", "lean": "any", "text": "いま買った方は水を飲みに行けません。のどが渇くと判断が冴えます。違うかもしれません。" },
    { "key": "viewFee", "when": "playerBuy", "lean": "down", "topic": "展望料の話", "text": "誰かが天井で買いました。天井は眺めがいいです。展望料だと思えばいいです。" },
    { "key": "loudCar", "when": "playerBuy", "lean": "up", "topic": "車の話", "text": "いまの約定、音が大きかったです。音の大きい車は速いです。" },
    { "key": "counting", "when": "playerBuy", "lean": "any", "text": "いま買った方は数字を数えています。代わりに数えました。{price}ウォンです。" },

    { "key": "leanIn", "when": "playerDip", "lean": "any", "text": "いま拾った方、背もたれから背中を離しました。背中を離すと、もう一度買います。" },
    { "key": "manners", "when": "playerDip", "lean": "up", "topic": "礼儀の話", "text": "落ちてくるものを誰かが受けました。落ちてくるものは受けるのが礼儀です。" },
    { "key": "bigKnife", "when": "playerDip", "lean": "down", "topic": "ナイフの話", "text": "いま拾った方は手が大きいです。でもナイフも大きいです。" },
    { "key": "floorThinks", "when": "playerDip", "lean": "down", "topic": "底の話", "text": "誰かがここを底だと思っています。底は何も考えていません。" },
    { "key": "holdBreath", "when": "playerDip", "lean": "any", "text": "いま拾った方は息を止めています。息は{minutes}分も止められません。" },
    { "key": "oneOfTwo", "when": "playerDip", "lean": "any", "text": "いま拾った方は明日自慢します。または黙ります。どちらかです。" },

    { "key": "shoulders", "when": "playerSell", "lean": "up", "topic": "肩の話", "text": "いま大きく売った方は肩が軽いです。肩が軽いと、また何か持ちたくなります。" },
    { "key": "noLookBack", "when": "playerSell", "lean": "any", "text": "誰かが一度に投げました。一度に投げる人は後ろを見ません。後ろに何があるかは私も知りません。" },
    { "key": "pretend", "when": "playerSell", "lean": "any", "topic": "見ないふりの話", "text": "いま売った方はチャートを見ていないふりをしています。ふりは3分が限界です。" },
    { "key": "emptyRoom", "when": "playerSell", "lean": "up", "topic": "空き部屋の話", "text": "大きな荷物が出ていきました。荷物を出すと部屋が広く見えます。広い部屋には人が来ます。" },
    { "key": "dust", "when": "playerSell", "lean": "down", "topic": "ほこりの話", "text": "いま売った方は手をはたきました。はたくとほこりが舞います。ほこりは沈みます。" },

    { "key": "zeros", "when": "round", "lean": "any", "topic": "ゼロの話", "text": "{round}ウォンを行き来しています。ゼロが多いと数字は重いです。重いものは動きにくいです。" },
    { "key": "mother", "when": "round", "lean": "down", "topic": "母の話", "text": "{round}ウォンです。きりのいい数字は気分がいいです。気分がいいときに買うなと母が言っていました。" },
    { "key": "birthday", "when": "round", "lean": "any", "topic": "誕生日の話", "text": "いま{round}ウォンを通りました。私も誕生日を過ぎたとき、特に何も感じませんでした。" },
    { "key": "queue", "when": "round", "lean": "up", "topic": "行列の話", "text": "みなさん{round}ウォンに集まっています。人が並ぶ店はおいしい店です。" },

    { "key": "inventor", "when": "lull", "lean": "any", "solo": true, "text": "何も起きていません。ところで株は誰が最初に作ったんでしょう。その人は含み損でしたか。" },
    { "key": "backwards", "when": "lull", "lean": "any", "solo": true, "text": "静かです。{stockName}を逆から読んでみました。意味はありませんでした。" },
    { "key": "crab", "when": "lull", "lean": "up", "topic": "カニの話", "text": "チャートが横にしか進みません。カニも横にしか進みません。カニはそれでも目的地に着きます。" },
    { "key": "theyKnow", "when": "lull", "lean": "any", "solo": true, "text": "いま{clock}です。誰も話しません。みなさん何か知っている気がします。" },
    { "key": "monday", "when": "lull", "lean": "any", "topic": "月曜日の話", "text": "{stockName}が{price}ウォンから動きません。私も月曜日は動きません。" },
    { "key": "knuckle", "when": "lull", "lean": "any", "solo": true, "text": "1時間ローソク足の長さを測っています。定規がないので指で測りました。指の関節ひとつ半です。" },

    { "key": "toothbrush", "when": "open", "lean": "any", "solo": true, "text": "始まりました。さっき歯を磨きました。歯を磨いて買った日は負けたことがありません。買ったこともありません。" },
    { "key": "mood", "when": "open", "lean": "any", "text": "朝です。{stockName}の最初の足は私の気分と同じ方向です。私の気分はまだ分かりません。" },
    { "key": "worm", "when": "open", "lean": "down", "topic": "虫の話", "text": "いま{clock}です。早起きの鳥は虫を捕まえます。虫の気持ちは誰も聞きません。" },
    { "key": "goodFeeling", "when": "open", "lean": "any", "solo": true, "text": "今日はいい予感がします。昨日もしました。昨日の結果は聞かないでください。" },

    { "key": "restroom", "when": "close", "lean": "any", "topic": "トイレの話", "text": "もうすぐ終わります。終わる前はみんな急ぎます。トイレもそうです。" },
    { "key": "lastTrain", "when": "close", "lean": "up", "topic": "終電の話", "text": "いま{clock}です。終電は混みます。でも終電に乗った人は家には帰れます。" },
    { "key": "staring", "when": "close", "lean": "any", "solo": true, "text": "今日は{stockName}を一度も見ませんでした。向こうも私を見ませんでした。引き分けです。" },
    { "key": "learned", "when": "close", "lean": "any", "solo": true, "text": "もうすぐ終わります。今日学んだことはありません。明日も来ます。" },

    {"key": "restIsMarket", "when": "lull", "lean": "any", "solo": true, "text": "静かです。こういう日は「休むも相場」と言います。私は毎日休んでいます。"},
    {"key": "mouMada", "when": "surge", "lean": "up", "topic": "「もうはまだなり」の話", "text": "「もうはまだなり」と言います。私はさっき「もう」と言いました。なのでまだです。"},
    {"key": "headTail", "when": "close", "lean": "any", "solo": true, "text": "「頭と尻尾はくれてやれ」と言います。私は胴体ももらっていません。"}
  ],
  "verdicts": [
    { "key": "upIn", "lean": "up", "predict": true, "text": "{minutes}分後に上がります。" },
    { "key": "upAbove", "lean": "up", "predict": true, "text": "なので{minutes}分後はいまより上です。" },
    { "key": "upWait", "lean": "up", "predict": true, "text": "{minutes}分待てば大丈夫です。上がります。" },
    { "key": "upAllIn", "lean": "up", "predict": false, "text": "全力で買います。" },
    { "key": "upBuy", "lean": "up", "predict": false, "text": "なので私は買います。" },
    { "key": "upMore", "lean": "up", "predict": false, "text": "まだ上がります。理由はいま言いました。" },
    { "key": "upBelieve", "lean": "up", "predict": false, "text": "私は信じます。根拠はいまの話です。" },
    { "key": "downIn", "lean": "down", "predict": true, "text": "{minutes}分後に下がります。" },
    { "key": "downBelow", "lean": "down", "predict": true, "text": "なので{minutes}分後はいまより下です。" },
    { "key": "downLeft", "lean": "down", "predict": true, "text": "あと{minutes}分です。そのあとは下がります。" },
    { "key": "downHere", "lean": "down", "predict": false, "text": "ここまでです。" },
    { "key": "downSkip", "lean": "down", "predict": false, "text": "なので私は買いません。" },
    { "key": "downSell", "lean": "down", "predict": false, "text": "私は売ります。持っていれば。" },
    { "key": "downWatch", "lean": "down", "predict": false, "text": "私は見ています。見るのは無料です。" },
    { "key": "anyNote", "lean": "any", "predict": false, "text": "参考までに。" },
    { "key": "anyOver", "lean": "any", "predict": false, "text": "以上です。" },
    { "key": "anyWrong", "lean": "any", "predict": false, "text": "外したことはあります。" },
    { "key": "anyNoRebuttal", "lean": "any", "predict": false, "text": "反論は受け付けません。" },
    { "key": "anyWrite", "lean": "any", "predict": false, "text": "メモしておいてください。" }
  ],
  "callbacks": [
    "さっきの{topic}は訂正します。逆でした。",
    "この前の{topic}はまだ有効です。",
    "{topic}を覚えている方はいますか。いなければ結構です。",
    "さっきの{topic}は忘れてください。今回が本物です。",
    "{topic}に付け足すことがあったんですが、忘れました。"
  ],
  "echoes": [
    { "key": "first", "texts": ["？", "？？", "え、上のなに", "なに言ってるの", "…はい？", "いま何か通った", "真顔で言うのが一番怖い", "誰も反論できてない", "誰か通訳して"] },
    { "key": "again", "texts": ["また始まった", "あの人この前もああだった", "今日も来た", "あの理屈ちょっと待ってた", "一応メモした", "本日のお言葉"] },
    { "key": "right", "texts": ["え、ほんとに当たってる", "うわ、合ってた", "偶然でしょ。偶然だよね？", "さっきのほんとになった", "あの人の話聞いとけばよかった"] },
    { "key": "wrong", "texts": ["さっき{minutes}分後って言ってた人どこ", "{minutes}分たちましたけど", "さっきの予言、静かに消えた", "やっぱり参考までにしといてよかった"] },
