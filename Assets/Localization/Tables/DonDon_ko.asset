      m_Items: []
  - m_Id: 1383700333
    m_Localized: "\uBE0C\uB79C\uB4DC\xB7\uBB38\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 1383700334
    m_Localized: "\uBE0C\uB79C\uB4DC\uAC00 \uC9D1\uB2E8\uC758 \uC815\uCCB4\uC131\uC774
      \uB418\uBA74 \uAE30\uC5C5 \uBE44\uD310\uC744 \uC790\uC2E0\uC5D0 \uB300\uD55C
      \uACF5\uACA9\uC73C\uB85C \uBC1B\uC544\uB4E4\uC774\uB294 \uBC18\uC751\uB3C4
      \uC0DD\uAE38 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700335
    m_Localized: "\uBE0C\uB79C\uB4DC\uB97C \uC9C0\uC9C0\uD558\uB294 \uC0AC\uB78C\uACFC
      \uC720\uD589\uC744 \uB530\uB77C \uB4E4\uC5B4\uC628 \uC0AC\uB78C\uC758 \uC778\uB0B4\uC2EC\uC740
      \uAC19\uC9C0 \uC54A\uC744 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700336
    m_Localized: "\uBE44\uAC00 \uACC4\uC18D \uC624\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700337
    m_Localized: "\uBE44\uC2B7\uD55C \uACE0\uBBFC\uC744 \uD574 \uBCF8 \uC801\uC740
      \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700338
    m_Localized: "\uBE44\uC2B7\uD55C \uAE30\uC220\uC744 \uAC00\uC9C4 \uACBD\uC7C1
      \uAE30\uC5C5\uACFC \uBE44\uAD50\uD560 \uC218 \uC788\uB294 \uC790\uB8CC\uAC00
      \uB0A8\uC544 \uC788\uB294 \uC9C8\uBB38\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700339
    m_Localized: "\uBE44\uC6A9\uACFC \uCC45\uC784\uC774 \uC5B4\uB5A4 \uC9D1\uB2E8\uC5D0
      \uB3CC\uC544\uAC00\uB294\uC9C0 \uCD94\uAC00 \uC124\uBA85\uC774 \uD544\uC694\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700340
    m_Localized: "\uBE44\uC728"
    m_Metadata:
      m_Items: []
  - m_Id: 1383700341
    m_Localized: "\uBE44\uD65C\uC131\uD654\uB41C \uC774\uC804 \uB9AC\uB529\uBC29\uC5D0\uC11C
      \uACF5\uC6A9 \uB77C\uC6B4\uC9C0\uB85C \uC774\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 1383700342
    m_Localized: "\uC0AC\uAC74\uACFC \uCCB4\uACB0\uC744 \uBE44\uAD50\uD558\uBA70
      \uAD00\uCC30\uD558\uC138\uC694."
