    m_Localized: "\uCCAB \uC2E0\uD638 \uAE30\uB2E4\uB9AC\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1392088151
    m_Localized: "\uCCAB \uC6C0\uC9C1\uC784 \uBCF4\uACE0 \uB108\uBB34 \uAE09\uD574\uC9C0\uC9C4
      \uB9D0\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1392088152
