  - m_Id: 1383700368
    m_Localized: "\uC0C1\uC7A5\uD3D0\uC9C0 \uBC29\uC5B4 \uC911\uB2E8"
    m_Metadata:
      m_Items: []
  - m_Id: 1383700369
    m_Localized: "\uC0C1\uC7A5\uD3D0\uC9C0 \uC190\uC2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1383700370
    m_Localized: "\uC0C8 \uAC70\uB798\uB294 \uBB3C\uB7C9\uBFD0 \uC544\uB2C8\uB77C
      \uD488\uC9C8 \uAE30\uC900\uACFC \uC6D0\uAC00 \uBD80\uB2F4\uB3C4 \uB3D9\uBC18\uD55C\uB2E4.
      {company}\uAC00 \uC870\uAC74\uC744 \uC774\uD589\uD560 \uC218 \uC788\uB294\uC9C0\uAC00
      \uD6C4\uC18D \uAD00\uCC30 \uB300\uC0C1\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700371
    m_Localized: "\uC0C8 \uACC4\uD68D"
    m_Metadata:
      m_Items: []
  - m_Id: 1383700372
    m_Localized: "\uC0C8 \uAE30\uC220\uC744 \uBA3C\uC800 \uC4F0\uB294 \uC774\uC6A9\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 1383700373
    m_Localized: "\uC0C8 \uB9E4\uC218 \uC2E0\uD638\uB294 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700374
    m_Localized: "\uC0C8 \uBA54\uC2DC\uC9C0 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1383700375
    m_Localized: "\uC0C8 \uC18C\uC2DD\uC774 \uAE30\uC874 \uAE30\uB300\uB97C \uC5BC\uB9C8\uB098
      \uBC14\uAFB8\uB294\uC9C0\uAC00 \uC911\uC694\uD558\uB2E4. \uC774\uBBF8 \uC54C\uB824\uC9C4
      \uB0B4\uC6A9\uC758 \uBC18\uBCF5\uC778\uC9C0 \uC0C8\uB85C\uC6B4 \uC0AC\uC2E4\uC778\uC9C0
      \uAD6C\uBD84\uD560 \uD544\uC694\uAC00 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700376
    m_Localized: "\uC0C8 \uC815\uBCF4\uAC00 \uAE30\uC874 \uC124\uBA85\uC744 \uBC14\uAFB8\uB294\uC9C0
