  - m_Id: 1383698547
    m_Localized: "{community} \uC548\uC5D0\uC11C \uACF5\uC720\uB418\uB294 \uACBD\uD5D8\uC740
      \uAD11\uACE0\uBCF4\uB2E4 \uAC15\uD55C \uC785\uC18C\uBB38\uC774 \uB420 \uC218
      \uC788\uB2E4. \uBC18\uB300 \uACBD\uD5D8\uB3C4 \uAC19\uC740 \uACBD\uB85C\uB85C
      \uD37C\uC9C8 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383698548
    m_Localized: "{community}\uAC00 \uD68C\uC0AC\uC5D0 \uAC16\uB294 \uAE30\uB300\uC640
      \uC8FC\uC8FC\uC758 \uC218\uC775 \uAE30\uB300\uB294 \uAC19\uC9C0 \uC54A\uB2E4.
      \uC0AC\uACFC, \uCC45\uC784, \uAC1C\uC120 \uC57D\uC18D\uC744 \uC5B4\uB5BB\uAC8C
      \uD3C9\uAC00\uD558\uB294\uC9C0 \uC758\uACAC\uC774 \uAC08\uB9B4 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
