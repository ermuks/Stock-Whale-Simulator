    m_Localized: "\uC120\uD0DD \uC885\uBAA9 \uC0C1\uC138  \u203A"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087043
    m_Localized: "\uC120\uD0DD\uD55C \uC608\uC0B0\uC73C\uB85C 1\uC8FC\uB97C \uC8FC\uBB38\uD560
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087044
    m_Localized: "\uC120\uD0DD\uD55C \uC885\uBAA9 \uC5C6\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087045
    m_Localized: "\uC124\uBA85 \uB4E4\uC73C\uB2C8\uAE4C \uC0DD\uAC01\uD560 \uAC70\uB9AC\uAC00
      \uC0DD\uAE30\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087046
    m_Localized: "\uC124\uBA85\uC740 \uADF8\uB7F4\uB4EF\uD55C\uB370 \uD655\uC778\uD560
      \uAC74 \uB0A8\uC558\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087047
    m_Localized: "\uC124\uBA85\uC740 \uADF8\uB7F4\uB4EF\uD55C\uB370 \uD655\uC778\uD560
      \uAC74 \uB0A8\uC558\uB124\uC694. \uCC38 \uB300\uB2E8\uD558\uC2DC\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087048
    m_Localized: "\uC124\uBA85\uC740 \uD6CC\uB96D\uD55C\uB370 \uD655\uC778\uD560
      \uBD80\uBD84\uC740 \uB0A8\uC544 \uC788\uAD70\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087049
    m_Localized: "\uC124\uBA85\uC740 \uD6CC\uB96D\uD55C\uB370 \uD655\uC778\uD560
      \uBD80\uBD84\uC740 \uB0A8\uC544 \uC788\uAD70\uC694. \uCC38 \uB300\uB2E8\uD558\uC2ED\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087050
    m_Localized: "\uC131\uACFC \uBCF4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087051
    m_Localized: "\uC131\uC7A5 \uAE30\uB85D\uC744 \uBD88\uB7EC\uC624\uB294 \uC911\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087052
    m_Localized: "\uC131\uC7A5\xB7\uAD8C\uD55C"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087053
    m_Localized: "\uC18C\uBE44\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087054
    m_Localized: "\uC18C\uBE44\uC790\uAC00 \uAE30\uC5C5\uC5D0 \uAC16\uB294 \uC560\uCC29\uC740
      \uC2E4\uC801\uBCF4\uB2E4 \uC624\uB798 \uB0A8\uC744 \uC218 \uC788\uB2E4. \uC775\uC219\uD55C
      \uC81C\uD488, \uACF5\uB3D9\uCCB4 \uACBD\uD5D8, \uBE0C\uB79C\uB4DC\uAC00 \uC0C1\uC9D5\uD558\uB294
      \uAC00\uCE58\uAC00 \uD568\uAED8 \uC791\uC6A9\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087055
    m_Localized: "\uC18C\uC1A1"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087056
    m_Localized: "\uC18C\uC218\uC810 \uC5C6\uC774 \uC6D0 \uB2E8\uC704 \uAC00\uACA9\uC744
      \uC785\uB825\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087057
    m_Localized: "\uC18C\uC2DD\uC744 \uC811\uD558\uC9C0 \uBABB\uD55C \uD22C\uC790\uC790\uB294
