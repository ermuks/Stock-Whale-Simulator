  m_TableData:
  - m_Id: 1341755392
    m_Localized: "\n\n<b>\uAD00\uB828 \uAE30\uC5C5 \xB7 \uC5F0\uACB0\uACE0\uB9AC</b>\n"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698432
    m_Localized: "\n\n<b>\uB77C\uC6B4\uC9C0 \uBC18\uC751</b>\n"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698433
    m_Localized: "\n\n<b>\uC55E\uC120 \uBCF4\uB3C4</b>\n"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698434
    m_Localized: "\n\n<size=26><color=#99A8B3>\uBCF4\uB3C4 \uC9C1\uC804 60\uCD08
      \xB7 \uC2E4\uC81C \uCCB4\uACB0 "
    m_Metadata:
      m_Items: []
  - m_Id: 1383698435
    m_Localized: "\n\n\uAD00\uCC30\uB41C \uCCB4\uACB0 \uC694\uC57D\uC785\uB2C8\uB2E4.
      \uC774\uD6C4 \uBC29\uD5A5\uC744 \uBCF4\uC7A5\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383698436
    m_Localized: "\n\n\uB2E4\uC74C \uD655\uC778 \uC9C0\uC810\n"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698437
    m_Localized: "\n\n\uBC30\uACBD\uACFC \uC774\uD574\uAD00\uACC4\n"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698438
    m_Localized: "\n\n\uC0AC\uD68C\uAC00 \uBC1B\uC544\uB4E4\uC774\uB294 \uBC29\uC2DD\n"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698439
    m_Localized: "\n\n\uCD5C\uADFC \uC8FC\uBB38 \uAE30\uB85D\n"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698440
    m_Localized: "\n1 \uAE30\uBCF8 \uACC4\uC88C / 2 \uC790\uB3D9 \uACC4\uC88C / 3
      \uC804\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698441
    m_Localized: "\n<color=#A6B1BA>\uB9E4\uB3C4 \uD638\uAC00\uB97C \uC18C\uC9C4\uD55C
      \uCCB4\uACB0\uB7C9 / \uC804\uCCB4 \uCCB4\uACB0\uB7C9\n\uC0C1\uC2B9 \uD655\uB960\uC744
      \uB73B\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.</color>\n\n"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698442
    m_Localized: "\n\uB300\uAE30 {0} \xB7 \uBCF4\uC720 {1} \xB7 \uBCF4\uB958 {2}
      \xB7 \uAC70\uBD80 {3}\n\uC644\uB8CC {4} \xB7 \uCDE8\uC18C {5}"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698443
    m_Localized: "\n\uB9E4\uB3C4 \uD638\uAC00\uB97C \uC18C\uC9C4\uD55C \uCCB4\uACB0\uB7C9
      / \uC804\uCCB4 \uCCB4\uACB0\uB7C9\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383698444
    m_Localized: "\n\uC2E4\uD604\uC190\uC775 "
    m_Metadata:
      m_Items: []
  - m_Id: 1383698445
    m_Localized: "\n\uCCB4\uACB0 {0}\uAC74 \xB7 \uC794\uC5EC {1:N0}\uC8FC"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698446
    m_Localized: "\n\uCD5C\uB300 \uBD84\uB178 {0:0} \xB7 \uB300\uC0C1 {1}\n\uC2A4\uD2B8\uB808\uC2A4
      {2:0.#}/100\n\uC9C1\uC811 \uACBD\uD5D8 {3}\uC2B9 / {4}\uD328\n\n\uC704\uD5D8
      {5:F1}  \xB7  \uAE30\uAC04 {6:F1}  \xB7  \uCD94\uACA9 {7:F1}\n\uBBFC\uAC10
      {8:F1}  \xB7  \uD68C\uBCF5 {9:F1}  \xB7  {10}\n\n\uCD5C\uADFC \uBCC0\uD654
      \xB7 {11}"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698447
    m_Localized: "\n\uD0D0\uC695 {0:0}  \uACF5\uD3EC {1:0}\n\uC2E0\uB8B0 {2:0}  \uBC30\uC2E0\uAC10
      {3:0} \xB7 \uC9C1\uC811 \uACBD\uD5D8 {4}\uC2B9 / {5}\uD328\n\uC2A4\uD2B8\uB808\uC2A4
      {6:0} \xB7 \uC704\uD5D8 {7:F1} \xB7 \uAE30\uAC04 {8:F1} \xB7 \uCD94\uACA9 {9:F1}\n\uBBFC\uAC10
      {10:F1} \xB7 \uD68C\uBCF5 {11:F1} \xB7 {12}"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698448
    m_Localized: "     \uC815\uC0B0 "
    m_Metadata:
      m_Items: []
  - m_Id: 1383698449
    m_Localized: "   \uC2E4\uD604 "
    m_Metadata:
      m_Items: []
  - m_Id: 1383698450
    m_Localized: "  \xB7  \uB9E4\uB3C4 \uB300\uAE30 "
    m_Metadata:
      m_Items: []
  - m_Id: 1383698451
    m_Localized: "  \xB7  \uB9E4\uC218 \uC608\uCE58 "
    m_Metadata:
      m_Items: []
  - m_Id: 1383698452
    m_Localized: " / \uB9E4\uB3C4 "
    m_Metadata:
      m_Items: []
  - m_Id: 1383698453
    m_Localized: " {0:N0}\uC6D0 \uB9E4\uC218 \uC9C0\uC2DC\uB294 \uAC70\uC808\uD588\uB294\uB370,
      \uC7A5 \uB05D\uB098\uAE30 \uC804\uC5D0 {1:N0}\uC6D0\uAE4C\uC9C0 \uAC14\uB124\uC694.
      {2} \uAE30\uD68C\uC600\uC5B4\uC694. \uC9C1\uC811 \uBC88 \uAC74 \uC544\uB2C8\uC9C0\uB9CC
      \uB2E4\uC2DC \uBCF4\uAC8C \uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383698454
    m_Localized: " \xB7 \uAC00\uC6A9 \uD604\uAE08 "
    m_Metadata:
      m_Items: []
  - m_Id: 1383698455
    m_Localized: " \xB7 \uAC70\uB798 \uC9C0\uC18D"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698456
    m_Localized: " \xB7 \uAC70\uB798 \uD55C\uC0B0"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698457
    m_Localized: " \xB7 \uAC70\uB798 \uD65C\uBC1C"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698458
    m_Localized: " \xB7 \uACBD\uAC01\uC2EC {0:0} \xB7 \uC704\uCD95 {1:0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698459
    m_Localized: " \xB7 \uBBF8\uCCB4\uACB0 \uCDE8\uC18C\uB428"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698460
    m_Localized: " \xB7 \uBBF8\uD655\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698461
    m_Localized: " \xB7 \uBD84\uD560"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698462
    m_Localized: " \xB7 \uC218\uB77D \uC131\uD5A5 "
    m_Metadata:
      m_Items: []
  - m_Id: 1383698463
    m_Localized: " \xB7 \uC6B4\uC601\uC790\n\uCCB4\uACB0 "
    m_Metadata:
      m_Items: []
  - m_Id: 1383698464
    m_Localized: " \xB7 \uC7A5 \uB9C8\uAC10"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698465
    m_Localized: " \xB7 \uC9C4\uD589 \uC911"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698466
    m_Localized: " \xB7 \uCCB4\uACB0\uB41C "
    m_Metadata:
      m_Items: []
  - m_Id: 1383698467
    m_Localized: " \xB7 \uD604\uC2E4\uC2DC\uAC04"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698468
    m_Localized: " \xB7 \uD604\uC7AC \uC120\uD0DD \uC885\uBAA9"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698469
    m_Localized: " \xB7 \uD6C4\uC18D"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698470
    m_Localized: " \uAC70\uB798 \uBA48\uCDC4\uB124\uC694. \uC7AC\uAC1C\uAE4C\uC9C0
      \uC8FC\uBB38\uC740 \uAE30\uB2E4\uB824\uC57C\uACA0\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383698471
    m_Localized: " \uAC70\uB798\uB7C9 \uAE09\uC99D ("
    m_Metadata:
      m_Items: []
  - m_Id: 1383698472
    m_Localized: " \uAC70\uB798\uB7C9\uC774 \uC55E\uC120 1\uBD84\uC758 "
    m_Metadata:
      m_Items: []
  - m_Id: 1383698473
    m_Localized: " \uACB0\uACFC "
    m_Metadata:
      m_Items: []
  - m_Id: 1383698474
    m_Localized: " \uACBD\uC601\uAD8C \uD655\uBCF4 \xB7 \uB9E4\uC785 \uB300\uC0C1 "
    m_Metadata:
      m_Items: []
  - m_Id: 1383698475
    m_Localized: " \uAD00\uACC4\uB85C \uAD00\uCC30\uBC29 \uC774\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698476
    m_Localized: " \uAD00\uB828 "
    m_Metadata:
      m_Items: []
  - m_Id: 1383698477
    m_Localized: " \uAD00\uB828 \uC18C\uC2DD\uC758 \uD575\uC2EC\uC740 \u2018"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698478
    m_Localized: " \uAD00\uB828 \uC8FC\uC7A5\uC774 \uC775\uBA85 \uCC44\uB110\uC5D0\uC11C
      \uC720\uD1B5\uB418\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uD655\uC778\uB41C \uACC4\uC57D\uC774\uB098
      \uC2E4\uC801 \uC790\uB8CC\uB294 \uC544\uC9C1 \uC81C\uC2DC\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383698479
    m_Localized: " \uAD00\uCE21"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698480
    m_Localized: " \uAD00\uCE21\n"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698481
    m_Localized: " \uAD00\uCE21 \xB7 "
    m_Metadata:
      m_Items: []
  - m_Id: 1383698482
    m_Localized: " \uB193\uCE68. \uC774\uBC88 \uAC74 \uC778\uC815."
    m_Metadata:
      m_Items: []
  - m_Id: 1383698483
    m_Localized: " \uB2D8\uC774 \uC785\uC7A5\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383698484
    m_Localized: " \uB2D8\uC774 \uD1F4\uC7A5\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383698485
    m_Localized: " \uB300\uC751 \uBCF4\uB958 \xB7 \uAC70\uB798\uC18C \uC608\uC0B0\xB7\uC7AC\uACE0\xB7\uC704\uD5D8
      \uC81C\uD55C"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698486
    m_Localized: " \uB9E4\uB3C4 "
    m_Metadata:
      m_Items: []
  - m_Id: 1383698487
    m_Localized: " \uB9E4\uB3C4 \uC555\uB825\uC5D0 \uC81C\uD55C \uB9E4\uC218 "
    m_Metadata:
      m_Items: []
  - m_Id: 1383698488
    m_Localized: " \uB9E4\uB3C4 \uC8FC\uBB38\uC740 \uC544\uC9C1 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383698489
    m_Localized: " \uB9E4\uC218 "
    m_Metadata:
      m_Items: []
  - m_Id: 1383698490
    m_Localized: " \uB9E4\uC218 \uC555\uB825\uC5D0 \uC81C\uD55C \uB9E4\uB3C4 "
    m_Metadata:
      m_Items: []
  - m_Id: 1383698491
    m_Localized: " \uBD80\uC784 \uD6C4 \uC2E4\uD604\uC190\uC775 "
    m_Metadata:
      m_Items: []
  - m_Id: 1383698492
    m_Localized: " \uC0DD\uAC01\uC774 \uB108\uBB34 \uB9CE\uC544\uC9C0\uB124\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698493
    m_Localized: " \uC2E4\uD589. \uC8FC\uBB38\xB7\uCCB4\uACB0\xB7\uC794\uC5EC \uBB3C\uB7C9\uC744
      \uD655\uC778\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383698494
    m_Localized: " \uC2E4\uD604. \uC774\uBC88\uC5D4 \uB3C4\uC6C0 \uB410\uC74C."
    m_Metadata:
      m_Items: []
  - m_Id: 1383698495
    m_Localized: " \uC2E4\uD604\u2026 \uC9C0\uC2DC \uB530\uB77C\uAC14\uB2E4\uAC00
      \uBB3C\uB838\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1383698496
    m_Localized: " \uC548 \uB530\uB77C\uAC14\uB294\uB370 \uBAA9\uD45C \uCC0D\uC5C8\uB124\u2026 "
    m_Metadata:
      m_Items: []
  - m_Id: 1383698497
    m_Localized: " \uC644\uB8CC. \uC2DC\uC7A5 \uD3C9\uAC00\uB294 \uCC38\uC5EC\uC790\uB4E4\uC758
      \uD310\uB2E8\uC5D0 \uB2EC\uB824 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383698498
    m_Localized: " \uC695\uC2EC\uC740 \uB098\uB294\uB370, \uD655\uC2E0\uC740 \uBABB
      \uD558\uACA0\uC74C."
    m_Metadata:
      m_Items: []
  - m_Id: 1383698499
    m_Localized: " \uC74C\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698500
    m_Localized: " \uC77C\uB2E8 \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1383698501
    m_Localized: " \uC815\uB3C4"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698502
    m_Localized: " \uC81C \uD3C9\uB2E8\uC740 "
    m_Metadata:
      m_Items: []
  - m_Id: 1383698503
    m_Localized: " \uC8FC\uC7A5, \uD655\uC778 \uC790\uB8CC \uC5C6\uB294 \uAC83\uC73C\uB85C
      \uB4DC\uB7EC\uB098"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698504
    m_Localized: " \uC9C0\uC2DC \uC774\uD6C4 "
    m_Metadata:
      m_Items: []
  - m_Id: 1383698505
    m_Localized: " \uC9C0\uC2DC \uCDE8\uC18C. \uCCB4\uACB0\uB41C \uC8FC\uC2DD\uC740
      \uAC01 \uCC38\uAC00\uC790\uC5D0\uAC8C \uB0A8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383698506
    m_Localized: " \uCD5C\uADFC 1\uBD84 "
    m_Metadata:
      m_Items: []
  - m_Id: 1383698507
    m_Localized: " \uCD5C\uADFC 1\uBD84 \uAC70\uB798\uB300\uAE08 "
    m_Metadata:
      m_Items: []
  - m_Id: 1383698508
    m_Localized: " \uCD5C\uADFC 1\uBD84\uC5D0 "
    m_Metadata:
      m_Items: []
  - m_Id: 1383698509
    m_Localized: " \uCD5C\uADFC \uB9E4\uB3C4 \uACB0\uACFC\uB294 "
    m_Metadata:
      m_Items: []
  - m_Id: 1383698510
    m_Localized: " \uD638\uAC00\uAC00 \uC9C0\uAE08 \uBE44\uC5B4 \uC788\uC5B4\uC694.
      \uAE09\uD558\uAC8C \uB123\uAE34 \uC5B4\uB835\uACA0\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383698511
    m_Localized: "% \xB7 \uACBD\uC601\uAD8C\uC740 50% \uCD08\uACFC"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698512
    m_Localized: "% \uBBF8\uB9CC"
    m_Metadata:
      m_Items: []
  - m_Id: 1383698513
    m_Localized: "%\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383698514
    m_Localized: ". \uC9C0\uC2DC\uB9CC \uBBFF\uC73C\uBA74 \uC548 \uB418\uACA0\uC5B4\uC694.
      \uCCB4\uACB0\uACFC \uC704\uD5D8\uC740 \uC9C1\uC811 \uD655\uC778\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383698515
    m_Localized: ". \uC9D1\uD589 \uBE44\uC6A9 "
    m_Metadata:
      m_Items: []
