  - m_Id: 69223530991640
    m_Localized: "{company} \uACBD\uC601\uAD8C \uC778\uC218 \uD655\uC815"
    m_Metadata:
      m_Items: []
  - m_Id: 69223530991641
    m_Localized: "\uAE30\uC5C5 \uC778\uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 69223530991642
    m_Localized: "\uAE30\uC5C5 \uACF5\uC2DC"
    m_Metadata:
      m_Items: []
  - m_Id: 69223530991643
    m_Localized: "\uC9C0\uBD84 \uD655\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 69223530991644
    m_Localized: "\uD50C\uB808\uC774\uC5B4\uAC00 \uACFC\uBC18 \uC9C0\uBD84\uC744
      \uD655\uBCF4\uD588\uC2B5\uB2C8\uB2E4. \uC0C8 \uACBD\uC601 \uC804\uB7B5\uACFC
      \uC8FC\uC8FC\uD658\uC6D0 \uD655\uB300\uC5D0 \uB300\uD55C \uAE30\uB300\uAC00
      \uCEE4\uC9C0\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 69223530991645
    m_Localized: "\uC8FC\uC8FC \uC6D0\uC7A5\uC5D0\uC11C \uD50C\uB808\uC774\uC5B4\uC758
      \uC9C0\uBD84 {stake}%\uAC00 \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4. \uC2E4\uC81C
      \uCCB4\uACB0\uC774 \uC644\uB8CC\uB41C \uC9C0\uBD84\uC744 \uAE30\uC900\uC73C\uB85C
      \uACBD\uC601\uAD8C\uC774 \uC774\uC804\uB410\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 69223530991646
    m_Localized: "\uC0C8 \uC9C0\uBC30\uC8FC\uC8FC\uB294 \uBC30\uB2F9\xB7\uC7AC\uD22C\uC790\xB7\uD604\uAE08
      \uBE44\uCD95 \uC815\uCC45\uC744 \uACB0\uC815\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
      \uC2DC\uC7A5\uC5D0\uC11C\uB294 \uC790\uBCF8 \uBC30\uBD84 \uAC1C\uC120\uACFC
      \uC131\uC7A5 \uD22C\uC790 \uAC00\uB2A5\uC131\uC744 \uC8FC\uC694 \uD638\uC7AC\uB85C
      \uD3C9\uAC00\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 69223530991647
    m_Localized: "\uAE30\uC5C5\uC758 \uC77C\uC77C \uBC30\uB2F9\uC740 \uC7A5 \uB9C8\uAC10
      \uC2E4\uC801\uACFC \uBCF4\uC720 \uD604\uAE08\uC5D0 \uB530\uB77C \uACB0\uC815\uB429\uB2C8\uB2E4.
      \uC778\uC218 \uC790\uCCB4\uAC00 \uC774\uC775\uC774\uB098 \uC8FC\uAC00 \uC0C1\uC2B9\uC744
      \uBCF4\uC7A5\uD558\uC9C0\uB294 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
