      m_Items: []
  - m_Id: 1392088070
    m_Localized: "\uC9C4\uC9DC\uB85C\uC694. \uBC29\uC7A5\uB2D8, \uB9D0\uC774 \uB108\uBB34
      \uC138\uC9C0\uACE0 \uC788\uC5B4\uC694."
