      m_Items: []
  - m_Id: 1392087141
    m_Localized: "\uC2E0\uB8B0 {0:0.#}%  \xB7  \uBC30\uC2E0\uAC10 {1:0.#}% \xB7 {2}\n\uD0D0\uC695
      {3:0}  \xB7  \uACF5\uD3EC {4:0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087142
    m_Localized: "\uC2E0\uC0AC\uC5C5"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087143
    m_Localized: "\uC2E0\uC0AC\uC5C5 \uD22C\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087144
    m_Localized: "\uC2E0\uC57D"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087145
    m_Localized: "\uC2E0\uC6D0 \uBBF8\uD655\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087146
    m_Localized: "\uC2E0\uD638 \uB300\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087147
    m_Localized: "\uC2E0\uD638 \uBCF4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087148
    m_Localized: "\uC2E4\uC0AC\uC6A9 \uACB0\uACFC\uC640 \uAC80\uC99D \uC790\uB8CC,
      \uD6C4\uC18D \uC77C\uC815\uC774 \uAD6C\uCCB4\uC801\uC73C\uB85C \uB098\uC624\uB294\uC9C0
      \uD655\uC778\uD574\uC57C \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087149
    m_Localized: "\uC2E4\uC801"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087150
    m_Localized: "\uC2E4\uC801 \uC804\uB9DD\uACFC \uC2E4\uC81C \uD604\uAE08 \uC720\uC785\uC740
      \uB2E4\uB978 \uC2DC\uC810\uC5D0 \uC6C0\uC9C1\uC778\uB2E4. \uB9E4\uCD9C \uAE30\uB300\uAC00
      \uCEE4\uC838\uB3C4 \uBE44\uC6A9\uACFC \uC6B4\uC804\uC790\uAE08 \uBD80\uB2F4\uC774
      \uD568\uAED8 \uB298 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087151
    m_Localized: "\uC2E4\uC801\xB7\uC790\uAE08"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087152
    m_Localized: "\uC2E4\uC81C \uB9E4\uB3C4 \uC8FC\uBB38"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087153
    m_Localized: "\uC2E4\uC81C \uB9E4\uC218 \uC8FC\uBB38"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087154
    m_Localized: "\uC2E4\uC81C \uBCF4\uC720 \uC9C0\uBD84 50% \uCD08\uACFC\uAC00 \uD544\uC694\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087155
    m_Localized: "\uC2E4\uC81C \uCCB4\uACB0 \uAC70\uB798\uB300\uAE08 "
    m_Metadata:
      m_Items: []
  - m_Id: 1392087156
    m_Localized: "\uC2E4\uC81C \uCCB4\uACB0 \uAD00\uCE21"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087157
    m_Localized: "\uC2E4\uC81C \uCCB4\uACB0\uC774 \uBC1C\uC0DD\uD558\uBA74 \uC2DC\uAC04\xB7\uC885\uBAA9\xB7\uC218\uB7C9\xB7\uAC00\uACA9\uC744
      \uAE30\uB85D\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087158
    m_Localized: "\uC2E4\uD604"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087159
    m_Localized: "\uC2E4\uD604 \uB9E4\uB9E4\uC190\uC775"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087160
    m_Localized: "\uC2E4\uD604\uC190\uC775"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087161
    m_Localized: "\uC2E4\uD604\uC190\uC775 "
    m_Metadata:
      m_Items: []
  - m_Id: 1392087162
    m_Localized: "\uC2E4\uD604\uC190\uC775 \xB7 \uB2EC\uC131"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087163
    m_Localized: "\uC2E4\uD604\uC190\uC775 \xB7 \uC9C4\uD589 \uC911"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087164
    m_Localized: "\uC2E4\uD604\uC218\uC775 "
    m_Metadata:
      m_Items: []
  - m_Id: 1392087165
    m_Localized: "\uC2EC\uC57C \uAC70\uB798\uC2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087166
    m_Localized: "\uC2F8\uC6B0\uB2E4\uAC00 \uC815\uC791 \uCC28\uD2B8 \uB193\uCE58\uACA0\uB2E4.
      \uC7A0\uAE50 \uC26C\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087167
    m_Localized: "\uC2F8\uC6B0\uB824\uB294 \uAC74 \uC544\uB2CC\uB370 \uC800 \uB9D0\uC740
      \uBABB \uB118\uAE30\uACA0\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087168
    m_Localized: "\uC2F8\uC6B0\uBA74 \uBC14\uB85C \uC815\uB9AC\uD558\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087169
    m_Localized: "\uC2F8\uC6B0\uBA74 \uBC14\uB85C \uC870\uCE58\uD558\uC2DC\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087170
    m_Localized: "\uC2F8\uC6B0\uBA74 \uBC14\uB85C \uC870\uCE58\uD558\uC2DC\uB294\uAD70\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087171
    m_Localized: "\uC2F8\uC6C0\uC744 \uB9D0\uB9AC\uC9C0 \uC54A\uC544 \uADF8 \uBC29\uC5D0\uC11C
      \uB098\uC654\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087172
    m_Localized: "\uC2F8\uC6CC\uB3C4 \uC544\uBB34\uB3C4 \uC548 \uB9D0\uB824\uC11C
      \uADF8 \uBC29 \uB098\uC654\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087173
    m_Localized: "\uC2F8\uC6CC\uB3C4 \uC548 \uB9D0\uB9AC\uAE38\uB798 \uADF8 \uBC29
      \uB098\uC634."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087174
    m_Localized: "\uC4F0\uB824\uB2E4 \uC9C0\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087175
    m_Localized: "\uC544 {symbol} {profitKind}\uC190\uC775 {amount}\uC6D0\u2026 \uC18D\uC0C1\uD558\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087176
    m_Localized: "\uC544 {symbol} \uC218\uC775\uB960 {return}\uB124. \uC624\uB298
      \uB0B4 \uD310\uB2E8 \uB808\uC804\uB4DC\uB2E4 \u314B\u314B"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087177
    m_Localized: "\uC544 {symbol} \uC598\uAE30 \uB4E3\uACE0 \uC2F6\uC5C8\uC5B4. \uB2E4\uB978
      \uC758\uACAC \uC788\uC5B4?"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087178
    m_Localized: "\uC544 {symbol}! \uB098\uB3C4 \uBCF4\uB294 \uC911."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087179
    m_Localized: "\uC544 {symbol}! \uB0B4 {profitKind}\uC190\uC775\uC774 {amount}\uC6D0\uC784."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087180
    m_Localized: "\uC544 {symbol}! \uBCF4\uACE0 \uC788\uC73C\uB2C8\uAE4C \uB9C8\uC74C
      \uAE09\uD574\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087181
    m_Localized: "\uC544 \uADF8\uAC74 \uB0B4\uAC00 \uC798\uBABB \uC77D\uC5C8\uB124
      \u3148\u3145"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087182
    m_Localized: "\uC544, {symbol} {profitKind}\uC190\uC775 {amount}\uC6D0\uC774\uB124\uC694.
      \uC18D\uC0C1\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087183
    m_Localized: "\uC544, {symbol} \uC598\uAE30 \uB4E3\uACE0 \uC2F6\uC5C8\uC5B4\uC694.
      \uB2E4\uB978 \uC758\uACAC \uC788\uB098\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087184
    m_Localized: "\uC544, {symbol}! \uBCF4\uACE0 \uC788\uC73C\uB2C8 \uAC00\uB9CC\uD788
      \uC788\uAE30 \uC5B4\uB835\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087185
    m_Localized: "\uC544, {symbol}! \uC81C {profitKind}\uC190\uC775\uC774 {amount}\uC6D0\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087186
    m_Localized: "\uC544, {symbol}\uC774\uB124\uC694! \uC800\uB3C4 \uBCF4\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087187
    m_Localized: "\uC544\uAE4C"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087188
    m_Localized: "\uC544\uAE4C\uBD80\uD130 \uACB0\uB860\uC774 \uB108\uBB34 \uBE60\uB978
      \uAC70 \uC544\uB2C8\uB0D0 \u314B\u314B"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087189
    m_Localized: "\uC544\uB2C8 \uB9D0\uC744 \uD560\uC218\uB85D \uB354 \uD654\uB0B4\uB124"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087190
    m_Localized: "\uC544\uB2C8 \uBC29\uAE08 \uC800 \uB9D0 \uB4E3\uACE0 \uADF8\uB0E5
      \uC788\uC73C\uB77C\uACE0?"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087191
    m_Localized: "\uC544\uB2C8 \uC7A0\uAE50 \u314B\u314B \uADF8\uAC8C \uC65C \uADF8\uB807\uAC8C
      \uC774\uC5B4\uC9D0"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087192
    m_Localized: "\uC544\uB2C8 \uC9C4\uC9DC\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087193
    m_Localized: "\uC544\uB798 \uAC1C\uC124 \uBC84\uD2BC\uC744 \uB204\uB974\uBA74
      \uC6B4\uC601 \uAD8C\uD55C\uC774 \uC5F4\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087194
    m_Localized: "\uC544\uBB34\uB3C4 \uB9D0\uB9AC\uC9C0 \uC54A\uB294\uAD70\uC694.
      \uC774 \uC2F8\uC6C0\uC744 \uB354 \uACAC\uB514\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4.
      \uB098\uAC11\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087195
    m_Localized: "\uC544\uBB34\uB3C4 \uC548 \uB9D0\uB9AC\uB124. \uB354\uB294 \uC2F8\uC6B0\uAE30
      \uC2EB\uB2E4. \uB098\uAC10."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087196
    m_Localized: "\uC544\uBB34\uB3C4 \uC548 \uB9D0\uB9AC\uB124\uC694. \uB354\uB294
      \uC2F8\uC6B0\uAE30 \uC2EB\uC5B4\uC11C \uB098\uAC08\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087197
    m_Localized: "\uC544\uC774\uACE0 {symbol} {pct}%\uB124. \uB9C8\uC74C \uBB34\uAC81\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087198
    m_Localized: "\uC544\uC774\uACE0, {symbol} \uC218\uC775\uB960 {pct}%\uB124\uC694.
      \uB9C8\uC74C\uC774 \uBB34\uAC81\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087199
    m_Localized: "\uC544\uC8FC \uB531 \uC798\uB77C \uB9D0\uD558\uB124. \uBD80\uB7FD\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087200
    m_Localized: "\uC544\uC8FC \uB531 \uC798\uB77C \uB9D0\uD558\uB124. \uBD80\uB7FD\uB2E4.
      \uCC38 \uB300\uB2E8\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087201
    m_Localized: "\uC544\uC9C1 \uACB0\uC815 \uBABB \uD588\uC5B4\uC694. \uC790\uAE08\uC774\uB791
      \uD638\uAC00\uBD80\uD130 \uC880 \uBCFC\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087202
    m_Localized: "\uC544\uC9C1 \uB2E4\uC2DC \uC5F0\uB77D\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087203
    m_Localized: "\uC544\uC9C1 \uB4E4\uACE0 \uC788\uB294\uB370"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087204
    m_Localized: "\uC544\uC9C1 \uBCF4\uC720\uD55C \uC885\uBAA9\uC774 \uC5C6\uC2B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087205
    m_Localized: "\uC544\uC9C1 \uC0DD\uAC01 \uC911\uC778\uB370 {symbol} \uB193\uCE60\uAE4C
      \uBD10 \uC870\uAE09\uD574!"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087206
    m_Localized: "\uC544\uC9C1 \uC77D\uC744 \uAE30\uC0AC\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4.\n\n\uD544\uD130\uB97C
      \uBC14\uAFB8\uAC70\uB098 \uC0C8 \uC18C\uC2DD\uC744 \uAE30\uB2E4\uB824 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087207
    m_Localized: "\uC544\uC9C1 \uC885\uB8CC\uD55C \uC791\uC5C5\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087208
    m_Localized: "\uC544\uC9C1 \uCCB4\uACB0\uB41C \uC8FC\uBB38\uC774 \uC5C6\uC2B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087209
    m_Localized: "\uC545\uC7AC \uBC29\uD5A5"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087210
    m_Localized: "\uC548\uB155\uD558\uC138\uC694. \uC624\uB298\uC740 \uBA3C\uC800
      \uC880 \uC9C0\uCF1C\uBCFC\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087211
    m_Localized: "\uC548\uC804"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087212
    m_Localized: "\uC54C \uC218 \uC5C6\uB294 \uBC88\uD638"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087213
    m_Localized: "\uC54C\uACA0\uB294\uB370 \uC7A0\uAE50\uB9CC. \uB098\uB3C4 \uD560
      \uB9D0\uC740 \uD574\uC57C\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087214
    m_Localized: "\uC54C\uB9BC \uAE30\uB85D"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087215
    m_Localized: "\uC54C\uB9BC \uC6D0\uBB38"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087216
    m_Localized: "\uC54C\uB9BC\uB3C4 \uC548 \uC654\uB294\uB370 \uC790\uAFB8 \uCC3D
      \uD655\uC778\uD558\uB294 \uC911 \u314B\u314B"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087217
    m_Localized: "\uC55E\uC11C \uC720\uD1B5\uB41C \uC8FC\uC7A5\uC5D0 \uB300\uD55C
      \uD6C4\uC18D \uD655\uC778\uC785\uB2C8\uB2E4. \uCD5C\uCD08 \uBCF4\uB3C4\uC640
      \uD655\uC778 \uACB0\uACFC\uB97C \uD568\uAED8 \uC77D\uC5B4\uC57C \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087218
    m_Localized: "\uC55E\uC120 \uC8FC\uC7A5\uACFC \uB2E4\uB978 \uD655\uC778 \uACB0\uACFC\uAC00
      \uB098\uC654\uC2B5\uB2C8\uB2E4. \uC6D0\uBB38\uC744 \uBBFF\uACE0 \uD310\uB2E8\uD588\uB358
      \uD22C\uC790\uC790\uB294 \uADFC\uAC70\uB97C \uB2E4\uC2DC \uC0B4\uD3B4\uBCFC
      \uC2DC\uC810\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087219
    m_Localized: "\uC560\uC99D"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087220
    m_Localized: "\uC591\uBC29\uD5A5 \uB300\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087221
    m_Localized: "\uC598\uAE30 \uB4E3\uACE0 \uC788\uC5B4\uC694. \uCC9C\uCC9C\uD788
      \uC815\uB9AC\uD574 \uBD10\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087222
    m_Localized: "\uC598\uAE30 \uB4E3\uACE0 \uC788\uC5B4\uC694. \uCC9C\uCC9C\uD788
      \uC815\uB9AC\uD574 \uBD10\uC694. \uC11C\uB450\uB974\uC9C0 \uB9C8\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087223
    m_Localized: "\uC598\uAE30 \uB4E4\uC73C\uB2C8 \uC7A0\uAE50 \uC8FC\uBCC0\uB3C4
      \uBCF4\uAC8C \uB418\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087224
    m_Localized: "\uC598\uAE30 \uC880 \uC77D\uC73C\uBA74\uC11C \uC2DC\uC7A5 \uBCF4\uB824\uACE0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087225
    m_Localized: "\uC598\uAE30\uB294 \uD574\uC57C\uACA0\uB124\uC694. {departedName}\uB2D8
      \uB098\uAC00\uC168\uB124\uC694. \uC800\uB3C4 \uB530\uB77C \uB098\uAC08\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087226
    m_Localized: "\uC598\uAE30\uB294 \uD574\uC57C\uACA0\uB124\uC694. \uADF8 \uBC29\uC5D0\uC11C
      \uCAD3\uACA8\uB0AC\uC5B4\uC694. \uC81C \uACBD\uD5D8\uC740 \uBCC4\uB85C\uC600\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087227
    m_Localized: "\uC598\uAE30\uB294 \uD574\uC57C\uACA0\uB124\uC694. \uC2F8\uC6CC\uB3C4
      \uC544\uBB34\uB3C4 \uC548 \uB9D0\uB824\uC11C \uADF8 \uBC29 \uB098\uC654\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087228
    m_Localized: "\uC598\uAE30\uB294 \uD574\uC57C\uACA0\uB124\uC694. \uC544\uBB34\uB3C4
      \uC548 \uB9D0\uB9AC\uB124\uC694. \uB354\uB294 \uC2F8\uC6B0\uAE30 \uC2EB\uC5B4\uC11C
      \uB098\uAC08\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087229
    m_Localized: "\uC598\uAE30\uB294 \uD574\uC57C\uACA0\uB124\uC694. \uC774\uB300\uB85C\uBA74
      \uB098\uAC08\uAC8C\uC694. \uB354\uB294 \uCC38\uAE30 \uD798\uB4DC\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087230
    m_Localized: "\uC598\uAE30\uB3C4 \uC88B\uC740\uB370 {symbol} \uCCB4\uACB0\uBD80\uD130
      \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087231
    m_Localized: "\uC598\uAE30\uB3C4 \uC88B\uC740\uB370 {symbol} \uCCB4\uACB0\uBD80\uD130
      \uBCF4\uC790. \uACC4\uC18D \uBCF8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087232
    m_Localized: "\uC598\uAE30\uB3C4 \uC88B\uC9C0\uB9CC {symbol} \uCCB4\uACB0 \uBA3C\uC800
      \uBCFC\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087233
    m_Localized: "\uC598\uAE30\uB3C4 \uC88B\uC9C0\uB9CC {symbol} \uCCB4\uACB0 \uBA3C\uC800
      \uBCFC\uAC8C\uC694. \uACC4\uC18D \uBCF4\uACE0 \uC788\uC744\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087234
    m_Localized: "\uC598\uAE30\uD574\uC918\uC11C \uACE0\uB9C8\uC6CC. \uC870\uAE08
      \uB354 \uC9C0\uCF1C\uBCFC\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087235
    m_Localized: "\uC5B4 {departedName} \uB098\uAC14\uB124 \u314B\u314B \uC798 \uAC00\uB77C"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087236
    m_Localized: "\uC5B4 {departedName} \uC5C6\uB124. \uC7A0\uAE50 \uC26C\uACE0 \uC624\uB4E0\uAC00
      \u314B\u314B"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087237
    m_Localized: "\uC5B4\uAE68\uC5D0 \uD798 \uB4E4\uC5B4\uAC14\uB358 \uAC83\uB3C4
      \uC774\uC81C \uC54C\uC558\uC74C."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087238
    m_Localized: "\uC5B4\uB290 \uC2DC\uC810\uC758 \uC815\uBCF4\uB97C \uAE30\uC900\uC73C\uB85C
      \uD558\uC2E0 \uB9D0\uC500\uC785\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087239
    m_Localized: "\uC5B4\uB290 \uC2DC\uC810\uC758 \uC815\uBCF4\uB97C \uAE30\uC900\uC73C\uB85C
      \uD558\uC2E0 \uB9D0\uC500\uC785\uB2C8\uAE4C? \uD655\uC778\uC774 \uD544\uC694\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087240
    m_Localized: "\uC5B4\uC774\uC5C6\uB124. \uB9D0 \uC880 \uAC00\uB824 \uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087241
    m_Localized: "\uC5B4\uC774\uC5C6\uB124. \uB9D0 \uC880 \uAC00\uB824 \uD574. \uB9D0
      \uC880 \uAC00\uB824."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087242
    m_Localized: "\uC5B4\uC81C"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087243
    m_Localized: "\uC5B5 \uC815\uB3C4"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087244
    m_Localized: "\uC5B5\uC6D0\uCBE4"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087245
    m_Localized: "\uC5B8\uC7C1 \uBC29\uCE58 \uD6C4 \uC774\uD0C8"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087246
    m_Localized: "\uC5BC\uB9C8\uB098 \uD655\uC2E0\uD558\uB0D0 \uB9D0\uACE0 \uD655\uC778\uD560
      \uAC78 \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087247
    m_Localized: "\uC5BC\uB9C8\uB098 \uD655\uC2E0\uD558\uB0D0\uBCF4\uB2E4 \uD655\uC778\uD560
      \uB0B4\uC6A9\uC744 \uBD10\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087248
    m_Localized: "\uC5C6\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087249
    m_Localized: "\uC5D0 \uAD00\uC2EC\uC774 \uC788\uB2E4\uB294 \uC598\uAE30\uB294
      \uB4E4\uC5C8\uC2B5\uB2C8\uB2E4. \uD655\uC778\uB41C \uACF5\uC2DC\uB294 \uC544\uB2D9\uB2C8\uB2E4.\"\n\n\uD1B5\uD654
      \uAE30\uB85D: \uC2E0\uC6D0\uACFC \uB0B4\uC6A9 \uBAA8\uB450 \uBBF8\uD655\uC778."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087250
    m_Localized: "\uC5D0 \uCC38\uC5EC \uC911\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087251
    m_Localized: "\uC5D0\uB108\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087252
    m_Localized: "\uC5EC\uAE30\uAE4C\uC9C0 \uD558\uACA0\uC2B5\uB2C8\uB2E4. \uB354\uB294
      \uC774 \uBC29\uC5D0 \uC788\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087253
    m_Localized: "\uC5EC\uAE30\uAE4C\uC9C0 \uD558\uACA0\uC2B5\uB2C8\uB2E4. \uB354\uB294
      \uC774 \uBC29\uC5D0 \uC788\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4. \uC774\uB9CC
      \uB5A0\uB098\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087254
    m_Localized: "\uC5EC\uAE30\uAE4C\uC9C0 \uD558\uC790. \uB354\uB294 \uC5EC\uAE30
      \uC548 \uC788\uC74C."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087255
    m_Localized: "\uC5EC\uAE30\uAE4C\uC9C0 \uD558\uC790. \uB354\uB294 \uC5EC\uAE30
      \uC548 \uC788\uC74C. \uC774\uB9CC \uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087256
    m_Localized: "\uC5EC\uAE30\uAE4C\uC9C0 \uD560\uAC8C\uC694. \uB354\uB294 \uC774
      \uBC29\uC5D0 \uC548 \uC788\uC744\uB798\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087257
    m_Localized: "\uC5EC\uAE30\uAE4C\uC9C0 \uD560\uAC8C\uC694. \uB354\uB294 \uC774
      \uBC29\uC5D0 \uC548 \uC788\uC744\uB798\uC694. \uC774\uB9CC \uAC08\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087258
    m_Localized: "\uC5EC\uAE30\uB294 \uC2F8\uC6C0\uC5D0 \uC81C\uC7AC\uAC00 \uC788\uAD70\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087259
    m_Localized: "\uC5EC\uAE30\uC11C \uD63C\uC790 \uB059\uB059\uB300\uC9C4 \uB9C8.
      \uC598\uAE30\uB294 \uB4E4\uC5B4\uC904\uAC8C"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087260
    m_Localized: "\uC5EC\uAE34 \uC2F8\uC6B0\uBA74 \uC81C\uC7AC \uBC1B\uB294\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087261
    m_Localized: "\uC5EC\uAE34 \uC2F8\uC6B0\uBA74 \uC81C\uC7AC\uAC00 \uC788\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087262
    m_Localized: "\uC5F0\uACB0\uB41C \uACF5\uAC1C \uBC1C\uC5B8\uC774 \uC544\uC9C1
      \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087263
    m_Localized: "\uC5F0\uACB0\uB41C \uB77C\uC6B4\uC9C0 \uBC1C\uC5B8\n"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087264
    m_Localized: "\uC5F0\uAD6C"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087265
    m_Localized: "\uC5F0\uB77D \uAE30\uB85D"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087266
    m_Localized: "\uC5F4\uC131 \uC9C0\uC9C0\uC790\uB294 \uC545\uC7AC\uC5D0\uC11C\uB3C4
      \uD68C\uBCF5\uD560 \uC774\uC720\uB97C \uCC3E\uC744 \uC218 \uC788\uB2E4. \uADF8\uB7EC\uB098
      \uAE30\uB300\uAC00 \uB192\uC558\uB358 \uB9CC\uD07C \uBC18\uBCF5\uB41C \uC2E4\uB9DD
      \uC774\uD6C4 \uBC18\uAC10\uB3C4 \uCEE4\uC9C8 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087267
    m_Localized: "\uC600\uB294\uB370. \uAC19\uC740 \uACBD\uD5D8\uC740 \uC544\uB2CC
      \uB4EF."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087268
    m_Localized: "\uC600\uC2B5\uB2C8\uB2E4. \uC0AC\uB78C\uB9C8\uB2E4 \uC9C4\uC785\uACFC
      \uCCB4\uACB0\uC774 \uB2EC\uB77C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087269
    m_Localized: "\uC606\uC9D1\uC740 \uBC8C\uC368 \uBD88 \uAED0\uB098 \uBCF4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087270
    m_Localized: "\uC608\uAE08\uC8FC\uC640 \uC790\uAE08\uC744 \uBE4C\uB9AC\uB294
      \uC0AC\uC5C5\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087271
    m_Localized: "\uC608\uC0B0 5%"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087272
    m_Localized: "\uC608\uC0B0 {0:0}%"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087273
    m_Localized: "\uC608\uC0B0 \uBE44\uC728"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087274
    m_Localized: "\uC608\uC0B0\uC774 \uC900\uBE44\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uD544\uC694\uD560 \uB54C \uC8FC\uBB38 \uBC29\uC2DD\uC744 \uC120\uD0DD\uD558\uC138\uC694.
      \uC2DC\uAC04 \uC81C\uD55C\uC740 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087275
    m_Localized: "\uC608\uC0C1 \uAE08\uC561"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087276
    m_Localized: "\uC608\uC0C1 \uC8FC\uBB38 \uAE08\uC561"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087277
    m_Localized: "\uC608\uC57D\uAE08"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087278
    m_Localized: "\uC608\uC57D\uAE08\uC744 \uC81C\uC678\uD55C \uC8FC\uBB38 \uAC00\uB2A5
      \uD604\uAE08 \uC548\uC5D0\uC11C \uC785\uB825\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087279
    m_Localized: "\uC624 {symbol} {profitKind}\uC190\uC775 {amount}\uC6D0! \uAE30\uBD84
      \uC88B\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087280
    m_Localized: "\uC624, {symbol} {profitKind}\uC190\uC775 {amount}\uC6D0\uC774\uB124\uC694!
      \uAE30\uBD84 \uC88B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087281
    m_Localized: "\uC624\uB298"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087282
    m_Localized: "\uC624\uB298 \uACB0\uACFC \uAD1C\uCC2E\uB124. \uBB34\uB9AC\uD558\uC9C4
      \uB9D0\uC544\uC57C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087283
    m_Localized: "\uC624\uB298 \uACB0\uACFC\uB294 \uC544\uC27D\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087284
    m_Localized: "\uC624\uB298 \uACB0\uC0B0\uC740 \uB9C8\uC774\uB108\uC2A4\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087285
    m_Localized: "\uC624\uB298 \uACC4\uC88C\uB294 \uD50C\uB7EC\uC2A4\uB85C \uB9C8\uAC10."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087286
    m_Localized: "\uC624\uB298 \uC798\uB41C \uAC74 \uC6B4\uB3C4 \uC788\uC5C8\uACA0\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087287
    m_Localized: "\uC624\uB298 \uC7A5 \uB05D\uB0AC\uB124. \uB2E4\uB4E4 \uACE0\uC0DD\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087288
    m_Localized: "\uC624\uB298 \uC800\uB141\uC5D4 \uC0B0\uCC45 \uC880 \uD574\uC57C\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087289
    m_Localized: "\uC624\uB298 \uC8FC\uBB38 \uAE30\uB85D \uB2E4\uC2DC \uBCF4\uB294
      \uC911."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087290
    m_Localized: "\uC624\uB298 \uC8FC\uBB38 \uBA54\uBAA8 \uC4F0\uB2E4\uAC00 \uAE00\uC528\uAC00
      \uC810\uC810 \uC791\uC544\uC9D0."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087291
    m_Localized: "\uC624\uB298 \uC8FC\uBB38\uC740 \uB05D. \uC7A0\uAE50 \uC26C\uACE0
      \uC628\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087292
    m_Localized: "\uC624\uB298 \uD310\uB2E8 \uC911\uC5D0 \uBB50\uAC00 \uC544\uC26C\uC6E0\uB294\uC9C0
      \uC801\uB294 \uC911."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087293
    m_Localized: "\uC624\uB298 \uD310\uB2E8\uB4E4 \uD55C\uBC88 \uB3CC\uC544\uBD10\uC57C\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087294
    m_Localized: "\uC624\uB298\uB3C4 \uC2DC\uC7A5 \uCF1C\uB1A8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087295
    m_Localized: "\uC624\uB298\uC740 \uB77C\uBA74\uC73C\uB85C \uB05D\uB0B4\uC57C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087296
    m_Localized: "\uC624\uB298\uC740 \uBA38\uB9AC \uC880 \uC2DD\uD600\uC57C\uACA0\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087297
    m_Localized: "\uC624\uB298\uC740 \uBC30\uB2EC \uB9D0\uACE0 \uC9C1\uC811 \uBC25
      \uD574 \uBA39\uC744\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087298
    m_Localized: "\uC624\uB298\uC740 \uBC8C\uC5C8\uB2E4. \uC77C\uB2E8 \uC26C\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087299
    m_Localized: "\uC624\uB298\uC740 \uC54C\uB9BC \uC18C\uB9AC\uB9CC \uB098\uB3C4
      \uB3CC\uC544\uBCF4\uAC8C \uB418\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087300
    m_Localized: "\uC624\uB298\uC740 \uC5B4\uB5A4 \uC885\uBAA9\uC774 \uC6C0\uC9C1\uC774\uB824\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087301
    m_Localized: "\uC624\uB298\uC740 \uC790\uC0B0\uC774 \uB298\uC5C8\uB2E4. \uC774
      \uC815\uB3C4\uBA74 \uB9CC\uC871."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087302
    m_Localized: "\uC624\uB298\uC740 \uC790\uC0B0\uC774 \uC904\uC5C8\uB2E4. \uB0B4\uC77C
      \uB2E4\uC2DC \uC0DD\uAC01\uD574 \uBD04."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087303
    m_Localized: "\uC624\uB298\uC740 \uC7A0\uAE50 \uC26C\uC5B4\uB3C4 \uB418\uACA0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087304
    m_Localized: "\uC624\uB298\uC740 \uC84C\uB2E4. \uD310\uB2E8 \uAE30\uB85D\uC774\uB098
      \uBD10\uC57C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087305
    m_Localized: "\uC624\uB298\uC740 \uC870\uC6A9\uD788 \uAD00\uCC30\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087306
    m_Localized: "\uC624\uB298\uC740 \uC870\uC6A9\uD788 \uBCFC\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087307
    m_Localized: "\uC624\uB298\uC740 \uC870\uC6A9\uD788 \uBD10\uC57C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087308
    m_Localized: "\uC624\uB298\uC740 \uC8FC\uBB38 \uC804\uC5D0 \uD55C \uBC88 \uB354
      \uC0DD\uAC01\uD558\uAE30."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087309
    m_Localized: "\uC624\uB798 \uC9C0\uC9C0\uD55C \uD22C\uC790\uC790\uB294 \uBB38\uC81C\uB97C
      \uC77C\uC2DC\uC801\uC778 \uC18C\uC74C\uC73C\uB85C \uBCFC \uC218 \uC788\uB2E4.
      \uBC18\uB300\uB85C \uACFC\uAC70 \uC190\uC2E4\uC744 \uACAA\uC740 \uD22C\uC790\uC790\uB294
      \uAC19\uC740 \uC124\uBA85\uC5D0\uC11C\uB3C4 \uBE60\uC9C4 \uBD80\uBD84\uC5D0
      \uB354 \uC8FC\uBAA9\uD560 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087310
    m_Localized: "\uC624\uC5FC"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087311
    m_Localized: "\uC628\uB77C\uC778\uC5D0\uC11C \uD070 \uBAA9\uC18C\uB9AC\uB97C
      \uB0B4\uB294 \uC9D1\uB2E8\uC774 \uBAA8\uB4E0 \uACE0\uAC1D\uC774\uB098 \uC9C1\uC6D0\uC758
      \uC758\uACAC\uC744 \uB300\uD45C\uD558\uC9C0\uB294 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087312
    m_Localized: "\uC62C\uB77C\uC624\uAE34 \uD588\uB294\uB370 \uC5EC\uAE30\uC11C
      \uB354 \uB530\uB77C\uAC08\uAE4C \uACE0\uBBFC \uC911."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087313
    m_Localized: "\uC640 {symbol} \uB0B4 \uACC4\uC88C {return}\uB124 \u3137\u3137"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087314
    m_Localized: "\uC640 \uAC70\uB798\uD55C \uB4A4 \uD750\uB984\uC774 \uB098\uC058\uC9C0
      \uC54A\uC558\uC2B5\uB2C8\uB2E4. \uB2E4\uC74C \uC6C0\uC9C1\uC784\uB3C4 \uC9C0\uCF1C\uBCF4\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087315
    m_Localized: "\uC640 \uAC70\uB798\uD55C \uB4A4 \uD750\uB984\uC774 \uBD88\uB9AC\uD574\uC84C\uB124\uC694.
      \uB2E4\uC74C\uC5D0\uB294 \uACBD\uACC4\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087316
    m_Localized: "\uC65C \uADF8\uB807\uAC8C \uC5F4 \uBC1B\uC558\uC74C \u314B\u314B"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087317
    m_Localized: "\uC694\uC998 \uB9D0\uD558\uAE30 \uC880 \uC870\uC2EC\uC2A4\uB7FD\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087318
    m_Localized: "\uC694\uC998 \uC7A0\uBD80\uD130 \uC81C\uB300\uB85C \uC790\uB824\uACE0
      \uB178\uB825 \uC911."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087319
    m_Localized: "\uC694\uC998\uC740 \uB9D0\uC744 \uAEBC\uB0B4\uAE30\uAC00 \uC870\uC2EC\uC2A4\uB7FD\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087320
    m_Localized: "\uC6B0\uAE30\uAE30\uB9CC \uD558\uBA74 \uB300\uD654\uAC00 \uB418\uB0D0?"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087321
    m_Localized: "\uC6B0\uAE30\uAE30\uB9CC \uD558\uBA74 \uB300\uD654\uAC00 \uB418\uB0D0?
      \uB9D0 \uC880 \uAC00\uB824."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087322
    m_Localized: "\uC6B4\uC601 \uAD8C\uD55C \uD544\uC694 \xB7 \uC2E4\uC81C \uAC70\uB798\uB300\uAE08 "
    m_Metadata:
      m_Items: []
  - m_Id: 1392087323
    m_Localized: "\uC6B4\uC601 \uC870\uAC74 \uB2EC\uC131"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087324
    m_Localized: "\uC6B4\uC601 \uC885\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087325
    m_Localized: "\uC6B4\uC601\uC790 \uAD00\uCC30"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087326
    m_Localized: "\uC6B4\uC601\uC790 \uB300\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087327
    m_Localized: "\uC6B4\uC601\uC790\uAC00 \uC8FC\uBB38\uC744 \uAD00\uCC30 \uC911\uC785\uB2C8\uB2E4.
      \uCCAB \uC2E0\uD638\uB97C \uAE30\uB2E4\uB824\uB3C4 \uC2DC\uC7A5\uC740 \uACC4\uC18D
      \uC6C0\uC9C1\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087328
    m_Localized: "\uC6B4\uC601\uC790\uAC00 \uC900\uBE44\uB418\uBA74 \uCC38\uC5EC\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087329
    m_Localized: "\uC6B4\uC6A9\uC790\uC0B0 \uCD95\uC18C"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087330
    m_Localized: "\uC6D0"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087331
    m_Localized: "\uC6D0\n/ "
    m_Metadata:
      m_Items: []
  - m_Id: 1392087332
    m_Localized: "\uC6D0\n\uB204\uC801 \uC2E4\uD604\uC190\uC775 "
    m_Metadata:
      m_Items: []
  - m_Id: 1392087333
    m_Localized: "\uC6D0\n\uB450 \uC870\uAC74\uC744 \uCDA9\uC871\uD558\uBA74 \uB9AC\uB529\uBC29\uC744
      \uC5F4 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uBBF8\uCCB4\uACB0 \uC8FC\uBB38\xB7\uD3C9\uAC00\uC774\uC775\uC740
      \uC131\uACFC\uC5D0 \uD3EC\uD568\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\n\uCC38\uAC00\uC790\uB294
      \uC790\uAE08\uACFC \uC2E0\uB8B0\uC5D0 \uB530\uB77C \uB3C5\uB9BD\uC801\uC73C\uB85C
      \uD310\uB2E8\uD569\uB2C8\uB2E4.\n\uAE30\uC5C5 \uACBD\uC601\uC740 \uC2E4\uC81C
      \uC9C0\uBD84 50% \uCD08\uACFC \uC2DC \uAC00\uB2A5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087334
    m_Localized: "\uC6D0     \uAD6C\uC81C "
    m_Metadata:
      m_Items: []
  - m_Id: 1392087335
    m_Localized: "\uC6D0     \uC138\uAE08 "
    m_Metadata:
      m_Items: []
  - m_Id: 1392087336
    m_Localized: "\uC6D0  ("
    m_Metadata:
      m_Items: []
  - m_Id: 1392087337
    m_Localized: "\uC6D0 \xB7 \uC2E4\uD604 \uC131\uACFC \uC5C6\uC74C \xB7 \uBC30\uC2E0\uAC10
      +"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087338
    m_Localized: "\uC6D0 \xB7 \uC608\uC218\uAE08 "
    m_Metadata:
      m_Items: []
  - m_Id: 1392087339
    m_Localized: "\uC6D0 \uB354 \uD544\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087340
    m_Localized: "\uC6D0 \uB9E4\uB3C4 \uC870\uAC74 \uAE30\uB2E4\uB9AC\uB294 \uC911."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087341
    m_Localized: "\uC6D0 \uB9E4\uB3C4 \uC8FC\uBB38 \uB300\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087342
    m_Localized: "\uC6D0 \uB9E4\uC218 \uC870\uAC74\uAE4C\uC9C0 \uAE30\uB2E4\uB9B4\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087343
    m_Localized: "\uC6D0 \uB9E4\uC218 \uC8FC\uBB38 \uB300\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087344
    m_Localized: "\uC6D0 \uBCF4\uACE0 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087345
    m_Localized: "\uC6D0 \uBCF4\uACE0 \uC788\uC5B4\uC694. "
    m_Metadata:
      m_Items: []
  - m_Id: 1392087346
    m_Localized: "\uC6D0 \uBD80\uC871\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087347
    m_Localized: "\uC6D0 \uC774\uCCB4 \uC644\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087348
    m_Localized: "\uC6D0 \uC815\uB3C4"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087349
    m_Localized: "\uC6D0 \uC8FC\uBB38\uC744 \uB300\uAE30 \uC911\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087350
    m_Localized: "\uC6D0 \uCD5C\uADFC \uB9E4\uC218 \uCCB4\uACB0"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087351
    m_Localized: "\uC6D0, \uC2E4\uD604\uC190\uC775 "
    m_Metadata:
      m_Items: []
  - m_Id: 1392087352
    m_Localized: "\uC6D0."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087353
    m_Localized: "\uC6D0. "
    m_Metadata:
      m_Items: []
  - m_Id: 1392087354
    m_Localized: "\uC6D0. \uAC04\uACA9 "
    m_Metadata:
      m_Items: []
  - m_Id: 1392087355
    m_Localized: "\uC6D0. \uD3C9\uAC00\uC190\uC775 "
    m_Metadata:
      m_Items: []
  - m_Id: 1392087356
    m_Localized: "\uC6D0\uC5D0 \uB9E4\uC218 \uCCB4\uACB0\uB410\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087357
    m_Localized: "\uC6D0\uC5D0\uB3C4 \uC2E4\uC81C \uC8FC\uBB38\uC774 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087358
    m_Localized: "\uC6D0\uC73C\uB85C \uC785\uB825\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087359
    m_Localized: "\uC6D0\uC740 \uBE44\uC309\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087360
    m_Localized: "\uC6D0\uCBE4"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087361
    m_Localized: "\uC704\uC544\uB798 \uC5B4\uB290 \uCABD\uC73C\uB85C \uC6C0\uC9C1\uC77C\uC9C0
      \uBCF4\uACE0 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087362
    m_Localized: "\uC704\uD5D8"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087363
    m_Localized: "\uC704\uD5D8 \uC54C\uB9BC \uD655\uC778: "
    m_Metadata:
      m_Items: []
  - m_Id: 1392087364
    m_Localized: "\uC704\uD5D8\uC885\uBAA9"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087365
    m_Localized: "\uC720\uB3D9\uC131"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087366
    m_Localized: "\uC720\uB8CC \uD68C\uC6D0"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087367
    m_Localized: "\uC720\uBA85 \uACE0\uAC1D\uC758 \uC774\uB984\uC774 \uAE30\uB300\uB97C
      \uD0A4\uC6B0\uB354\uB77C\uB3C4 \uC2E4\uC81C \uB9E4\uCD9C \uAE30\uC5EC\uB3C4\uB294
      \uBCC4\uB3C4 \uBB38\uC81C\uB2E4. \uC774\uB984\uAC12\uB9CC\uC73C\uB85C \uBAA8\uB4E0
      \uC870\uAC74\uC774 \uC720\uB9AC\uD574\uC9C0\uB294 \uAC83\uC740 \uC544\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087368
    m_Localized: "\uC720\uC0C1\uC99D\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087369
    m_Localized: "\uC720\uD589"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087370
    m_Localized: "\uC720\uD589\uC73C\uB85C \uC5BB\uC740 \uAD00\uC2EC\uACFC \uC624\uB798
      \uC313\uC740 \uCDA9\uC131\uB3C4\uB294 \uB2E4\uB974\uB2E4. {company}\uC758 \uC778\uAE30\uAC00
      \uC2E4\uC81C \uBC18\uBCF5 \uC774\uC6A9\uC73C\uB85C \uC774\uC5B4\uC9C0\uB294\uC9C0
      \uC0B4\uD3B4\uBCFC \uD544\uC694\uAC00 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087371
    m_Localized: "\uC758 \uC0C8 \uC18C\uC2DD\uC774 \uC804\uD574\uC84C\uC2B5\uB2C8\uB2E4.
      \uAE30\uC5C5 \uAC00\uCE58\uBFD0 \uC544\uB2C8\uB77C \uACE0\uAC1D\xB7\uD611\uB825\uC0AC\xB7\uD22C\uC790\uC790\uAC00
      \uBC1B\uC544\uB4E4\uC774\uB294 \uB9E5\uB77D\uB3C4 \uC0B4\uD3B4\uBCFC \uD544\uC694\uAC00
      \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087372
    m_Localized: "\uC758\uACAC \uB2E4\uB978 \uAC74 \uC54C\uACA0\uB294\uB370 \uC0AC\uB78C\uD55C\uD14C
      \uAF42\uC9C4 \uB9D0\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087373
    m_Localized: "\uC758\uACAC \uB2E4\uB978 \uBD80\uBD84\uB9CC \uD558\uB098\uC529
      \uC598\uAE30\uD574 \uBD10\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087374
    m_Localized: "\uC758\uACAC \uB2E4\uB978 \uBD80\uBD84\uB9CC \uD558\uB098\uC529
      \uC598\uAE30\uD574 \uBD10\uC694. \uC0AC\uB78C\uBCF4\uB2E4 \uADFC\uAC70\uB97C
      \uBD10\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087375
    m_Localized: "\uC758\uACAC \uC4F0\uB824\uB2E4 \uBA48\uCDC4\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087376
    m_Localized: "\uC758\uACAC\uC744 \uC4F0\uB824\uB2E4 \uC7A0\uC2DC \uBA48\uCDC4\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087377
    m_Localized: "\uC758\uACAC\uC774 \uB2E4\uB978 \uAC74\uC9C0 \uC0AC\uC2E4\uC774
      \uB2E4\uB978 \uAC74\uC9C0 \uB098\uB220 \uBD10\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087378
    m_Localized: "\uC758\uACAC\uC774 \uB2E4\uB978 \uAC74\uC9C0 \uC0AC\uC2E4\uC774
      \uB2E4\uB978 \uAC74\uC9C0\uBD80\uD130 \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087379
    m_Localized: "\uC758\uACAC\uC774 \uB2E4\uB978 \uAC83\uC778\uB370 \uC81C\uAC00
      \uB0A0\uCE74\uB86D\uAC8C \uBC18\uC751\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087380
    m_Localized: "\uC758\uACAC\uC774 \uB2E4\uB978 \uAC83\uC778\uB370 \uC81C\uAC00
      \uB0A0\uCE74\uB86D\uAC8C \uBC18\uC751\uD588\uC2B5\uB2C8\uB2E4. \uB2E4\uC2DC
      \uC0AC\uACFC\uB4DC\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087381
    m_Localized: "\uC758\uACAC\uC774 \uB2E4\uB978 \uBD80\uBD84\uACFC \uC0AC\uC2E4\uC774
      \uB2E4\uB978 \uBD80\uBD84\uC744 \uB098\uB204\uC2DC\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087382
    m_Localized: "\uC758\uACAC\uC774 \uB2E4\uB978 \uBD80\uBD84\uC744 \uD558\uB098\uC529
      \uB9D0\uC500\uD574 \uC8FC\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087383
    m_Localized: "\uC758\uACAC\uC774 \uB2E4\uB978 \uBD80\uBD84\uC744 \uD558\uB098\uC529
      \uB9D0\uC500\uD574 \uC8FC\uC2ED\uC2DC\uC624. \uC0AC\uB78C\uBCF4\uB2E4 \uADFC\uAC70\uB97C
      \uBCF4\uC2DC\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087384
    m_Localized: "\uC758\uB8CC \uAD00\uACC4\uC790\uC640 \uC5F0\uAD6C \uCEE4\uBBA4\uB2C8\uD2F0"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087385
    m_Localized: "\uC758\uC2EC\uD558\uB294 \uAC74 \uC54C\uACA0\uB294\uB370 \uACB0\uB860\uC740
      \uB2E4\uB974\uAC8C \uBD04."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087386
    m_Localized: "\uC758\uC2EC\uD558\uB294 \uAC74 \uC54C\uACA0\uB294\uB370 \uACB0\uB860\uC740
      \uB2E4\uB974\uAC8C \uBD10\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087387
    m_Localized: "\uC758\uC2EC\uD558\uC2DC\uB294 \uBD80\uBD84\uC740 \uC54C\uC9C0\uB9CC
      \uACB0\uB860\uC5D0\uB294 \uB3D9\uC758\uD558\uAE30 \uC5B4\uB835\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087388
    m_Localized: "\uC758\uC790\uC5D0 \uB108\uBB34 \uC624\uB798 \uC549\uC544 \uC788\uC5C8\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087389
    m_Localized: "\uC758\uC790\uC5D0\uC11C \uC77C\uC5B4\uB0AC\uB354\uB2C8 \uB2E4\uB9AC
      \uC874\uC7AC\uAC10 \uBBF8\uCCE4\uB124"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087390
    m_Localized: "\uC774 \uAE30\uC0AC\uC5D0 \uC9C1\uC811 \uC5F0\uACB0\uB41C \uACF5\uAC1C
      \uBC1C\uC5B8\uC740 \uC544\uC9C1 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087391
    m_Localized: "\uC774 \uB300\uD654 \uB354 \uD558\uACE0 \uC2F6\uC9C4 \uC54A\uB124\uC694.
      \uBC29 \uB098\uAC08\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087392
    m_Localized: "\uC774 \uB300\uD654 \uB354 \uD558\uACE0 \uC2F6\uC9C4 \uC54A\uB124\uC694.
      \uBC29 \uB098\uAC08\uAC8C\uC694. \uC774\uB9CC \uAC08\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087393
    m_Localized: "\uC774 \uB300\uD654 \uB354 \uD558\uAE30 \uC2EB\uB2E4. \uB098\uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087394
    m_Localized: "\uC774 \uB300\uD654 \uB354 \uD558\uAE30 \uC2EB\uB2E4. \uB098\uAC04\uB2E4.
      \uC774\uB9CC \uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087395
    m_Localized: "\uC774 \uB300\uD654\uAC00 \uB2E4\uB978 \uBD84\uB4E4\uAED8\uB3C4
      \uBCF4\uC778\uB2E4\uB294 \uC810\uC744 \uC0DD\uAC01\uD574 \uC8FC\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087396
    m_Localized: "\uC774 \uB300\uD654\uAC00 \uB2E4\uB978 \uBD84\uB4E4\uAED8\uB3C4
      \uBCF4\uC778\uB2E4\uB294 \uC810\uC744 \uC0DD\uAC01\uD574 \uC8FC\uC2ED\uC2DC\uC624.
      \uC0AC\uB78C\uBCF4\uB2E4 \uADFC\uAC70\uB97C \uBCF4\uC2DC\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087397
    m_Localized: "\uC774 \uB300\uD654\uB97C \uACC4\uC18D\uD558\uACE0 \uC2F6\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4. \uBC29\uC744 \uB098\uAC11\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087398
    m_Localized: "\uC774 \uB300\uD654\uB97C \uACC4\uC18D\uD558\uACE0 \uC2F6\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4. \uBC29\uC744 \uB098\uAC11\uB2C8\uB2E4. \uC774\uB9CC
      \uB5A0\uB098\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087399
    m_Localized: "\uC774 \uB9D0 \uB4E4\uC73C\uB2C8 {memWhen} \uB098\uB791 \uC2F8\uC6B4
      \uAC70 \uC0DD\uAC01\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087400
    m_Localized: "\uC774 \uBD84\uC704\uAE30\uC5D0\uC11C \uB354 \uC598\uAE30\uD558\uAE34
      \uC5B4\uB835\uB124\uC694. \uB098\uAC08\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087401
    m_Localized: "\uC774 \uBD84\uC704\uAE30\uC5D0\uC11C \uB354 \uC598\uAE30\uD558\uAE34
      \uC5B4\uB835\uB124\uC694. \uB098\uAC08\uAC8C\uC694. \uC774\uB9CC \uAC08\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087402
    m_Localized: "\uC774 \uBD84\uC704\uAE30\uC5D0\uC11C \uC598\uAE30 \uBABB \uD558\uACA0\uB2E4.
      \uB098\uAC10."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087403
    m_Localized: "\uC774 \uBD84\uC704\uAE30\uC5D0\uC11C \uC598\uAE30 \uBABB \uD558\uACA0\uB2E4.
      \uB098\uAC10. \uC774\uB9CC \uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087404
    m_Localized: "\uC774 \uBD84\uC704\uAE30\uC5D0\uC11C\uB294 \uB354 \uC774\uC57C\uAE30\uD558\uAE30
      \uC5B4\uB835\uACA0\uC2B5\uB2C8\uB2E4. \uB098\uAC00\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087405
    m_Localized: "\uC774 \uBD84\uC704\uAE30\uC5D0\uC11C\uB294 \uB354 \uC774\uC57C\uAE30\uD558\uAE30
      \uC5B4\uB835\uACA0\uC2B5\uB2C8\uB2E4. \uB098\uAC00\uACA0\uC2B5\uB2C8\uB2E4.
      \uC774\uB9CC \uB5A0\uB098\uACA0\uC2B5\uB2C8\uB2E4."
