      m_Items: []
  - m_Id: 1392088069
    m_Localized: "\uC9C4\uC9DC\uB85C\uC694. \uBC29\uC7A5\uB2D8, \uB354 \uCEE4\uC9C0\uAE30
      \uC804\uC5D0 \uD655\uC778 \uC880 \uD574 \uC8FC\uC138\uC694."
