  - m_Id: 395375667679246
    m_Localized: "\uC2DC\uC7A5\uC774 \uBBFF\uB294 \uAC00\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 395375667679247
    m_Localized: "\uAC1C\uC778 \uD22C\uC790\uC790\uB4E4\uC774 \uC9C0\uAE08 \uC774
      \uC885\uBAA9\uC744 \uC5BC\uB9C8\uC9DC\uB9AC\uB85C \uBBFF\uACE0 \uC788\uB294\uC9C0
      \uCC28\uD2B8\uC5D0 \uD45C\uC2DC\uD569\uB2C8\uB2E4. \uC18C\uBB38\uACFC \uB274\uC2A4,
      \uC138\uB825\uC758 \uC791\uC5C5\uC73C\uB85C \uBD80\uD480\uAC70\uB098 \uAEBC\uC9C0\uB294
      \uAC12\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 395375667679248
    m_Localized: "\uAE30\uC5C5 \uC2E4\uC81C \uAC00\uCE58"
    m_Metadata:
      m_Items: []
  - m_Id: 395375667679249
    m_Localized: "\uC2E4\uC801\uACFC \uC0AC\uC5C5 \uC804\uB9DD\uC73C\uB85C \uACC4\uC0B0\uD55C
      \uC8FC\uB2F9 \uC2E4\uC81C \uAC00\uCE58\uB97C \uCC28\uD2B8\uC5D0 \uD45C\uC2DC\uD569\uB2C8\uB2E4.
      \uC2DC\uC7A5\uC774 \uBBFF\uB294 \uAC00\uACA9\uACFC\uC758 \uCC28\uC774\uAC00
      \uACE7 \uAC70\uD488\uC758 \uD06C\uAE30\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603803324416
    m_Localized: "{stockName} \uC77C\uBD80\uB9CC \uC775\uC808\uD588\uC5B4. \uB098\uBA38\uC9C0\uB294
      \uB354 \uB4E4\uACE0 \uAC00\uBCF8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878848
    m_Localized: "{stockName} \uC808\uBC18\uCBE4 \uB35C\uC5B4\uB0C8\uB2E4. \uC774\uC81C
      \uB9C8\uC74C \uD3B8\uD558\uAC8C \uBCFC \uC218 \uC788\uACA0\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878849
    m_Localized: "{stockName} \uC870\uAE08 \uD314\uC544\uC11C \uC218\uC775 \uCC59\uACBC\uC74C.
      \uB0A8\uC740 \uAC74 \uB364\uC774\uC9C0 \uBB50."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878850
    m_Localized: "{stockName} \uC77C\uBD80 \uC775\uC808. \uB2E4 \uD314\uAE34 \uC544\uC26C\uC6CC\uC11C
      \uC880 \uB0A8\uACBC\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878851
    m_Localized: "{stockName} \uC77C\uBD80 \uC775\uC808\uD588\uC2B5\uB2C8\uB2E4.
      \uB0A8\uC740 \uBB3C\uB7C9\uC740 \uC870\uAE08 \uB354 \uC9C0\uCF1C\uBCF4\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878852
    m_Localized: "{stockName} \uBCF4\uC720\uBD84 \uC77C\uBD80\uB97C \uC218\uC775\uC73C\uB85C
      \uC815\uB9AC\uD588\uC2B5\uB2C8\uB2E4. \uB098\uBA38\uC9C0\uB294 \uACC4\uD68D\uB300\uB85C
      \uB4E4\uACE0 \uAC11\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878853
    m_Localized: "{stockName} \uC77C\uBD80 \uD138\uC5C8\uB2E4. \uB098\uBA38\uC9C0\uB294
      \uB05D\uAE4C\uC9C0 \uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878854
    m_Localized: "{stockName} \uC880 \uD314\uC544\uC11C \uCC59\uACBC\uB2E4. \uB0A8\uC740
      \uAC74 \uBC84\uD2F4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878855
    m_Localized: "{stockName} \uC77C\uBD80 \uC190\uC808\uD588\uC5B4. \uB2E4 \uB358\uC9C0\uC9C4
      \uBABB\uD558\uACA0\uB354\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878856
    m_Localized: "{stockName} \uBE44\uC911 \uC880 \uC904\uC600\uB2E4. \uC190\uD574
      \uBCF4\uACE0 \uD310 \uAC70\uB77C \uC18D\uC740 \uC4F0\uB9AC\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878857
    m_Localized: "{stockName} \uC77C\uBD80\uB97C \uC190\uC2E4\uB85C \uC815\uB9AC\uD588\uC2B5\uB2C8\uB2E4.
      \uBE44\uC911\uC744 \uC904\uC774\uB294 \uAC8C \uB9DE\uB2E4\uACE0 \uBD24\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878858
    m_Localized: "{stockName} \uC77C\uBD80 \uC190\uC808. \uB354 \uBB3C\uB9AC\uAE30
      \uC804\uC5D0 \uB35C\uC5B4\uB0C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878859
    m_Localized: "\uCD95\uD558\uB4DC\uB9BD\uB2C8\uB2E4. \uC88B\uC740 \uACB0\uACFC\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878860
    m_Localized: "\uC218\uC775 \uCD95\uD558\uB4DC\uB9BD\uB2C8\uB2E4. \uB05D\uAE4C\uC9C0
      \uC131\uD22C\uD558\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878861
    m_Localized: "\uBD80\uB7FD\uC2B5\uB2C8\uB2E4. \uC798 \uC9C0\uD0A4\uC2DC\uAE38
      \uBC14\uB78D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878862
    m_Localized: "\uC88B\uC740 \uD310\uB2E8\uC774\uC168\uB124\uC694. \uC131\uD22C
      \uAE30\uC6D0\uD569\uB2C8\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878863
    m_Localized: "\uACB0\uACFC\uAC00 \uC88B\uC73C\uC2DC\uB2C8 \uC800\uB3C4 \uAE30\uBD84\uC774
      \uC88B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878864
    m_Localized: "\uCD95\uD558\uB4DC\uB824\uC694. \uC775\uC808\uAE4C\uC9C0 \uBB34\uC0AC\uD788
      \uAC00\uC2DC\uAE38 \uBC14\uB78D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878865
    m_Localized: "\uB300\uB2E8\uD558\uC2DC\uB124\uC694. \uC800\uB3C4 \uBC30\uC6B0\uACE0
      \uC2F6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878866
    m_Localized: "\uC131\uD22C\uD558\uC168\uB124\uC694. \uACC4\uC18D \uC88B\uC740
      \uACB0\uACFC \uC788\uC73C\uC2DC\uAE38\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878867
    m_Localized: "\uC624 \uCD95\uD558\uD574\uC694. \uC88B\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878868
    m_Localized: "\uBD80\uB7FD\uB124\uC694 \u314E\u314E \uC131\uD22C\uD558\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878869
    m_Localized: "\uC798 \uB410\uB124\uC694. \uC218\uC775\uC740 \uC9C0\uD0A4\uB294
      \uAC8C \uBC18\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878870
    m_Localized: "\uCD95\uD558\uD574\uC694! \uB098\uB3C4 \uADF8\uB7F0 \uB0A0\uC774
      \uC624\uBA74 \uC88B\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878871
    m_Localized: "\uC640 \uC88B\uB124\uC694. \uB05D\uAE4C\uC9C0 \uC798 \uCC59\uACA8\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878872
    m_Localized: "\uCD95\uD558\uD574\uC694. \uAE30\uC6B4 \uC880 \uBC1B\uC544 \uAC08\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878873
    m_Localized: "\uC131\uD22C \uAE30\uC6D0\uD569\uB2C8\uB2E4! \uC9C4\uC9DC \uBD80\uB7FD\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878874
    m_Localized: "\uC798\uD588\uB124\uC694. \uC624\uB298\uC740 \uB9DB\uC788\uB294
      \uAC70 \uBA39\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878875
    m_Localized: "\uC624 \uCD95\uD558. \uC88B\uACA0\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878876
    m_Localized: "\uBD80\uB7FD\uB2E4. \uC131\uD22C\uD574\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878877
    m_Localized: "\uC798 \uB410\uB124. \uC9C0\uD0A4\uB294 \uAC8C \uC2E4\uB825\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878878
    m_Localized: "\uCD95\uD558\uD55C\uB2E4. \uB2E4\uC74C\uC5D4 \uB098\uB3C4 \uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878879
    m_Localized: "\uC88B\uACA0\uB2E4. \uB05D\uAE4C\uC9C0 \uCC59\uACA8\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878880
    m_Localized: "\uC778\uC815. \uC624\uB298\uC740 \uB124 \uB0A0\uC774\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878881
    m_Localized: "\uC131\uD22C\uD558\uC2ED\uC154. \uBD80\uB7FD\uAE34 \uD558\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878882
    m_Localized: "\uC798\uD588\uB2E4. \uC695\uC2EC\uB9CC \uB0B4\uC9C0 \uB9C8\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878883
    m_Localized: "\uC544\uC9C1 \uB9E4\uB3C4 \uC804\uC774\uC2DC\uB77C\uBA74 \uD655\uC815\uB41C
      \uC218\uC775\uC740 \uC544\uB2C8\uC9C0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878884
    m_Localized: "\uC88B\uC73C\uC2DC\uACA0\uC2B5\uB2C8\uB2E4. \uB2E4\uB9CC \uB0B4\uC77C\uB3C4
      \uAC19\uC744\uC9C0\uB294 \uBAA8\uB974\uACA0\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878885
    m_Localized: "\uC790\uB791\uC740 \uC775\uC808 \uC774\uD6C4\uC5D0 \uD558\uC154\uB3C4
      \uB2A6\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878886
    m_Localized: "\uC6B4\uC774 \uC88B\uC73C\uC168\uB358 \uAC78 \uC218\uB3C4 \uC788\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878887
    m_Localized: "\uC218\uC775\uC774 \uB098\uC2E4 \uB54C\uB9CC \uB9D0\uC500\uC774
      \uB9CE\uC544\uC9C0\uC2DC\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878888
    m_Localized: "\uD558... \uAD73\uC774 \uC5EC\uAE30\uC11C \uB9D0\uC500\uD558\uC2E4
      \uD544\uC694\uAC00 \uC788\uC5C8\uB098 \uC2F6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878889
    m_Localized: "\uCD95\uD558\uB294 \uB4DC\uB9BD\uB2C8\uB2E4\uB9CC, \uC870\uAE08
      \uACFC\uD558\uAC8C \uB4E4\uB9AC\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878890
    m_Localized: "\uC9C0\uB09C\uBC88 \uC190\uC2E4 \uB54C\uB294 \uC870\uC6A9\uD558\uC168\uB358
      \uAC78\uB85C \uAE30\uC5B5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878891
    m_Localized: "\uD558... \uC790\uB791\uD558\uB7EC \uC624\uC168\uC5B4\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878892
    m_Localized: "\uD314\uAE30 \uC804\uAE4C\uC9C4 \uC22B\uC790\uC77C \uBFD0\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878893
    m_Localized: "\uC88B\uACA0\uB124\uC694~ \uADFC\uB370 \uADF8\uAC8C \uC2E4\uB825\uC778\uC9C0\uB294
      \uBAA8\uB974\uACA0\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878894
    m_Localized: "\uBC30 \uC544\uD504\uB2C8\uAE4C \uADF8\uB9CC\uD574\uC694 \u314E\u314E"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878895
    m_Localized: "\uB0B4\uC77C\uB3C4 \uADF8 \uC22B\uC790\uBA74 \uADF8\uB54C \uB2E4\uC2DC
      \uC598\uAE30\uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878896
    m_Localized: "\uC218\uC775 \uB0AC\uC744 \uB54C\uB9CC \uC624\uC2DC\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878897
    m_Localized: "\uB124\uB124 \uB300\uB2E8\uD558\uC2DC\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878898
    m_Localized: "\uC775\uC808\uD558\uACE0 \uB098\uC11C \uC790\uB791\uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878899
    m_Localized: "\uD558... \uB610 \uC790\uB791\uC774\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878900
    m_Localized: "\uD314\uAE30 \uC804\uC5D4 \uB124 \uB3C8 \uC544\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878901
    m_Localized: "\uC6B4\uC774\uC9C0 \uADF8\uAC8C \uC2E4\uB825\uC774\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878902
    m_Localized: "\uBC30 \uC544\uD504\uB2E4. \uADF8\uB9CC\uD574\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878903
    m_Localized: "\uB0B4\uC77C \uBC18\uB0A9\uD560 \uAC70 \uBED4\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878904
    m_Localized: "\uC624\uB97C \uB54C\uB9CC \uB098\uD0C0\uB098\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878905
    m_Localized: "\uADF8\uB798 \uC798\uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878906
    m_Localized: "\uC775\uC808\uC774\uB098 \uD558\uACE0 \uB5A0\uB4E4\uC5B4\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878907
    m_Localized: "\uC2E4\uB840\uC9C0\uB9CC \uC815\uB9D0\uC778\uAC00\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878908
    m_Localized: "\uB9E4\uC218 \uC2DC\uC810\uC774 \uC5B8\uC81C\uC600\uB294\uC9C0
      \uAD81\uAE08\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878909
    m_Localized: "?? \uADF8 \uC218\uCE58\uAC00 \uB9DE\uB294\uC9C0 \uB2E4\uC2DC \uD655\uC778\uD574
      \uBCF4\uC168\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878910
    m_Localized: "\uD3C9\uB2E8\uC744 \uC815\uD655\uD788 \uBCF4\uC2E0 \uAC74\uC9C0
      \uAD81\uAE08\uD558\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878911
    m_Localized: "\uBBFF\uAE30 \uC5B4\uB824\uC6B4 \uD0C0\uC774\uBC0D\uC774\uAE34
      \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878912
    m_Localized: "\uB9E4\uB3C4\uAE4C\uC9C0 \uD558\uC2E0 \uAC74\uAC00\uC694, \uC544\uC9C1
      \uBCF4\uC720 \uC911\uC774\uC2E0\uAC00\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878913
    m_Localized: "\uC0AC\uC2E4\uC774\uB77C\uBA74 \uB300\uB2E8\uD558\uC2E0\uB370,
      \uADFC\uAC70\uAC00 \uAD81\uAE08\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878914
    m_Localized: "\uADF8 \uC815\uB3C4 \uC218\uC775\uC774 \uAC00\uB2A5\uD55C \uAD6C\uAC04\uC774\uC5C8\uB098\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878915
    m_Localized: "?? \uC9C4\uC9DC\uC608\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878916
    m_Localized: "\uC5B8\uC81C \uC0AC\uC168\uAE38\uB798 \uADF8\uAC8C \uB098\uC640\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878917
    m_Localized: "\uC778\uC99D \uC5C6\uC73C\uBA74 \uC880 \uBBFF\uAE30 \uC5B4\uB824\uC6B4\uB370\uC694
      \u314E\u314E"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878918
    m_Localized: "\uD3C9\uB2E8 \uC81C\uB300\uB85C \uBCF8 \uAC70 \uB9DE\uC544\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878919
    m_Localized: "\uD0C0\uC774\uBC0D\uC774 \uB108\uBB34 \uC88B\uC740\uB370\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878920
    m_Localized: "\uD310 \uAC70\uC608\uC694, \uC544\uC9C1 \uB4E4\uACE0 \uC788\uB294
      \uAC70\uC608\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878921
    m_Localized: "\uC5D0\uC774 \uC124\uB9C8\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878922
    m_Localized: "?? \uADF8\uAC8C \uB3FC\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878923
    m_Localized: "?? \uC9C4\uC9DC\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878924
    m_Localized: "\uC5B8\uC81C \uC0C0\uAE38\uB798 \uADF8\uAC8C \uB098\uC624\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878925
    m_Localized: "\uC778\uC99D \uC5C6\uC73C\uBA74 \uC548 \uBBFF\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878926
    m_Localized: "\uD3C9\uB2E8 \uC81C\uB300\uB85C \uBCF8 \uAC70 \uB9DE\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878927
    m_Localized: "\uD0C0\uC774\uBC0D\uC774 \uB108\uBB34 \uC88B\uC740\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878928
    m_Localized: "\uD310 \uAC70\uB0D0 \uB4E4\uACE0 \uC788\uB294 \uAC70\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878929
    m_Localized: "\uB9D0\uB85C\uB294 \uB204\uAC00 \uBABB \uBC84\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878930
    m_Localized: ??
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878931
    m_Localized: "\uC5BC\uB9C8\uC5D0 \uB9E4\uC218\uD558\uC168\uB294\uC9C0 \uC5EC\uCB64\uBD10\uB3C4
      \uB420\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878932
    m_Localized: "\uB9E4\uB3C4 \uACC4\uD68D\uC740 \uC5B4\uB5BB\uAC8C \uC7A1\uACE0
      \uACC4\uC2ED\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878933
    m_Localized: "{symbol}\uC740 \uC9C0\uAE08 \uB4E4\uC5B4\uAC00\uB3C4 \uAD1C\uCC2E\uB2E4\uACE0
      \uBCF4\uC2ED\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878934
    m_Localized: "\uC5B4\uB5A4 \uC810\uC744 \uBCF4\uACE0 \uB9E4\uC218\uD558\uC168\uB098\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878935
    m_Localized: "\uB354 \uC624\uB97C \uC5EC\uC9C0\uAC00 \uC788\uB2E4\uACE0 \uBCF4\uC2DC\uB294\uC9C0\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878936
    m_Localized: "\uBE44\uC911\uC740 \uC5B4\uB290 \uC815\uB3C4 \uC2E4\uC73C\uC168\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878937
    m_Localized: "\uC5B8\uC81C\uBD80\uD130 \uBCF4\uC720\uD558\uACE0 \uACC4\uC168\uB098\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878938
    m_Localized: "\uBAA9\uD45C\uAC00\uB294 \uC5B4\uB514\uCBE4\uC73C\uB85C \uBCF4\uACE0
      \uACC4\uC2ED\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878939
    m_Localized: "\uC5BC\uB9C8\uC5D0 \uB4E4\uC5B4\uAC00\uC168\uC5B4\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878940
    m_Localized: "\uC5B8\uC81C \uD314 \uC0DD\uAC01\uC774\uC5D0\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878941
    m_Localized: "{symbol} \uC9C0\uAE08 \uB4E4\uC5B4\uAC00\uB3C4 \uB420\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878942
    m_Localized: "\uBB50 \uBCF4\uACE0 \uC0AC\uC168\uC5B4\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878943
    m_Localized: "\uB354 \uAC08 \uAC83 \uAC19\uC544\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878944
    m_Localized: "\uBE44\uC911\uC740 \uC5BC\uB9C8\uB098 \uC2E4\uC5C8\uC5B4\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878945
    m_Localized: "\uC5B8\uC81C\uBD80\uD130 \uB4E4\uACE0 \uACC4\uC168\uC5B4\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878946
    m_Localized: "\uC5B4\uB514\uAE4C\uC9C0 \uBCF4\uACE0 \uC788\uC5B4\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878947
    m_Localized: "\uC5BC\uB9C8\uC5D0 \uB4E4\uC5B4\uAC14\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878948
    m_Localized: "\uC5B8\uC81C \uD314 \uAC70\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878949
    m_Localized: "{symbol} \uC9C0\uAE08 \uD0C0\uB3C4 \uB418\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878950
    m_Localized: "\uBB50 \uBCF4\uACE0 \uC0C0\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878951
    m_Localized: "\uB354 \uAC04\uB2E4\uACE0 \uBCF4\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878952
    m_Localized: "\uBE44\uC911 \uC5BC\uB9C8\uB098 \uC2E4\uC5C8\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878953
    m_Localized: "\uC5B8\uC81C\uBD80\uD130 \uB4E4\uACE0 \uC788\uC5C8\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878954
    m_Localized: "\uC5B4\uB514\uAE4C\uC9C0 \uBCFC \uAC70\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878955
    m_Localized: "\uACE0\uC0DD \uB9CE\uC73C\uC168\uC2B5\uB2C8\uB2E4. \uC624\uB298\uC740
      \uC870\uAE08 \uC26C\uC5B4 \uAC00\uC2DC\uC9C0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878956
    m_Localized: "\uB204\uAD6C\uC5D0\uAC8C\uB098 \uC788\uB294 \uC77C\uC785\uB2C8\uB2E4.
      \uB108\uBB34 \uC790\uCC45\uD558\uC9C0 \uB9C8\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878957
    m_Localized: "\uC131\uD22C \uAE30\uC6D0\uD569\uB2C8\uB2E4! \uB2E4\uC74C\uC5D0\uB294
      \uC88B\uC740 \uACB0\uACFC \uC788\uC73C\uC2E4 \uAC81\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878958
    m_Localized: "\uC190\uC808\uB3C4 \uACB0\uB2E8\uC785\uB2C8\uB2E4. \uC798\uD558\uC2E0
      \uAC81\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878959
    m_Localized: "\uC2DC\uC7A5\uC740 \uB0B4\uC77C\uB3C4 \uC5F4\uB9BD\uB2C8\uB2E4.
      \uAE30\uC6B4 \uB0B4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878960
    m_Localized: "\uD558... \uB9C8\uC74C\uC774 \uBB34\uAC70\uC6B0\uC2DC\uACA0\uC2B5\uB2C8\uB2E4.
      \uD798\uB0B4\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878961
    m_Localized: "\uC800\uB3C4 \uAC19\uC740 \uACBD\uD5D8\uC774 \uC788\uC2B5\uB2C8\uB2E4.
      \uC9C0\uB098\uAC00\uB354\uAD70\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878962
    m_Localized: "\uC131\uD22C\uD558\uC138\uC694! \uC9C0\uAE08\uC740 \uBA58\uD0C8\uC744
      \uCC59\uAE30\uC2E4 \uB54C\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878963
    m_Localized: "\uD558... \uACE0\uC0DD\uD588\uC5B4\uC694 \uC9C4\uC9DC."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878964
    m_Localized: "\uB204\uAD6C\uB098 \uD55C \uBC88\uC740 \uACAA\uC5B4\uC694. \uAD1C\uCC2E\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878965
    m_Localized: "\uC131\uD22C\uD558\uC138\uC694! \uB2E4\uC74C\uC5D4 \uC6C3\uC744
      \uAC70\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878966
    m_Localized: "\uC624\uB298\uC740 \uACC4\uC88C \uADF8\uB9CC \uBCF4\uACE0 \uC26C\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878967
    m_Localized: "\uC190\uC808\uB3C4 \uC2E4\uB825\uC774\uC5D0\uC694. \uC798 \uB04A\uC5C8\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878968
    m_Localized: "\uC800\uB3C4 \uADF8\uB7AC\uC5B4\uC694. \uC9C0\uB098\uAC00\uB354\uB77C\uACE0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878969
    m_Localized: "\uBC25\uC740 \uCC59\uACA8 \uBA39\uACE0 \uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878970
    m_Localized: "\uD798\uB0B4\uC694. \uC2DC\uC7A5\uC740 \uB0B4\uC77C\uB3C4 \uC5F4\uB824\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878971
    m_Localized: "\uD558... \uACE0\uC0DD\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878972
    m_Localized: "\uB204\uAD6C\uB098 \uBB3C\uB9B0\uB2E4. \uAD1C\uCC2E\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878973
    m_Localized: "\uC131\uD22C\uD574\uB77C. \uB2E4\uC74C\uC5D4 \uBC88\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878974
    m_Localized: "\uC624\uB298\uC740 \uACC4\uC88C \uB2EB\uACE0 \uC26C\uC5B4\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878975
    m_Localized: "\uC190\uC808\uB3C4 \uC2E4\uB825\uC774\uB2E4. \uC798 \uB04A\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878976
    m_Localized: "\uB098\uB3C4 \uADF8\uB7AC\uB2E4. \uC9C0\uB098\uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878977
    m_Localized: "\uBC25\uC774\uB098 \uBA39\uACE0 \uD574\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878978
    m_Localized: "\uD798\uB0B4\uB77C. \uB0B4\uC77C\uB3C4 \uC7A5\uC740 \uC5F4\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878979
    m_Localized: "\uADF8 \uAC00\uACA9\uC5D0 \uC0AC\uC2E0 \uC774\uC720\uAC00 \uC800\uB294
      \uC798 \uC774\uD574\uB418\uC9C0 \uC54A\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878980
    m_Localized: "\uC9C0\uB09C\uBC88\uC5D0\uB294 \uD655\uC2E0\uD558\uC2E0\uB2E4\uACE0
      \uD558\uC9C0 \uC54A\uC73C\uC168\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878981
    m_Localized: "\uD558... \uC608\uC0C1\uD558\uB358 \uACB0\uACFC\uC774\uAE34 \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878982
    m_Localized: "\uBC84\uD2F0\uBA74 \uB41C\uB2E4\uACE0 \uD558\uC168\uB358 \uAC78\uB85C
      \uAE30\uC5B5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878983
    m_Localized: "?? \uC544\uC9C1\uB3C4 \uBCF4\uC720 \uC911\uC774\uC168\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878984
    m_Localized: "\uC190\uC2E4\uBCF4\uB2E4 \uADF8 \uC790\uC2E0\uAC10\uC774 \uB354
      \uB180\uB78D\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878985
    m_Localized: "\uBB3C\uC744 \uB354 \uD0C0\uC2DC\uBA74 \uC8FC\uC8FC\uCD1D\uD68C\uC5D0
      \uAC00\uC154\uC57C\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878986
    m_Localized: "\uC81C\uAC00 \uADF8\uB54C \uB9D0\uC500\uB4DC\uB9AC\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878987
    m_Localized: "\uADF8\uB7EC\uAC8C \uB204\uAC00 \uADF8 \uAC00\uACA9\uC5D0 \uC0AC\uB798\uC694
      \u314E\u314E"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878988
    m_Localized: "\uC9C0\uB09C\uBC88\uC5D4 \uAC04\uB2E4\uACE0 \uD558\uC168\uC796\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878989
    m_Localized: "\uD558... \uB610 \uBB3C\uB838\uC5B4\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878990
    m_Localized: "\uBC84\uD2F0\uBA74 \uB41C\uB2E4\uBA74\uC11C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878991
    m_Localized: "?? \uADF8\uAC78 \uC544\uC9C1\uB3C4 \uB4E4\uACE0 \uC788\uC5C8\uC5B4\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878992
    m_Localized: "\uAD6C\uC870\uB300\uB294 \uC548 \uC62C \uAC83 \uAC19\uC740\uB370\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878993
    m_Localized: "\uC5B4\uC81C\uC758 \uC790\uC2E0\uAC10\uC740 \uC5B4\uB514 \uAC14\uC5B4\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878994
    m_Localized: "\uC81C\uAC00 \uBB50\uB7AC\uC5B4\uC694 \u314E\u314E"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878995
    m_Localized: "\uADF8\uB7EC\uAC8C \uB204\uAC00 \uACE0\uC810\uC5D0 \uC0AC\uB7AC\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878996
    m_Localized: "\uC9C0\uB09C\uBC88\uC5D4 \uAC04\uB2E4\uBA70."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878997
    m_Localized: "\uD558... \uB610 \uBB3C\uB838\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878998
    m_Localized: "\uC874\uBC84\uAC00 \uB2F5\uC774\uB77C\uBA70."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836878999
    m_Localized: "?? \uC544\uC9C1\uB3C4 \uB4E4\uACE0 \uC788\uC5C8\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879000
    m_Localized: "\uAD6C\uC870\uB300\uB294 \uC548 \uC628\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879001
    m_Localized: "\uC5B4\uC81C \uC790\uC2E0\uAC10\uC740 \uC5B4\uB514 \uAC14\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879002
    m_Localized: "\uB0B4\uAC00 \uBB50\uB7AC\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879003
    m_Localized: "\uC800\uB3C4 \uAC19\uC740 \uC0DD\uAC01\uC744 \uD558\uACE0 \uC788\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879004
    m_Localized: "\uB9D0\uC500\uB300\uB85C \uC800\uB3C4 \uACC4\uC18D \uC9C0\uCF1C\uBCF4\uB294
      \uC911\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879005
    m_Localized: "\uACF5\uAC10\uD569\uB2C8\uB2E4. \uB208\uC744 \uB5BC\uAE30\uAC00
      \uC5B4\uB835\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879006
    m_Localized: "\uC800\uB9CC \uADF8\uB7F0 \uAC8C \uC544\uB2C8\uC5C8\uAD70\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879007
    m_Localized: "\uB3D9\uAC10\uC785\uB2C8\uB2E4. \uC870\uAE08 \uB354 \uBCF4\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879008
    m_Localized: "\uADF8 \uB9C8\uC74C \uC774\uD574\uD569\uB2C8\uB2E4. \uC800\uB3C4
      \uADF8\uB807\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879009
    m_Localized: "\uB9DE\uB294 \uB9D0\uC500\uC785\uB2C8\uB2E4. \uC624\uB298\uC740
      \uBD84\uC704\uAE30\uAC00 \uB2E4\uB974\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879010
    m_Localized: "\uC800\uB3C4 {symbol} \uD654\uBA74\uC744 \uB2EB\uC9C0 \uBABB\uD558\uACE0
      \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879011
    m_Localized: "\uC800\uB3C4 \uADF8 \uC0DD\uAC01 \uD588\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879012
    m_Localized: "\uADF8\uB7EC\uB2C8\uAE4C\uC694. \uC800\uB3C4 \uACC4\uC18D \uBCF4\uB294
      \uC911\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879013
    m_Localized: "\uB9DE\uC544\uC694. \uB208\uC744 \uBABB \uB5BC\uACA0\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879014
    m_Localized: "\uC800\uB9CC \uADF8\uB7F0 \uAC8C \uC544\uB2C8\uC5C8\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879015
    m_Localized: "\uB3D9\uAC10\uC774\uC5D0\uC694. \uC77C\uB2E8 \uC9C0\uCF1C\uBD10\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879016
    m_Localized: "\uADF8 \uB9C8\uC74C \uC54C\uC544\uC694 \u314E\u314E"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879017
    m_Localized: "\uB9DE\uC544\uC694. \uC624\uB298 \uC880 \uB2E4\uB974\uAE34 \uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879018
    m_Localized: "\uC800\uB3C4 {symbol} \uCC3D \uBABB \uB2EB\uACE0 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879019
    m_Localized: "\uB098\uB3C4 \uADF8 \uC0DD\uAC01 \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879020
    m_Localized: "\uADF8\uB7EC\uB2C8\uAE4C. \uB098\uB3C4 \uACC4\uC18D \uBCF8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879021
    m_Localized: "\uB9DE\uB2E4. \uB208\uC744 \uBABB \uB5BC\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879022
    m_Localized: "\uB098\uB9CC \uADF8\uB7F0 \uAC8C \uC544\uB2C8\uC5C8\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879023
    m_Localized: "\uB3D9\uAC10. \uC77C\uB2E8 \uC9C0\uCF1C\uBCF8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879024
    m_Localized: "\uADF8 \uB9C8\uC74C \uC548\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879025
    m_Localized: "\uB9DE\uB2E4. \uC624\uB298 \uC880 \uB2E4\uB974\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879026
    m_Localized: "\uB098\uB3C4 {symbol} \uCC3D \uBABB \uB2EB\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879027
    m_Localized: "{symbol}\uC5D0 \uB4E4\uC5B4\uAC00\uC2E4 \uC0DD\uAC01\uC774\uC2ED\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879028
    m_Localized: "\uC5B4\uB290 \uAC00\uACA9\uB300\uB97C \uBCF4\uACE0 \uACC4\uC2E0\uC9C0
      \uAD81\uAE08\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879029
    m_Localized: "{symbol} \uAD00\uB828\uD574\uC11C \uC0C8\uB85C \uBCF4\uC2E0 \uAC8C
      \uC788\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879030
    m_Localized: "\uC9C0\uAE08 \uC9C4\uC785\uD574\uB3C4 \uB2A6\uC9C0 \uC54A\uB2E4\uACE0
      \uBCF4\uC2ED\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879031
    m_Localized: "\uBCF4\uC720 \uC911\uC774\uC2E0\uAC00\uC694, \uAD00\uCC30\uB9CC
      \uD558\uC2DC\uB294 \uAC74\uAC00\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879032
    m_Localized: "\uC5B4\uB514\uAE4C\uC9C0 \uAC08 \uAC83\uC73C\uB85C \uBCF4\uC2ED\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879033
    m_Localized: "{symbol} \uBD84\uC704\uAE30\uB294 \uC5B4\uB5BB\uAC8C \uB290\uB07C\uC2ED\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879034
    m_Localized: "?? \uD639\uC2DC \uD655\uC778\uD558\uC2E0 \uB0B4\uC6A9\uC774 \uC788\uC73C\uC2E0\uAC00\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879035
    m_Localized: "{symbol} \uB4E4\uC5B4\uAC08 \uAC70\uC608\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879036
    m_Localized: "\uC5BC\uB9C8 \uBCF4\uACE0 \uC788\uC5B4\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879037
    m_Localized: "{symbol} \uBB50 \uB098\uC628 \uAC70 \uC788\uC5B4\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879038
    m_Localized: "\uC9C0\uAE08 \uD0C0\uB3C4 \uC548 \uB2A6\uC5C8\uC744\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879039
    m_Localized: "\uB4E4\uACE0 \uC788\uC5B4\uC694? \uAD6C\uACBD\uB9CC \uD558\uB294
      \uAC70\uC608\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879040
    m_Localized: "\uC5B4\uB514\uAE4C\uC9C0 \uAC08 \uAC83 \uAC19\uC544\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879041
    m_Localized: "{symbol} \uC9C0\uAE08 \uBD84\uC704\uAE30 \uC5B4\uB54C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879042
    m_Localized: "?? \uBB50 \uBCF8 \uAC70 \uC788\uC5B4\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879043
    m_Localized: "{symbol} \uB4E4\uC5B4\uAC08 \uAC70\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879044
    m_Localized: "\uC5BC\uB9C8 \uBCF4\uACE0 \uC788\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879045
    m_Localized: "{symbol} \uBB50 \uB098\uC628 \uAC70 \uC788\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879046
    m_Localized: "\uC9C0\uAE08 \uD0C0\uB3C4 \uB418\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879047
    m_Localized: "\uB4E4\uACE0 \uC788\uB0D0 \uAD6C\uACBD\uB9CC \uD558\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879048
    m_Localized: "\uC5B4\uB514\uAE4C\uC9C0 \uAC04\uB2E4\uACE0 \uBCF4\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879049
    m_Localized: "{symbol} \uC9C0\uAE08 \uBD84\uC704\uAE30 \uC5B4\uB5A0\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879050
    m_Localized: "?? \uBB50 \uBCF8 \uAC70 \uC788\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879051
    m_Localized: "\uC11C\uB450\uB974\uC9C0 \uC54A\uC73C\uC154\uB3C4 \uB429\uB2C8\uB2E4.
      \uAE30\uD68C\uB294 \uB610 \uC635\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879052
    m_Localized: "\uB193\uCE58\uC154\uB3C4 \uAD1C\uCC2E\uC2B5\uB2C8\uB2E4. \uC190\uC2E4\uC740
      \uC544\uB2C8\uB2C8\uAE4C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879053
    m_Localized: "\uC870\uAE09\uD558\uBA74 \uBB3C\uB9AC\uAE30 \uC27D\uC2B5\uB2C8\uB2E4.
      \uCC9C\uCC9C\uD788 \uBCF4\uC2DC\uC9C0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879054
    m_Localized: "\uC131\uD22C\uD558\uC2DC\uB824\uBA74 \uC6B0\uC120 \uB9C8\uC74C\uBD80\uD130
      \uAC00\uB77C\uC549\uD788\uC2DC\uC9C0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879055
    m_Localized: "\uB0A8\uC758 \uC218\uC775\uC5D0 \uD754\uB4E4\uB9AC\uC2E4 \uD544\uC694\uB294
      \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879056
    m_Localized: "\uC9C0\uCF1C\uB9CC \uBCF4\uC2DC\uB294 \uAC83\uB3C4 \uC804\uB7B5\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879057
    m_Localized: "\uD558... \uADF8 \uB9C8\uC74C \uC555\uB2C8\uB2E4. \uADF8\uB798\uB3C4
      \uCC38\uC73C\uC2DC\uC9C0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879058
    m_Localized: "\uC228 \uD55C \uBC88 \uACE0\uB974\uACE0 \uBCF4\uC154\uB3C4 \uB2A6\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879059
    m_Localized: "\uAE09\uD558\uAC8C \uD0C0\uC9C0 \uB9C8\uC694. \uAE30\uD68C\uB294
      \uB610 \uC640\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879060
    m_Localized: "\uB193\uCCD0\uB3C4 \uAD1C\uCC2E\uC544\uC694. \uC190\uD574\uB294
      \uC544\uB2C8\uC796\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879061
    m_Localized: "\uC870\uAE09\uD558\uBA74 \uAF2D \uBB3C\uB9AC\uB354\uB77C\uACE0\uC694.
      \uCC9C\uCC9C\uD788 \uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879062
    m_Localized: "\uC131\uD22C\uD558\uB824\uBA74 \uC77C\uB2E8 \uC9C4\uC815\uBD80\uD130\uC694
      \u314E\u314E"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879063
    m_Localized: "\uB0A8\uB4E4 \uC218\uC775\uC5D0 \uD754\uB4E4\uB9AC\uC9C0 \uB9D0\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879064
    m_Localized: "\uBCF4\uACE0\uB9CC \uC788\uC5B4\uB3C4 \uAD1C\uCC2E\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879065
    m_Localized: "\uD558... \uADF8 \uB9C8\uC74C \uC54C\uC544\uC694. \uADF8\uB798\uB3C4
      \uCC38\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879066
    m_Localized: "\uC228 \uD55C \uBC88 \uC26C\uACE0 \uBD10\uB3C4 \uC548 \uB2A6\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879067
    m_Localized: "\uAE09\uD558\uAC8C \uD0C0\uC9C0 \uB9C8\uB77C. \uAE30\uD68C\uB294
      \uB610 \uC628\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879068
    m_Localized: "\uB193\uCCD0\uB3C4 \uB41C\uB2E4. \uC190\uD574\uB294 \uC544\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879069
    m_Localized: "\uC870\uAE09\uD558\uBA74 \uBB3C\uB9B0\uB2E4. \uCC9C\uCC9C\uD788
      \uD574\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879070
    m_Localized: "\uC131\uD22C\uD558\uB824\uBA74 \uC9C4\uC815\uBD80\uD130 \uD574\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879071
    m_Localized: "\uB0A8 \uC218\uC775\uC5D0 \uD754\uB4E4\uB9AC\uC9C0 \uB9C8\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879072
    m_Localized: "\uBCF4\uACE0\uB9CC \uC788\uC5B4\uB3C4 \uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879073
    m_Localized: "\uD558... \uADF8 \uB9C8\uC74C \uC548\uB2E4. \uCC38\uC544\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879074
    m_Localized: "\uC228 \uC26C\uACE0 \uBD10\uB3C4 \uC548 \uB2A6\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879075
    m_Localized: "\uD558\u2026 \uB098\uB3C4 \uBB3C\uB824 \uC788\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879076
    m_Localized: "\uB098\uB3C4 \uAC19\uC740 \uCC98\uC9C0\uB77C \uD560 \uB9D0\uC774
      \uC5C6\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879077
    m_Localized: "\uB3D9\uC9C0\uC5EC\u2026 \uAC19\uC774 \uBC84\uD2F0\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879078
    m_Localized: "\uB098\uB9CC \uADF8\uB7F0 \uAC8C \uC544\uB2C8\uC5C8\uB124"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879079
    m_Localized: "\uD3C9\uB2E8 \uBCF4\uBA74 \uD55C\uC228\uB9CC \uB098\uC634 \u314B\u314B"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879080
    m_Localized: "\uC624\uB298\uC740 \uB2E4 \uAC19\uC774 \uD798\uB4E0 \uB0A0\uC774\uB124"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879081
    m_Localized: "\uC640 \uCD95\uD558\uD568 \u314B\u314B \uC624\uB298 \uC800\uB141\uC740
      \uC18C\uACE0\uAE30\uB124"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879082
    m_Localized: "\u314A\u314B\u314A\u314B \uC218\uC775\uC740 \uC5B8\uC81C\uB098
      \uC633\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879083
    m_Localized: "\uBD80\uB7FD\uB2E4 \uC9C4\uC9DC\u2026 \uB098\uB3C4 \uC880 \uD0DC\uC6CC\uC8FC\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879084
    m_Localized: "\uCEAC \uC774\uAC8C \uB418\uB124. \uCD95\uD558!"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879085
    m_Localized: "\uC775\uC808\uAE4C\uC9C0 \uBB34\uC0AC\uD788 \uAC00\uC790. \uC131\uD22C!"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879086
    m_Localized: "\uC624 \uB300\uBC15. \uACC4\uC18D \uC131\uD22C\uD558\uC2ED\uC154"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879087
    m_Localized: "\uCD95\uD558\uD574\uC694 \u314B\u314B \uAE30\uC6B4 \uC880 \uB098\uB220\uC918"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879088
    m_Localized: "\uC88B\uACA0\uB2E4\u2026 \uB098\uB294 \uC544\uC9C1 \uAD6C\uACBD\uB9CC
      \uD558\uB294\uB370"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879089
    m_Localized: "\uCD95\uD558 \uCD95\uD558. \uC695\uC2EC\uB9CC \uC870\uC2EC\uD558\uBA74
      \uB428"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879090
    m_Localized: "\uC131\uD22C \uAE30\uC6D0\uD569\uB2C8\uB2E4! \uB05D\uAE4C\uC9C0
      \uC798 \uCC59\uAE30\uAE38"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879091
    m_Localized: "\uC640 \uBD80\uB7FD \u3160 \uB098\uB3C4 {symbol} \uBCFC \uAC78"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879092
    m_Localized: "\u314B\u314B \uC778\uC815. \uC624\uB298\uC740 \uB124\uAC00 \uC8FC\uC778\uACF5"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879093
    m_Localized: "\uC798\uD588\uB124. \uC218\uC775\uC740 \uC9C0\uCF1C\uC57C \uB0B4
      \uB3C8\uC784"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879094
    m_Localized: "\uC624 \uC88B\uB2E4. \uADF8 \uAE30\uC138 \uADF8\uB300\uB85C \uAC00\uC988\uC544"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879095
    m_Localized: "\uC131\uD22C\uD558\uC138\uC694! \uBD80\uB7EC\uC6B0\uBA74 \uC9C0\uB294
      \uAC74\uB370 \uC84C\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879096
    m_Localized: "\uC774\uC57C \uCD95\uD558. \uB098\uB3C4 \uB530\uB77C\uAC00\uACE0
      \uC2F6\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879097
    m_Localized: "\uD558... \uC790\uB791\uD558\uB7EC \uC654\uB0D0"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879098
    m_Localized: "\u314B\u314B \uADF8\uAC70 \uD314\uAE30 \uC804\uC5D4 \uC0AC\uC774\uBC84
      \uBA38\uB2C8\uC784"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879099
    m_Localized: "\uBC30 \uC544\uD504\uB2C8\uAE4C \uADF8\uB9CC \uC62C\uB824\uB77C"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879100
    m_Localized: "\uAE30\uB9CC \uADF8\uB9CC \u314B\u314B"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879101
    m_Localized: "\uC6B4 \uC88B\uC558\uB358 \uAC70 \uC2E4\uB825\uC73C\uB85C \uCC29\uAC01\uD558\uC9C0
      \uB9D0\uACE0"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879102
    m_Localized: "\uADF8\uB798\uBD24\uC790 \uB0B4\uC77C\uC774\uBA74 \uBC18\uB0A9\uD560
      \uB4EF"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879103
    m_Localized: "\uC544\uC9C1 \uC548 \uD314\uC558\uC73C\uBA74 \uBC88 \uAC8C \uC544\uB2C8\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879104
    m_Localized: "\uC62C\uB790\uC744 \uB54C\uB9CC \uB098\uD0C0\uB098\uB294 \uC0AC\uB78C
      \u314B\u314B"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879105
    m_Localized: "\uC218\uC775 \uB0AC\uB2E4\uACE0 \uBAA9\uC18C\uB9AC \uCEE4\uC9C0\uB294
      \uAC70 \uBD10\uB77C"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879106
    m_Localized: "\uC5B4\uCC28\uD53C \uACE0\uC810\uC5D0 \uB610 \uBB3C\uB9B4 \uAC70\uBA74\uC11C"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879107
    m_Localized: "\uC88B\uACA0\uB2E4~ \uD558\uB098\uB3C4 \uC548 \uBD80\uB7EC\uC6C0"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879108
    m_Localized: "\uC790\uB791\uC740 \uC775\uC808\uD558\uACE0 \uD574\uB77C"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879109
    m_Localized: "\uC9C0\uB09C\uBC88 \uBB3C\uB838\uC744 \uB550 \uC870\uC6A9\uD558\uB354\uB2C8
      \u314B\u314B"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879110
    m_Localized: "\uC544 \uB124 \uB300\uB2E8\uD558\uC2ED\uB2C8\uB2E4~"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879111
    m_Localized: "\uD558\u2026 \uB610 \uC2DC\uC791\uC774\uB124"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879112
    m_Localized: "\uADF8 \uC815\uB3C4\uB85C \uC790\uB791\uC774 \uB418\uB098 \u314B\u314B"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879113
    m_Localized: "?? \uC9C4\uC9DC\uC784?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879114
    m_Localized: "\uC778\uC99D \uC5C6\uC73C\uBA74 \uC548 \uBBFF\uC74C \u314B\u314B"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879115
    m_Localized: "\uB9D0\uB85C\uB294 \uB204\uAC00 \uBABB \uBC8C\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879116
    m_Localized: "\uADF8\uAC70 \uD3C9\uB2E8 \uC81C\uB300\uB85C \uBCF8 \uAC70 \uB9DE\uC74C?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879117
    m_Localized: "\uC8FC\uC791 \uC544\uB2C8\uACE0?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879118
    m_Localized: "\uC5B8\uC81C \uC0C0\uAE38\uB798 \uADF8\uAC8C \uB098\uC634?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879119
    m_Localized: "\uD760\u2026 \uD0C0\uC774\uBC0D\uC774 \uB108\uBB34 \uC88B\uC740\uB370"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879120
    m_Localized: "\uC9C4\uC9DC\uBA74 \uB300\uB2E8\uD55C\uB370, \uC9C4\uC9DC\uBA74"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879121
    m_Localized: "\uC5D0\uC774 \uC124\uB9C8 \u314B\u314B"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879122
    m_Localized: "?? \uADF8\uAC8C \uB41C\uB2E4\uACE0?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879123
    m_Localized: "\uD310 \uAC70\uC57C \uC544\uC9C1 \uB4E4\uACE0 \uC788\uB294 \uAC70\uC57C?"
    m_Metadata:
      m_Items: []
  - m_Id: 480603836879124
    m_Localized: "\uC5BC\uB9C8\uC5D0 \uB4E4\uC5B4\uAC14\uC5B4?"
    m_Metadata:
