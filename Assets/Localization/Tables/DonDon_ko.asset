    m_Localized: "\uC8FC\uC2DD \uD3C9\uAC00\uAE08"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087829
    m_Localized: "\uC8FC\uC2DD \uD3C9\uAC00\uC561"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087830
    m_Localized: "\uC8FC\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087831
    m_Localized: "\uC8FC\uC8FC \uC6D0\uC7A5\uC744 \uD655\uC778\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087832
    m_Localized: "\uC900\uBE44"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087833
    m_Localized: "\uC900\uBE44 \uC644\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087834
    m_Localized: "\uC911\uAC04"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087835
    m_Localized: "\uC911\uC7AC\uB97C \uB4E3\uACE0 \uC2A4\uD2B8\uB808\uC2A4\uB85C
      \uB300\uD654 \uC911\uB2E8"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087836
    m_Localized: "\uC989\uC2DC \uBD84\uD560 \uB9E4\uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087837
    m_Localized: "\uC9C0\uAE08 {symbol} \uB530\uB77C\uAC00\uC57C \uD558\uB098 \uACE0\uBBFC\uB3FC\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087838
    m_Localized: "\uC9C0\uAE08 {symbol} \uB530\uB77C\uAC00\uC57C \uD558\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087839
    m_Localized: "\uC9C0\uAE08 {symbol} \uD655\uC2E0\uD560 \uAC8C \uC788\uC74C?"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087840
    m_Localized: "\uC9C0\uAE08 {symbol} \uD655\uC2E0\uD560 \uC218 \uC788\uB294 \uAC8C
      \uC788\uB098\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087841
    m_Localized: "\uC9C0\uAE08 {symbol}\uC744 \uB530\uB77C\uAC00\uC57C \uD560\uC9C0
      \uACE0\uBBFC\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087842
    m_Localized: "\uC9C0\uAE08 \uB108\uBB34 \uC790\uCC45\uD558\uC9C4 \uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087843
    m_Localized: "\uC9C0\uAE08 \uB108\uBB34 \uC790\uCC45\uD558\uC9C4 \uB9C8. \uC11C\uB450\uB974\uC9C0
      \uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087844
    m_Localized: "\uC9C0\uAE08 \uB108\uBB34 \uC790\uCC45\uD558\uC9C4 \uB9C8\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087845
    m_Localized: "\uC9C0\uAE08 \uB108\uBB34 \uC790\uCC45\uD558\uC9C4 \uB9C8\uC138\uC694.
      \uC11C\uB450\uB974\uC9C0 \uB9C8\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087846
    m_Localized: "\uC9C0\uAE08 \uB290\uB080 \uADF8\uB300\uB85C\uC608\uC694. {departedName}\uB2D8
      \uB098\uAC00\uC168\uB124\uC694. \uC800\uB3C4 \uB530\uB77C \uB098\uAC08\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087847
    m_Localized: "\uC9C0\uAE08 \uB290\uB080 \uADF8\uB300\uB85C\uC608\uC694. \uADF8
      \uBC29\uC5D0\uC11C \uCAD3\uACA8\uB0AC\uC5B4\uC694. \uC81C \uACBD\uD5D8\uC740
      \uBCC4\uB85C\uC600\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087848
    m_Localized: "\uC9C0\uAE08 \uB290\uB080 \uADF8\uB300\uB85C\uC608\uC694. \uC2F8\uC6CC\uB3C4
      \uC544\uBB34\uB3C4 \uC548 \uB9D0\uB824\uC11C \uADF8 \uBC29 \uB098\uC654\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087849
    m_Localized: "\uC9C0\uAE08 \uB290\uB080 \uADF8\uB300\uB85C\uC608\uC694. \uC544\uBB34\uB3C4
      \uC548 \uB9D0\uB9AC\uB124\uC694. \uB354\uB294 \uC2F8\uC6B0\uAE30 \uC2EB\uC5B4\uC11C
      \uB098\uAC08\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087850
    m_Localized: "\uC9C0\uAE08 \uB290\uB080 \uADF8\uB300\uB85C\uC608\uC694. \uC774\uB300\uB85C\uBA74
      \uB098\uAC08\uAC8C\uC694. \uB354\uB294 \uCC38\uAE30 \uD798\uB4DC\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087851
    m_Localized: "\uC9C0\uAE08 \uB290\uB080 \uADF8\uB300\uB85C\uC784. {departedName}
      \uB098\uAC14\uB124. \uB098\uB3C4 \uB530\uB77C \uB098\uAC10."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087852
    m_Localized: "\uC9C0\uAE08 \uB290\uB080 \uADF8\uB300\uB85C\uC784. \uADF8 \uBC29\uC5D0\uC11C
      \uCAD3\uACA8\uB0A8. \uB0B4 \uACBD\uD5D8\uC740 \uBCC4\uB85C\uC784."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087853
    m_Localized: "\uC9C0\uAE08 \uB290\uB080 \uADF8\uB300\uB85C\uC784. \uC2F8\uC6CC\uB3C4
      \uC548 \uB9D0\uB9AC\uAE38\uB798 \uADF8 \uBC29 \uB098\uC634."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087854
    m_Localized: "\uC9C0\uAE08 \uB290\uB080 \uADF8\uB300\uB85C\uC784. \uC544\uBB34\uB3C4
      \uC548 \uB9D0\uB9AC\uB124. \uB354\uB294 \uC2F8\uC6B0\uAE30 \uC2EB\uB2E4. \uB098\uAC10."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087855
    m_Localized: "\uC9C0\uAE08 \uB290\uB080 \uADF8\uB300\uB85C\uC784. \uC774\uB300\uB85C\uBA74
      \uB098\uAC10. \uB354\uB294 \uBABB \uCC38\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087856
    m_Localized: "\uC9C0\uAE08 \uB290\uB080 \uADF8\uB300\uB85C\uC785\uB2C8\uB2E4.
      {departedName}\uB2D8\uC774 \uB098\uAC00\uC168\uAD70\uC694. \uC800\uB3C4 \uD568\uAED8
      \uB098\uAC00\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087857
    m_Localized: "\uC9C0\uAE08 \uB290\uB080 \uADF8\uB300\uB85C\uC785\uB2C8\uB2E4.
      \uADF8 \uBC29\uC5D0\uC11C \uCD94\uBC29\uB2F9\uD588\uC2B5\uB2C8\uB2E4. \uC81C
      \uACBD\uD5D8\uC740 \uC88B\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087858
    m_Localized: "\uC9C0\uAE08 \uB290\uB080 \uADF8\uB300\uB85C\uC785\uB2C8\uB2E4.
      \uC2F8\uC6C0\uC744 \uB9D0\uB9AC\uC9C0 \uC54A\uC544 \uADF8 \uBC29\uC5D0\uC11C
      \uB098\uC654\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087859
    m_Localized: "\uC9C0\uAE08 \uB290\uB080 \uADF8\uB300\uB85C\uC785\uB2C8\uB2E4.
      \uC544\uBB34\uB3C4 \uB9D0\uB9AC\uC9C0 \uC54A\uB294\uAD70\uC694. \uC774 \uC2F8\uC6C0\uC744
      \uB354 \uACAC\uB514\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4. \uB098\uAC11\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087860
    m_Localized: "\uC9C0\uAE08 \uB290\uB080 \uADF8\uB300\uB85C\uC785\uB2C8\uB2E4.
      \uC774\uB300\uB85C\uB77C\uBA74 \uBC29\uC744 \uB098\uAC00\uACA0\uC2B5\uB2C8\uB2E4.
      \uB354\uB294 \uCC38\uAE30 \uC5B4\uB835\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087861
    m_Localized: "\uC9C0\uAE08 \uB4E4\uC5B4\uC654\uB294\uB370 \uB2E4\uB4E4 \uBB50
      \uBCF4\uACE0 \uC788\uC5B4\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087862
    m_Localized: "\uC9C0\uAE08 \uBC14\uB85C \uB9CC\uD68C\uD574\uC57C \uD55C\uB2E4\uACE0
      \uC0DD\uAC01\uD558\uBA74 \uB354 \uD53C\uACE4\uD568"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087863
    m_Localized: "\uC9C0\uAE08 \uBCF4\uC774\uB294 \uC815\uBCF4\uB9CC\uC73C\uB85C\uB294
      \uB2E8\uC815\uD558\uAE30 \uC5B4\uB835\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087864
    m_Localized: "\uC9C0\uAE08 \uC6C3\uC73C\uBA74\uC11C \uB118\uAE38 \uAE30\uBD84\uC740
      \uC544\uB2D8"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087865
    m_Localized: "\uC9C0\uAE08 \uC790\uC2E0\uC744 \uB108\uBB34 \uBAB0\uC544\uC138\uC6B0\uC9C0
      \uC54A\uC73C\uC168\uC73C\uBA74 \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087866
    m_Localized: "\uC9C0\uAE08 \uC790\uC2E0\uC744 \uB108\uBB34 \uBAB0\uC544\uC138\uC6B0\uC9C0
      \uC54A\uC73C\uC168\uC73C\uBA74 \uD569\uB2C8\uB2E4. \uC11C\uB450\uB974\uC9C0
      \uB9C8\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087867
    m_Localized: "\uC9C0\uAE08\uC740 \uC11C\uB450\uB974\uC9C0 \uC54A\uACE0 \uBCF4\uB294
      \uC911."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087868
    m_Localized: "\uC9C0\uAE08\uC740 \uC774 \uCC38\uC5EC\uC790\uB97C \uCD08\uB300\uD560
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087869
    m_Localized: "\uC9C0\uAE08\uC740 \uC815\uC2E0\uC744 \uCC28\uB9AC\uC154\uC57C\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087870
    m_Localized: "\uC9C0\uAE08\uC740 \uC815\uC2E0\uC744 \uCC28\uB9AC\uC154\uC57C\uACA0\uC2B5\uB2C8\uB2E4.
      \uB9D0\uC500\uC744 \uAC00\uB824 \uC8FC\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087871
    m_Localized: "\uC9C0\uB09C\uB2EC\uC5D0"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087872
    m_Localized: "\uC9C0\uBC30\uAD6C\uC870 \uC774\uC288\uB294 \uB300\uC8FC\uC8FC,
      \uC18C\uC561\uC8FC\uC8FC, \uC784\uC9C1\uC6D0\uC774 \uC11C\uB85C \uB2E4\uB978
      \uC774\uD574\uAD00\uACC4\uB97C \uAC16\uB294 \uC601\uC5ED\uC774\uB2E4. \uAC19\uC740
      \uACB0\uC815\uC744 \uB204\uAD70\uAC00\uB294 \uC548\uC815\uC73C\uB85C, \uB2E4\uB978
      \uB204\uAD70\uAC00\uB294 \uAD8C\uD55C \uC9D1\uC911\uC73C\uB85C \uBCFC \uC218
      \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087873
    m_Localized: "\uC9C0\uBD84 \uB9E4\uC785"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087874
    m_Localized: "\uC9C0\uBD84 \uB9E4\uC785\uC5D0 \uC4F8 \uAC00\uC6A9 \uD604\uAE08\uC774
      \uBD80\uC871\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087875
    m_Localized: "\uC9C0\uC18D\uC801\uC778 \uBCC0\uD654\uC778\uC9C0 \uB2E8\uAE30
      \uCEA0\uD398\uC778\uC778\uC9C0 \uD6C4\uC18D \uC790\uB8CC\uB97C \uC0B4\uD3B4\uBD10\uC57C
      \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087876
    m_Localized: "\uC9C0\uC2DC"
    m_Metadata:
      m_Items: []
