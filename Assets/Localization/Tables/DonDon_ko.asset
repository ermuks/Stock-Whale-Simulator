    m_Localized: "\uC8FC\uBB38 \uAC00\uB2A5 \uD604\uAE08\uC774 "
    m_Metadata:
      m_Items: []
  - m_Id: 1392087808
    m_Localized: "\uC8FC\uBB38 \uAC80\uD1A0 \u2192 \uD0DC\uBE14\uB9BF \uD655\uC778
      \u2192 \uC9C1\uC811 \uC81C\uCD9C"
    m_Metadata:
      m_Items: []
