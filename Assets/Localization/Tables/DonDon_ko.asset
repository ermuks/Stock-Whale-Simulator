    m_Metadata:
      m_Items: []
  - m_Id: 1392087452
    m_Localized: "\uC778\uD130\uB137 \uBA40\uCA61\uD55C\uB370 \uAD1C\uD788 \uC5F0\uACB0
      \uD655\uC778\uD574 \uBD04."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087453
    m_Localized: "\uC77C \xB7 "
    m_Metadata:
      m_Items: []
  - m_Id: 1392087454
    m_Localized: "\uC77C\uB2E8 \uAD00\uB9DD."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087455
    m_Localized: "\uC77C\uB2E8 \uADF8 \uC598\uAE34 \uB3D9\uC758 \u314B\u314B"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087456
    m_Localized: "\uC77C\uB2E8 \uB0B4 \uAE30\uC900\uB3C4 \uB2E4\uC2DC \uC0B4\uD3B4\uBD10\uC57C\uACA0\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087457
    m_Localized: "\uC77C\uB2E8 \uBB3C \uD55C \uC794 \uB9C8\uC154. \uC9C0\uAE08 \uB108\uBB34
      \uBAB0\uC544\uBD99\uC774\uC9C0 \uB9D0\uACE0"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087458
    m_Localized: "\uC77C\uB2E8 \uC11C\uB85C \uB9D0 \uB04A\uC9C0 \uB9D0\uACE0 \uADFC\uAC70\uBD80\uD130
      \uBCF4\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087459
    m_Localized: "\uC77C\uB2E8 \uC598\uAE30\uB294 \uB4E4\uC5C8\uC74C. \uB09C \uC880
      \uB354 \uBCFC\uB798"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087460
    m_Localized: "\uC77C\uC2DC\uC801\uC778 \uD654\uC81C\uC131\uC778\uC9C0 \uC2E4\uC81C
      \uACE0\uAC1D \uAD00\uACC4\uAC00 \uBC14\uB00C\uB294 \uAC83\uC778\uC9C0 \uC9C0\uCF1C\uBCFC
      \uD544\uC694\uAC00 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087461
    m_Localized: "\uC77C\uC2DC\uC815\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087462
    m_Localized: "\uC77C\uC77C \uC131\uC801 \uC190\uC2E4. \uC9C0\uAE08\uC740 \uC880
      \uC26C\uC5B4\uC57C\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087463
    m_Localized: "\uC77C\uC77C \uC131\uC801\uC740 \uC218\uC775\uC774\uB2E4. \uB0B4\uC77C\uB3C4
      \uCC28\uBD84\uD558\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087464
    m_Localized: "\uC77C\uD68C\uC131 \uC131\uACFC\uC778\uC9C0 \uBC18\uBCF5 \uAC00\uB2A5\uD55C
      \uC218\uC775\uC778\uC9C0\uAC00 \uB2E4\uC74C \uD310\uB2E8\uC758 \uAE30\uC900\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087465
    m_Localized: "\uC784\uAE08"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087466
    m_Localized: "\uC784\uC0C1"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087467
    m_Localized: "\uC785\uB825\uAC12\uC744 \uD655\uC778\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087468
    m_Localized: "\uC790\uAE08"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087469
    m_Localized: "\uC790\uAE08 \uC870\uB2EC\uC740 \uC131\uC7A5 \uAE30\uD68C\uAC00
      \uB420 \uC218\uB3C4, \uAE30\uC874 \uC8FC\uC8FC\uC758 \uBD80\uB2F4\uC774 \uB420
      \uC218\uB3C4 \uC788\uB2E4. \uAE08\uC561\uBFD0 \uC544\uB2C8\uB77C \uC870\uAC74\uACFC
      \uC0AC\uC6A9 \uBAA9\uC801\uC774 \uC911\uC694\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087470
    m_Localized: "\uC790\uAE08\uC758 \uB9CC\uAE30\uC640 \uC870\uB2EC \uC870\uAC74,
      \uAE30\uC874 \uC8FC\uC8FC \uBD80\uB2F4\uC744 \uCD94\uAC00 \uC790\uB8CC\uC5D0\uC11C
      \uD655\uC778\uD560 \uD544\uC694\uAC00 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087471
    m_Localized: "\uC790\uB3D9 \uC6B4\uC6A9"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087472
    m_Localized: "\uC790\uB8CC\uB97C \uC218\uC9D1 \uC911\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087473
    m_Localized: "\uC790\uB9AC \uBE44\uC5C8\uB2E4\uACE0 \uD574\uC11C \uB4E4\uC5B4\uC654\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087474
    m_Localized: "\uC790\uBE44 \uBC30\uB2F9"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087475
    m_Localized: "\uC790\uC0B0 \xB7 \uD638\uAC00 \uB300\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087476
    m_Localized: "\uC790\uC0B0\xB7\uC9C0\uBD84\xB7\uBBF8\uCCB4\uACB0\xB7\uC6B4\uC6A9\xB7\uB9AC\uB529\uBC29\xB7\uD3C9\uD310
      \uAD00\uCC30 "
    m_Metadata:
      m_Items: []
  - m_Id: 1392087477
    m_Localized: "\uC790\uCC45\uB9CC \uD558\uBA74 \uB354 \uAF2C\uC784. \uC7A0\uAE50
      \uC26C\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087478
    m_Localized: "\uC791\uC5C5 \uBB3C\uB7C9 \uD68C\uC218 \uC644\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087479
    m_Localized: "\uC791\uC5C5 \uC7A5\uCE58 \uC911\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087480
    m_Localized: "\uC791\uC5C5 \uC885\uB8CC \uD6C4 \uB2E4\uC74C \uC608\uC0B0\uC744
      \uBCC0\uACBD\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087481
    m_Localized: "\uC794\uACE0 \uD655\uC778 \uC911"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087482
    m_Localized: "\uC794\uACE0\uB97C \uBD88\uB7EC\uC624\uB294 \uC911\uC785\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087483
    m_Localized: "\uC794\uB7C9 / \uCCB4\uACB0"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087484
    m_Localized: "\uC7A0\uACA8"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087485
    m_Localized: "\uC7A0\uAE50 \uB208 \uC880 \uC26C\uC5B4\uC57C\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087486
    m_Localized: "\uC7A0\uAE50 \uB208 \uC880 \uC26C\uC5B4\uC57C\uACA0\uB2E4. \uCC28\uD2B8\uAC00
      \uB208\uC5D0 \uBD99\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087487
    m_Localized: "\uC7A0\uAE50 \uB4E4\uB800\uC5B4\uC694. \uC5B4\uB5A4 \uC598\uAE30
      \uC911\uC778\uAC00\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087488
    m_Localized: "\uC7A0\uAE50 \uC26C\uC5C8\uB2E4 \uBCFC\uAE4C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087489
    m_Localized: "\uC7A0\uAE50 \uC2A4\uD2B8\uB808\uCE6D \uD558\uACE0 \uC640\uC57C\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087490
    m_Localized: "\uC7A0\uAE50 \uCC3D\uBB38 \uC5F4\uACE0 \uBC14\uB78C \uC880 \uC42C\uACE0
      \uC634."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087491
    m_Localized: "\uC7A0\uAE50 \uD654\uBA74 \uB36E\uACE0 \uC0DD\uAC01 \uC815\uB9AC\uD558\uB294
      \uC911."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087492
    m_Localized: "\uC7A0\uAE50, {symbol} \uB098\uB9CC \uB193\uCE58\uB294 \uAC70 \uC544\uB2D8?
      \uACC4\uC18D \uC2E0\uACBD \uC4F0\uC774\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087493
    m_Localized: "\uC7A0\uAE50, {symbol} \uB2E4\uC2DC \uD655\uC778\uD558\uB294 \uC911\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087494
    m_Localized: "\uC7A0\uAE50, {symbol} \uC5B4\uB5BB\uAC8C \uBCF4\uACE0 \uC788\uC74C?"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087495
    m_Localized: "\uC7A0\uAE50, {symbol}\uC744 \uB2E4\uC2DC \uD655\uC778\uD574 \uBCF4\uACE0
      \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087496
    m_Localized: "\uC7A0\uAE50\uB9CC\uC694, {symbol}\uC740 \uC5B4\uB5BB\uAC8C \uBCF4\uACE0
      \uACC4\uC2E0\uAC00\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087497
    m_Localized: "\uC7A0\uAE50\uB9CC\uC694, {symbol}\uC744 \uB193\uCE58\uB294 \uAC74
      \uC544\uB2CC\uC9C0 \uC790\uAFB8 \uC0DD\uAC01\uD558\uAC8C \uB418\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087498
    m_Localized: "\uC7A0\uC2DC \uD654\uBA74\uC5D0\uC11C \uB208\uC744 \uB5BC\uB294
      \uAC83\uB3C4 \uAD1C\uCC2E\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087499
    m_Localized: "\uC7A0\uC2DC \uD654\uBA74\uC5D0\uC11C \uB208\uC744 \uB5BC\uB294
      \uAC83\uB3C4 \uAD1C\uCC2E\uACA0\uC2B5\uB2C8\uB2E4. \uC11C\uB450\uB974\uC9C0
      \uB9C8\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087500
    m_Localized: "\uC7A5"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087501
    m_Localized: "\uC7A5 \uB05D\uB098\uACE0 \uBCF4\uB2C8\uAE4C \uB610 \uB2E4\uB978
      \uC0DD\uAC01\uC774 \uB4DC\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087502
    m_Localized: "\uC7A5 \uB9C8\uAC10 \uC815\uC0B0 "
    m_Metadata:
      m_Items: []
  - m_Id: 1392087503
    m_Localized: "\uC7A5 \uB9C8\uAC10 \uD68C\uC0AC \uC218\uC775 +"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087504
    m_Localized: "\uC7A5 \uBCF4\uBA74\uC11C \uACFC\uC790 \uBA39\uC73C\uB2C8\uAE4C
      \uB05D\uB3C4 \uC5C6\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087505
    m_Localized: "\uC7A5 \uC5F4\uB838\uB124. \uC624\uB298\uB3C4 \uCC9C\uCC9C\uD788
      \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087506
    m_Localized: "\uC7A5 \uC885\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087507
    m_Localized: "\uC7A5\uAE30 \uC8FC\uC8FC\uB294 \uD22C\uC790 \uC5EC\uB825\uC744,
      \uB2E8\uAE30 \uB9E4\uB9E4\uC790\uB294 \uAC00\uAE4C\uC6B4 \uCCB4\uACB0 \uD750\uB984\uC744
      \uB354 \uC911\uC2DC\uD560 \uC218 \uC788\uB2E4. \uC591\uCABD\uC774 \uAC19\uC740
      \uC22B\uC790\uB97C \uBCF4\uACE0\uB3C4 \uB2E4\uB974\uAC8C \uC6C0\uC9C1\uC77C
      \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087508
    m_Localized: "\uC7A5\uAE30 \uC9C0\uC9C0\uC790\uB3C4 \uB9D0\uACFC \uD589\uB3D9\uC774
      \uBC18\uBCF5\uD574\uC11C \uB2E4\uB974\uBA74 \uC2E0\uB8B0\uB97C \uAC70\uB458
      \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087509
    m_Localized: "\uC7A5\uBD80 \uAC00\uCE58"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087510
    m_Localized: "\uC7A5\uC678"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087511
    m_Localized: "\uC7A5\uC774 \uB2EB\uD788\uB2C8\uAE4C \uC880 \uC870\uC6A9\uD574\uC84C\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087512
    m_Localized: "\uC7AC\uACE0 \uBCF4\uD638 \uCDE8\uC18C"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087513
    m_Localized: "\uC7AC\uD65C\uC6A9"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087514
    m_Localized: "\uC7AC\uD68C\uC720: \uC774\uC804 \uC190\uC2E4 \uAE30\uC5B5 \uD65C\uC131\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087515
    m_Localized: "\uC800\uAC00:"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087516
    m_Localized: "\uC800\uB141 \uBA39\uC744 \uD0C0\uC774\uBC0D\uC744 \uB193\uCCE4\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087517
    m_Localized: "\uC800\uB294 {symbol} {price}\uC6D0 \uBD80\uADFC\uC758 \uCCB4\uACB0\uC744
      \uBCF4\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087518
    m_Localized: "\uC800\uB294 {symbol} {price}\uC6D0 \uBD80\uADFC\uC758 \uCCB4\uACB0\uC744
      \uBCF4\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uC81C \uAE30\uC900\uC740 \uADF8\uB807\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087519
    m_Localized: "\uC800\uB294 {symbol} {price}\uC6D0 \uCCB4\uACB0 \uBCF4\uACE0 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087520
    m_Localized: "\uC800\uB294 {symbol} {price}\uC6D0 \uCCB4\uACB0 \uBCF4\uACE0 \uC788\uC5B4\uC694.
      \uC81C \uAE30\uC900\uC740 \uADF8\uB798\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087521
    m_Localized: "\uC800\uB294 {symbol} \uB9AC\uB529\uC5D0\uC11C {pct}% \uC190\uC2E4\uC744
      \uACAA\uC5C8\uC2B5\uB2C8\uB2E4. \uB2E4\uB978 \uACBD\uC6B0\uB3C4 \uC788\uC744
      \uAC83\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087522
    m_Localized: "\uC800\uB294 {symbol} \uB9AC\uB529\uC5D0\uC11C {pct}% \uC190\uC2E4\uC744
      \uACAA\uC5C8\uC2B5\uB2C8\uB2E4. \uB2E4\uB978 \uACBD\uC6B0\uB3C4 \uC788\uC744
      \uAC83\uC785\uB2C8\uB2E4. \uC2E0\uC911\uD788 \uBCF4\uC168\uC73C\uBA74 \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087523
    m_Localized: "\uC800\uB294 {symbol} \uB9AC\uB529\uC5D0\uC11C {pct}% \uC218\uC775
      \uBD24\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087524
    m_Localized: "\uC800\uB294 {symbol} \uB9AC\uB529\uC5D0\uC11C {pct}% \uC218\uC775
      \uBD24\uC5B4\uC694. \uACE0\uB9C8\uC6CC\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087525
    m_Localized: "\uC800\uB294 {symbol} \uB9AC\uB529\uC5D0\uC11C {pct}% \uC218\uC775\uC744
      \uACBD\uD5D8\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087526
    m_Localized: "\uC800\uB294 {symbol} \uB9AC\uB529\uC5D0\uC11C {pct}% \uC218\uC775\uC744
      \uACBD\uD5D8\uD588\uC2B5\uB2C8\uB2E4. \uAC10\uC0AC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087527
    m_Localized: "\uC800\uB294 {symbol}\uC744 \uC870\uAE08 \uB354 \uC9C0\uCF1C\uBCF4\uACE0
      \uC2F6\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087528
    m_Localized: "\uC800\uB294 \uB2E4\uB978 \uACF3\uC5D0\uC11C \uC2DC\uC7A5\uC744
      \uBCF4\uACA0\uC2B5\uB2C8\uB2E4. \uC774\uB9CC \uB098\uAC00\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087529
    m_Localized: "\uC800\uB294 \uB2E4\uB978 \uACF3\uC5D0\uC11C \uC2DC\uC7A5\uC744
      \uBCF4\uACA0\uC2B5\uB2C8\uB2E4. \uC774\uB9CC \uB098\uAC00\uACA0\uC2B5\uB2C8\uB2E4.
      \uC774\uB9CC \uB5A0\uB098\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087530
    m_Localized: "\uC800\uB294 \uC5EC\uAE30\uC11C \uADF8\uB9CC \uC598\uAE30\uD560\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087531
    m_Localized: "\uC800\uB294 \uC5EC\uAE30\uC11C \uADF8\uB9CC \uC598\uAE30\uD560\uAC8C\uC694.
      \uC774\uB9CC \uAC08\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087532
    m_Localized: "\uC800\uB294 \uC5EC\uAE30\uC11C \uB300\uD654\uB97C \uB9C8\uCE58\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087533
    m_Localized: "\uC800\uB294 \uC5EC\uAE30\uC11C \uB300\uD654\uB97C \uB9C8\uCE58\uACA0\uC2B5\uB2C8\uB2E4.
      \uC774\uB9CC \uB5A0\uB098\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087534
    m_Localized: "\uC800\uB294 \uC774\uBBF8 \uD55C \uBC88 \uCD94\uBC29\uC744 \uACBD\uD5D8\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087535
    m_Localized: "\uC800\uB294 \uD655\uC2E0\uC758 \uD06C\uAE30\uBCF4\uB2E4 \uD655\uC778
      \uAC00\uB2A5\uD55C \uC790\uB8CC\uB97C \uBCF4\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087536
    m_Localized: "\uC800\uB294 \uD655\uC2E0\uC758 \uD06C\uAE30\uBCF4\uB2E4 \uD655\uC778
      \uAC00\uB2A5\uD55C \uC790\uB8CC\uB97C \uBCF4\uACA0\uC2B5\uB2C8\uB2E4. \uC800\uB294
      \uB2E4\uB974\uAC8C \uC0DD\uAC01\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087537
    m_Localized: "\uC800\uB3C4 \uADF8 \uC810\uC774 \uAD81\uAE08\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087538
    m_Localized: "\uC800\uB3C4 \uADF8\uAC8C \uAD81\uAE08\uD588\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087539
    m_Localized: "\uC800\uB3C4 \uC544\uC9C1 \uB2F5\uC744 \uBABB \uC815\uD588\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087540
    m_Localized: "\uC800\uB3C4 \uC544\uC9C1 \uB2F5\uC744 \uC815\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087541
    m_Localized: "\uC800\uBC88\uC5D0"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087542
    m_Localized: "\uC800\uC640 {memWhen} \uC5B8\uC7C1\uD558\uC2E0 \uB4A4\uB85C \uB2EC\uB77C\uC9C4
      \uAC8C \uC788\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087543
    m_Localized: "\uC801\uB300"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087544
    m_Localized: "\uC801\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087545
    m_Localized: "\uC804 {symbol} \uB9AC\uB529\uC5D0\uC11C {pct}% \uC190\uC2E4 \uBD24\uC5B4\uC694.
      \uB2E4\uB4E4 \uAC19\uC9C4 \uC54A\uACA0\uC9C0\uB9CC\uC694."
    m_Metadata:
