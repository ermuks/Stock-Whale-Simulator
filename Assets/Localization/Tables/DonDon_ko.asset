    m_Localized: "\uC9C4\uC9DC\uB85C\uC694. \uBC29\uC7A5\uB2D8 \uB355\uC5D0 {symbol}
      \uC2E4\uC81C {pct}% \uC218\uC775 \uB0AC\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392088068
    m_Localized: "\uC9C4\uC9DC\uB85C\uC694. \uBC29\uC7A5\uB2D8 \uC9C0\uAE08 \uC774
      \uB300\uD654 \uBCF4\uACE0 \uACC4\uC138\uC694?"
