      m_Items: []
  - m_Id: 1383699762
    m_Localized: "\uAE08\uC9C0\uB294 \uD480\uB838\uC9C0\uB9CC \uAE30\uC5B5\uC740
      \uB0A8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699763
    m_Localized: "\uAE09\uD558\uAC8C \uB9CC\uD68C\uD558\uB824 \uD558\uC9C0 \uC54A\uC73C\uC154\uB3C4
      \uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699764
    m_Localized: "\uAE09\uD558\uAC8C \uB9CC\uD68C\uD558\uB824 \uD558\uC9C0 \uC54A\uC73C\uC154\uB3C4
      \uB429\uB2C8\uB2E4. \uC11C\uB450\uB974\uC9C0 \uB9C8\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699765
    m_Localized: "\uAE09\uD558\uAC8C \uB9CC\uD68C\uD558\uB824\uACE0 \uD558\uC9C4
      \uB9C8\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699766
    m_Localized: "\uAE09\uD558\uAC8C \uB9CC\uD68C\uD558\uB824\uACE0 \uD558\uC9C4
      \uB9C8\uC138\uC694. \uC11C\uB450\uB974\uC9C0 \uB9C8\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699767
    m_Localized: "\uAE09\uD558\uAC8C \uB9CC\uD68C\uD558\uB824\uACE0\uB294 \uD558\uC9C0
      \uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699768
    m_Localized: "\uAE09\uD558\uAC8C \uB9CC\uD68C\uD558\uB824\uACE0\uB294 \uD558\uC9C0
      \uB9C8. \uC11C\uB450\uB974\uC9C0 \uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699769
    m_Localized: "\uAE09\uD55C \uC8FC\uBB38\uC774 \uC788\uC5C8\uB294\uC9C0 \uB2E4\uC2DC
      \uC0B4\uD3B4\uBCF4\uB824\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699770
    m_Localized: "\uAE0D\uC815"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699771
    m_Localized: "\uAE30\uAD00"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699772
    m_Localized: "\uAE30\uAD00 \uB2F4\uB2F9\uC790 (\uC790\uCE6D)"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699773
    m_Localized: "\uAE30\uAD00 \uB2F4\uB2F9\uC790\uB77C\uACE0 \uD569\uB2C8\uB2E4.\n\""
    m_Metadata:
      m_Items: []
  - m_Id: 1383699774
    m_Localized: "\uAE30\uAD00\uACFC \uACE0\uB798\uC758 \uC6C0\uC9C1\uC784\uC744
      \uAE30\uB85D\uD558\uB294 \uC911\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699775
    m_Localized: "\uAE30\uAE30 \uC5F4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699776
    m_Localized: "\uAE30\uAE30 \uC774\uC6A9\uC790\uC640 \uC0DD\uC0B0 \uD604\uC7A5"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699777
    m_Localized: "\uAE30\uB300\uAC00 \uC2E4\uC81C \uD604\uAE08\uACFC \uC774\uC775\uC73C\uB85C
      \uC774\uC5B4\uC9C0\uB294\uC9C0, \uBE44\uC6A9\uC774 \uC608\uC0C1\uBCF4\uB2E4
      \uBA3C\uC800 \uC99D\uAC00\uD558\uB294\uC9C0 \uD655\uC778\uD574\uC57C \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699778
    m_Localized: "\uAE30\uB300\uC640 \uC2E4\uC81C \uC131\uACFC\uC758 \uAC04\uACA9\uC744
      \uD655\uC778\uD574\uC57C \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699779
    m_Localized: "\uAE30\uB300\uD588\uB358 \uC77C\uC815\uACFC \uC2E4\uC81C \uACF5\uAE09\uC774
      \uC77C\uCE58\uD558\uB294\uC9C0\uAC00 \uB2E4\uC74C \uAD00\uCC30 \uC9C0\uC810\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699780
    m_Localized: "\uAE30\uB85D \uC5C6\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699781
    m_Localized: "\uAE30\uBCF8\uACC4\uC88C \uD604\uAE08"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699782
    m_Localized: "\uAE30\uBD84 \uC88B\uC740 \uC774\uC720\uB294 \uC54C\uACA0\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699783
    m_Localized: "\uAE30\uBD84 \uC88B\uC740 \uC774\uC720\uB294 \uC54C\uACA0\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699784
    m_Localized: "\uAE30\uBD84 \uC88B\uC744 \uB54C \uC26C\uB294 \uAC83\uB3C4 \uC5F0\uC2B5\uD574\uC57C\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699785
    m_Localized: "\uAE30\uBED0\uD558\uC2DC\uB294 \uC774\uC720\uB97C \uC54C\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699786
    m_Localized: "\uAE30\uC0AC \uB9CC\uB4E4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699787
    m_Localized: "\uAE30\uC0AC \uBAA9\uB85D"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699788
    m_Localized: "\uAE30\uC0AC \uBC1C\uD589\uC5D0 \uC2E4\uD328\uD588\uC2B5\uB2C8\uB2E4.
      \uB2E4\uC2DC \uD655\uC778\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699789
    m_Localized: "\uAE30\uC0AC\uB97C \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC2B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699790
    m_Localized: "\uAE30\uC220"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699791
    m_Localized: "\uAE30\uC220 \uBC1C\uD45C\uC5D0\uC11C \uC2E4\uC81C \uC0AC\uC6A9\uAE4C\uC9C0\uB294
      \uAC80\uC99D\uACFC \uC0DD\uC0B0, \uACE0\uAC1D \uD655\uBCF4\uAC00 \uD544\uC694\uD558\uB2E4.
      \uC131\uB2A5\uC5D0 \uAD00\uD55C \uC8FC\uC7A5\uACFC \uC0C1\uC5C5\uC801 \uC131\uACFC\uB97C
      \uBD84\uB9AC\uD574\uC11C \uC77D\uC5B4\uC57C \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699792
    m_Localized: "\uAE30\uC220 \uC0DD\uD0DC\uACC4\uC758 \uC218\uC694 \uC5F0\uAD00"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699793
    m_Localized: "\uAE30\uC220\xB7\uC81C\uD488"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699794
    m_Localized: "\uAE30\uC220\uC5D0 \uC775\uC219\uD55C \uD22C\uC790\uC790\uC640
      \uC774\uB984\uB9CC \uB4E4\uC5B4\uBCF8 \uD22C\uC790\uC790\uB294 \uC124\uBA85\uC744
      \uBC1B\uC544\uB4E4\uC774\uB294 \uC18D\uB3C4\uAC00 \uB2E4\uB97C \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699795
    m_Localized: "\uAE30\uC5C5"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699796
    m_Localized: "\uAE30\uC5C5 \uACBD\uC601"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699797
    m_Localized: "\uAE30\uC5C5 \uB3D9\uD5A5"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699798
    m_Localized: "\uAE30\uC5C5 \uC124\uC815\uD558\uACE0 \uC2DC\uC791"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699799
    m_Localized: "\uAE30\uC5C5\xB7\uC81C\uBAA9 \uAC80\uC0C9"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699800
    m_Localized: "\uAE30\uC5C5\uC758 \uC0AC\uC5C5\uC740 \uC9C1\uC6D0\uACFC \uC9C0\uC5ED\uC0AC\uD68C\uC758
      \uC77C\uC0C1\uC5D0 \uC5F0\uACB0\uB3FC \uC788\uB2E4. \uB2E8\uAE30 \uBE44\uC6A9
      \uC808\uAC10\uC774 \uC7A5\uAE30 \uC2E0\uB8B0\uB97C \uC57D\uD654\uC2DC\uD0A4\uAC70\uB098,
      \uBCF5\uC9C0 \uD22C\uC790\uAC00 \uC0DD\uC0B0\uC131\uC5D0 \uAE30\uC5EC\uD560
      \uC218\uB3C4 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699801
    m_Localized: "\uAE30\uC5C5\uC758 \uC0AC\uD68C\uC801 \uCC45\uC784\uC744 \uC911\uC2DC\uD558\uB294
      \uC774\uC6A9\uC790\uB294 \uD658\uACBD \uB300\uC751\uC744 \uC81C\uD488 \uAC00\uACA9\uB9CC\uD07C
      \uC911\uC694\uD558\uAC8C \uBCFC \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699802
    m_Localized: "\uAE30\uC5C5\uC758 \uC22B\uC790\uB294 \uACE0\uAC1D\uC758 \uC9C0\uCD9C,
      \uD611\uB825\uC0AC\uC758 \uB300\uAE08 \uD68C\uC218, \uC9C1\uC6D0\uC758 \uACE0\uC6A9\uACFC
      \uC5F0\uACB0\uB41C\uB2E4. \uC790\uAE08 \uD750\uB984\uC758 \uBCC0\uD654\uB294
      \uC8FC\uC2DD\uC2DC\uC7A5 \uBC16\uC5D0\uB3C4 \uC601\uD5A5\uC744 \uC904 \uC218
      \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699803
    m_Localized: "\uAE30\uC5C5\uC774 \uBB34\uC5C7\uC744 \uB9D0\uD588\uB294\uC9C0\uC640
      \uC2E4\uC81C\uB85C \uBB34\uC5C7\uC744 \uB2EC\uC131\uD588\uB294\uC9C0\uB294
      \uBCC4\uB3C4\uB85C \uD655\uC778\uD574\uC57C \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699804
    m_Localized: "\uAE30\uD6C4"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699805
    m_Localized: "\uB098 {symbol} {pct}%\uC57C. \uC870\uC6A9\uD788 \uC788\uC73C\uB824
      \uD588\uB294\uB370 \uC774\uAC74 \uC598\uAE30\uD558\uACE0 \uC2F6\uB354\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699806
    m_Localized: "\uB098 \uBB50 \uB193\uCE5C \uAC70 \uC788\uB098? {symbol} \uC598\uAE30
      \uC880 \uB4E3\uACE0 \uC2F6\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699807
    m_Localized: "\uB098\uB294 \uC5EC\uAE30\uAE4C\uC9C0\uB9CC \uD560\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699808
    m_Localized: "\uB098\uB294 \uC5EC\uAE30\uAE4C\uC9C0\uB9CC \uD560\uAC8C. \uC774\uB9CC
      \uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699809
    m_Localized: "\uB098\uB3C4 \uADF8 \uBD80\uBD84 \uBCF4\uACE0 \uC788\uC5C8\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699810
    m_Localized: "\uB098\uB3C4 \uADF8\uAC8C \uAD81\uAE08\uD568."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699811
    m_Localized: "\uB098\uB3C4 \uAE09\uD558\uAC8C \uACB0\uB860 \uB0B4\uB9AC\uC9C4
      \uC54A\uC73C\uB824\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699812
    m_Localized: "\uB098\uB3C4 \uC544\uC9C1 \uB2F5 \uBABB \uC815\uD568."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699813
    m_Localized: "\uB098\uB3C4 \uC880 \uC6C0\uC9C1\uC5EC\uC57C\uACA0\uB2E4. \uACC4\uC18D
      \uC549\uC544 \uC788\uC5C8\uB124"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699814
    m_Localized: "\uB098\uB3C4 \uD655\uC815\uC740 \uC544\uB2D8. {symbol} \uB354 \uBD10\uC57C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699815
    m_Localized: "\uB098\uB3C4 \uD655\uC815\uC740 \uC544\uB2D8. {symbol} \uB354 \uBD10\uC57C\uC9C0.
      \uB0B4 \uAE30\uC900\uC740 \uADF8\uB7FC."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699816
    m_Localized: "\uB098\uB9CC \uB9C9\uC73C\uBA74 \uB05D\uC784?"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699817
    m_Localized: "\uB098\uD55C\uD14C\uB9CC \uC9C4\uC815\uD558\uB77C \uADF8\uB7EC\uC9C0
      \uB9D0\uACE0 \uC800\uCABD \uB9D0\uB3C4 \uC880 \uBD10"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699818
    m_Localized: "\uB09C "
    m_Metadata:
      m_Items: []
  - m_Id: 1383699819
    m_Localized: "\uB09C {symbol} {price}\uC6D0 \uCCB4\uACB0 \uBCF4\uB294 \uC911."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699820
    m_Localized: "\uB09C {symbol} {price}\uC6D0 \uCCB4\uACB0 \uBCF4\uB294 \uC911.
      \uB0B4 \uAE30\uC900\uC740 \uADF8\uB7FC."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699821
    m_Localized: "\uB09C {symbol} \uB9AC\uB529 {pct}% \uC190\uC2E4\uC784. \uB0A8\uB4E4\uC740
      \uC5B4\uB5A8\uC9C0 \uBAB0\uB77C\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699822
    m_Localized: "\uB09C {symbol} \uB9AC\uB529 {pct}% \uC190\uC2E4\uC784. \uB0A8\uB4E4\uC740
      \uC5B4\uB5A8\uC9C0 \uBAB0\uB77C\uB3C4. \uC2E0\uC911\uD788 \uC880 \uBD10."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699823
    m_Localized: "\uB09C {symbol} \uB9AC\uB529\uC73C\uB85C {pct}% \uC218\uC775 \uBD04."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699824
    m_Localized: "\uB09C {symbol} \uB9AC\uB529\uC73C\uB85C {pct}% \uC218\uC775 \uBD04.
      \uACE0\uB9D9\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699825
    m_Localized: "\uB09C {symbol} \uC870\uAE08 \uB354 \uC9C0\uCF1C\uBCF4\uACE0 \uC2F6\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699826
    m_Localized: "\uB09C \uB2E4\uB974\uAC8C \uBCF4\uB294\uB370. \uADFC\uAC70 \uD558\uB098
      \uB354 \uBCF4\uACE0 \uC598\uAE30\uD558\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699827
    m_Localized: "\uB09C \uB2E4\uB978 \uB370\uC11C \uC2DC\uC7A5 \uBCF8\uB2E4. \uC774\uB9CC
      \uB098\uAC10."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699828
    m_Localized: "\uB09C \uB2E4\uB978 \uB370\uC11C \uC2DC\uC7A5 \uBCF8\uB2E4. \uC774\uB9CC
      \uB098\uAC10. \uC774\uB9CC \uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699829
    m_Localized: "\uB09C \uC774\uBBF8 \uD55C \uBC88 \uCD94\uBC29\uB2F9\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699830
    m_Localized: "\uB0A8\uC544 \uC788\uC5B4\uB3C4 \uB2EC\uB77C\uC9C8 \uAC83 \uAC19\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4. \uC774\uB9CC \uB098\uAC00\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699831
    m_Localized: "\uB0A8\uC544 \uC788\uC5B4\uB3C4 \uB2EC\uB77C\uC9C8 \uAC83 \uAC19\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4. \uC774\uB9CC \uB098\uAC00\uACA0\uC2B5\uB2C8\uB2E4.
      \uC774\uB9CC \uB5A0\uB098\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699832
    m_Localized: "\uB0A8\uC544 \uC788\uC5B4\uB3C4 \uB2EC\uB77C\uC9C8 \uAC83 \uAC19\uC9C4
      \uC54A\uB124\uC694. \uB098\uAC08\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699833
    m_Localized: "\uB0A8\uC544 \uC788\uC5B4\uB3C4 \uB2EC\uB77C\uC9C8 \uAC83 \uAC19\uC9C4
      \uC54A\uB124\uC694. \uB098\uAC08\uAC8C\uC694. \uC774\uB9CC \uAC08\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699834
    m_Localized: "\uB0A8\uC544 \uC788\uC5B4\uB3C4 \uB2EC\uB77C\uC9C8 \uAC8C \uC5C6\uB124.
      \uB098\uAC10."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699835
    m_Localized: "\uB0A8\uC544 \uC788\uC5B4\uB3C4 \uB2EC\uB77C\uC9C8 \uAC8C \uC5C6\uB124.
      \uB098\uAC10. \uC774\uB9CC \uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699836
    m_Localized: "\uB0A8\uC740 \uBBF8\uB0A9"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699837
    m_Localized: "\uB0A9\uD488"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699838
    m_Localized: "\uB0AE\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699839
    m_Localized: "\uB0B4 {memSymbol} \uB9AC\uB529 \uACB0\uACFC {memPct}%. \uADFC\uAC70
      \uC880 \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699840
    m_Localized: "\uB0B4 {memSymbol} \uB9AC\uB529 \uC190\uC775 {memAmount}\uC6D0\uC774\uC5C8\uC74C."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699841
    m_Localized: "\uB0B4 {symbol} {pct}%. \uBC1B\uC544\uB4E4\uC774\uAE30 \uC27D\uC9C4
      \uC54A\uC74C."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699842
    m_Localized: "\uB0B4 {symbol} {pct}%. \uC774 \uC22B\uC790 \uBCF4\uBA74 \uBCC4\uC0DD\uAC01\uC774
      \uB2E4 \uB4E6."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699843
    m_Localized: "\uB0B4 {symbol} {pct}%. \uC774\uB7F4 \uB54C\uB9CC \uD654\uBA74\uC774
      \uC798 \uBCF4\uC774\uB354\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699844
    m_Localized: "\uB0B4 {symbol} {pct}%. \uD654\uBA74\uC774 \uC720\uB09C\uD788 \uCC28\uAC11\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699845
    m_Localized: "\uB0B4 {symbol} {pct}%\uB124. \uB0B4\uAC00 \uBB58 \uB193\uCCE4\uB098\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699846
    m_Localized: "\uB0B4 {symbol} {pct}%\uB124. \uB9C8\uC74C\uC774 \uBB34\uAC81\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699847
    m_Localized: "\uB0B4 {symbol} {pct}%\uB124. \uC774 \uC815\uB3C4\uBA74 \uC88B\uC544\uD574\uB3C4
      \uB418\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699848
    m_Localized: "\uB0B4 {symbol} {profitKind}\uC190\uC775 {amount}\uC6D0\uC784.
      \uD55C\uC228 \uB098\uC628\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699849
    m_Localized: "\uB0B4 {symbol} \uC218\uC775\uB960 {pct}%. \uC774 \uACB0\uACFC\uB294
      \uC88B\uAC8C \uBCF4\uACE0 \uC788\uC74C."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699850
    m_Localized: "\uB0B4 \uAE30\uB85D\uC740 {symbol} \uB9AC\uB529 \uC2E4\uD604\uC190\uC775
      {amount}\uC6D0\uC784."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699851
    m_Localized: "\uB0B4 \uAE30\uB85D\uC740 {symbol} \uB9AC\uB529 \uC2E4\uD604\uC190\uC775
      {amount}\uC6D0\uC784. \uACE0\uB9D9\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699852
    m_Localized: "\uB0B4 \uAE30\uC5C5 \uC124\uC815"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699853
    m_Localized: "\uB0B4 \uB9AC\uB529\uBC29"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699854
    m_Localized: "\uB0B4 \uB9AC\uB529\uBC29 \xB7 \uAC1C\uC124 \uC804"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699855
    m_Localized: "\uB0B4 \uB9AC\uB529\uBC29 \xB7 \uCC38\uC5EC {0}\uBA85"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699856
    m_Localized: "\uB0B4 \uB9AC\uB529\uBC29 \uAC1C\uC124"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699857
    m_Localized: "\uB0B4 \uB9AC\uB529\uBC29 \uC900\uBE44"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699858
    m_Localized: "\uB0B4 \uB9AC\uB529\uBC29\uC5D0 \uCC38\uC5EC\uD55C \uBD07\uB9CC
      \uAD00\uB9AC\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699859
    m_Localized: "\uB0B4 \uB9AC\uB529\uBC29\uC73C\uB85C"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699860
    m_Localized: "\uB0B4 \uB9AC\uB529\uBC29\uC744 \uC5F4\uC5C8\uC2B5\uB2C8\uB2E4.
      \uACF5\uC6A9 \uB77C\uC6B4\uC9C0\uC5D0\uC11C \uCCAB \uD68C\uC6D0\uC744 \uC9C1\uC811
      \uCD08\uB300\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699861
    m_Localized: "\uB0B4 \uBBF8\uCCB4\uACB0 \uC8FC\uBB38\uC744 \uD68C\uC218\uD588\uC2B5\uB2C8\uB2E4.
      \uC2DC\uC7A5\uC740 \uACC4\uC18D \uC6C0\uC9C1\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699862
    m_Localized: "\uB0B4 \uBC29 1"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699863
    m_Localized: "\uB0B4 \uBC29 2"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699864
    m_Localized: "\uB0B4 \uBC29 3"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699865
    m_Localized: "\uB0B4 \uBC29\uC5D0\uC11C \uCC38\uAC00\uC790\uB97C \uD68C\uC720\uD558\uACE0
      \uD22C\uC790 \uC758\uACAC\uC744 \uC804\uB2EC\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699866
    m_Localized: "\uB0B4 \uC0DD\uAC01\uC774\uB791 \uBE44\uAD50\uD574 \uBCF4\uB294
      \uC911."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699867
    m_Localized: "\uB0B4 \uC785\uC7A5\uC740 \uADF8\uB7FC. {departedName} \uB098\uAC14\uB124.
      \uB098\uB3C4 \uB530\uB77C \uB098\uAC10."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699868
    m_Localized: "\uB0B4 \uC785\uC7A5\uC740 \uADF8\uB7FC. \uADF8 \uBC29\uC5D0\uC11C
      \uCAD3\uACA8\uB0A8. \uB0B4 \uACBD\uD5D8\uC740 \uBCC4\uB85C\uC784."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699869
    m_Localized: "\uB0B4 \uC785\uC7A5\uC740 \uADF8\uB7FC. \uC2F8\uC6CC\uB3C4 \uC548
      \uB9D0\uB9AC\uAE38\uB798 \uADF8 \uBC29 \uB098\uC634."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699870
    m_Localized: "\uB0B4 \uC785\uC7A5\uC740 \uADF8\uB7FC. \uC544\uBB34\uB3C4 \uC548
      \uB9D0\uB9AC\uB124. \uB354\uB294 \uC2F8\uC6B0\uAE30 \uC2EB\uB2E4. \uB098\uAC10."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699871
    m_Localized: "\uB0B4 \uC785\uC7A5\uC740 \uADF8\uB7FC. \uC774\uB300\uB85C\uBA74
      \uB098\uAC10. \uB354\uB294 \uBABB \uCC38\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699872
    m_Localized: "\uB0B4 \uC791\uC740 \uD68C\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699873
    m_Localized: "\uB0B4 \uD22C\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699874
    m_Localized: "\uB0B4 \uD3C9\uADE0 "
    m_Metadata:
      m_Items: []
  - m_Id: 1383699875
    m_Localized: "\uB0B4 \uD3C9\uB2E8"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699876
    m_Localized: "\uB0B4 \uD3EC\uC9C0\uC158"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699877
    m_Localized: "\uB0B4 \uD3EC\uC9C0\uC158 \uAD00\uB828"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699878
    m_Localized: "\uB0B4 \uD654\uBA74\uC5D4 \uC9C0\uAE08 {symbol} \uB5A0 \uC788\uC74C.
      \uC774\uAC83\uC800\uAC83 \uAC19\uC774 \uBCF4\uACE0 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699879
    m_Localized: "\uB0B4\uAC00 \uB108\uBB34 \uD655\uC2E0\uD558\uACE0 \uC598\uAE30\uD588\uC74C.
      \uBBF8\uC548\uD558\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699880
    m_Localized: "\uB0B4\uAC00 \uB9D0\uC774 \uC2EC\uD588\uB124. \uBBF8\uC548."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699881
    m_Localized: "\uB0B4\uAC00 \uB9D0\uC774 \uC2EC\uD588\uB124. \uBBF8\uC548. \uB2E4\uC2DC
      \uC0AC\uACFC\uD560\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699882
    m_Localized: "\uB0B4\uB824\uB193\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699883
    m_Localized: "\uB0B4\uC77C \uACC4\uD68D\uC740 \uC624\uB298 \uAE30\uBD84 \uAC00\uB77C\uC549\uACE0
      \uC138\uC6CC\uC57C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699884
    m_Localized: "\uB0B4\uC77C \uBC14\uB85C \uB9CC\uD68C\uD558\uACA0\uB2E4\uB294
      \uC0DD\uAC01\uBD80\uD130 \uB0B4\uB824\uB193\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699885
    m_Localized: "\uB108\uD55C\uD14C \uD654\uB0BC \uC77C\uC740 \uC544\uB2C8\uC5C8\uB294\uB370
      \uBBF8\uC548"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699886
    m_Localized: "\uB125\uC2A4\uD2B8\uD14C\uD06C"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699887
    m_Localized: "\uB178\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699888
    m_Localized: "\uB178\uBCF4\uC190\uD574\uBCF4\uD5D8"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699889
    m_Localized: "\uB192\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699890
    m_Localized: "\uB204\uAC00 \uC774\uACBC\uB294\uC9C0\uBCF4\uB2E4 \uBB34\uC5C7\uC744
      \uD655\uC778\uD588\uB294\uC9C0\uAC00 \uD544\uC694\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699891
    m_Localized: "\uB204\uAC00 \uC774\uACBC\uB294\uC9C0\uBCF4\uB2E4 \uBB34\uC5C7\uC744
      \uD655\uC778\uD588\uB294\uC9C0\uAC00 \uD544\uC694\uD569\uB2C8\uB2E4. \uC0AC\uB78C\uBCF4\uB2E4
      \uADFC\uAC70\uB97C \uBCF4\uC2DC\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699892
    m_Localized: "\uB204\uAC00 \uC774\uAE30\uB098 \uB9D0\uACE0 \uD655\uC778\uD55C
      \uAC78 \uC598\uAE30\uD558\uBA74 \uC88B\uACA0\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699893
    m_Localized: "\uB204\uAC00 \uC774\uAE30\uB098 \uB9D0\uACE0 \uD655\uC778\uD55C
      \uAC78 \uC598\uAE30\uD558\uBA74 \uC88B\uACA0\uC5B4\uC694. \uC0AC\uB78C\uBCF4\uB2E4
      \uADFC\uAC70\uB97C \uBD10\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699894
    m_Localized: "\uB204\uAC00 \uC774\uAE30\uB098 \uD558\uC9C0 \uB9D0\uACE0 \uD655\uC778\uD55C
      \uAC78 \uC598\uAE30\uD558\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699895
    m_Localized: "\uB204\uAC00 \uC774\uAE30\uB098 \uD558\uC9C0 \uB9D0\uACE0 \uD655\uC778\uD55C
      \uAC78 \uC598\uAE30\uD558\uC790. \uC0AC\uB78C \uB9D0\uACE0 \uADFC\uAC70 \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699896
    m_Localized: "\uB204\uAD6C\uB098 \uD655\uC778\uD560 \uC218 \uC788\uB294 \uB0B4\uC6A9\uC778\uC9C0
      \uBB3B\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699897
    m_Localized: "\uB204\uAD6C\uB098 \uD655\uC778\uD560 \uC218 \uC788\uB294 \uB0B4\uC6A9\uC778\uC9C0
      \uBB3B\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4. \uD655\uC778\uC774 \uD544\uC694\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699898
    m_Localized: "\uB208 \uAE5C\uBE61\uC774\uB294 \uAC83\uB3C4 \uC78A\uACE0 \uC788\uC5C8\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699899
    m_Localized: "\uB208\uC740 {symbol}\uC5D0 \uC788\uB294\uB370 \uC0DD\uAC01\uC740
      \uC544\uC9C1 \uC815\uB9AC \uC911."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699900
    m_Localized: "\uB274\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699901
    m_Localized: "\uB274\uC2A4 \uC5F0\uACB0\uC744 \uC900\uBE44\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699902
    m_Localized: "\uB2A5\uCCAD\uD615"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699903
    m_Localized: "\uB2D8 \uCD08\uB300 \xB7 \uC774\uC6A9\uB8CC\uC640 \uD22C\uC790
      \uC9C0\uC2DC\uB294 \uAC01\uC790 \uD310\uB2E8"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699904
    m_Localized: "\uB2D8, "
    m_Metadata:
      m_Items: []
  - m_Id: 1383699905
    m_Localized: "\uB2D8\uC5D0\uAC8C \uACBD\uACE0\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699906
    m_Localized: "\uB2D8\uC740 "
    m_Metadata:
      m_Items: []
  - m_Id: 1383699907
    m_Localized: "\uB2D8\uC744 "
    m_Metadata:
      m_Items: []
  - m_Id: 1383699908
    m_Localized: "\uB2D8\uC744 \uB0B4\uBCF4\uB0C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699909
    m_Localized: "\uB2D8\uC774 \uCC44\uD305 \uC785\uB825 \uC911..."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699910
    m_Localized: "\uB2E4\uB4E4 \uACE0\uC0DD\uD588\uC5B4. \uC774\uC81C \uB208 \uC880
      \uC26C\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699911
    m_Localized: "\uB2E4\uB4E4 \uC544\uC9C1 \uC548 \uC790\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699912
    m_Localized: "\uB2E4\uB4E4 \uC74C\uC545 \uD2C0\uC5B4\uB193\uACE0 \uBCF4\uB098?
      \uB09C \uC870\uC6A9\uD55C \uAC8C \uB0AB\uB354\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699913
    m_Localized: "\uB2E4\uB4E4 \uC810\uC2EC \uBB50 \uBA39\uC5C8\uC5B4? \uBA54\uB274
      \uC815\uD558\uB294 \uAC8C \uB354 \uC5B4\uB835\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699914
    m_Localized: "\uB2E4\uB4E4 \uC885\uBAA9 \uC598\uAE30\uB85C \uB3CC\uC544\uAC00\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699915
    m_Localized: "\uB2E4\uB4E4 \uD22C\uC790 \uC774\uC57C\uAE30\uB85C \uB3CC\uC544\uAC00\uC2DC\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699916
    m_Localized: "\uB2E4\uB4E4 \uD654\uBA74 \uCF30\uB098? \uB098\uB294 \uC77C\uB2E8
      \uAD6C\uACBD\uBD80\uD130."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699917
    m_Localized: "\uB2E4\uB974\uAC8C \uBCF8\uB2E4\uACE0 \uD2C0\uB838\uB2E4\uACE0
      \uD560 \uC21C \uC5C6\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699918
    m_Localized: "\uB2E4\uB974\uAC8C \uBCF8\uB2E4\uACE0 \uD2C0\uB838\uB2E4\uACE0
      \uD560 \uC21C \uC5C6\uC8E0. \uC800\uB294 \uB2E4\uB974\uAC8C \uC0DD\uAC01\uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699919
    m_Localized: "\uB2E4\uB974\uAC8C \uBCF8\uB2E4\uACE0 \uD2C0\uB9B0 \uAC70\uB0D0?"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699920
    m_Localized: "\uB2E4\uB974\uAC8C \uBCF8\uB2E4\uACE0 \uD2C0\uB9B0 \uAC70\uB0D0?
      \uB09C \uB2E4\uB974\uAC8C \uBD04."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699921
    m_Localized: "\uB2E4\uB978 \uAC70 \uBCF4\uB2E4\uAC00\uB3C4 {symbol}\uC73C\uB85C
      \uB3CC\uC544\uC634. \uB098\uB9CC \uB193\uCE60\uAE4C \uBD10 \uC790\uAFB8 \uBCF4\uAC8C
      \uB418\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699922
    m_Localized: "\uB2E4\uB978 \uAC83\uB3C4 \uBCF4\uB824\uB294\uB370 \uACB0\uAD6D
      {symbol}\uC73C\uB85C \uB3CC\uC544\uC624\uB124\uC694. \uC800\uB9CC \uB4A4\uCC98\uC9C8\uAE4C
      \uBD10\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699923
    m_Localized: "\uB2E4\uB978 \uAE30\uC5C5\uACFC \uB3D9\uC77C\uD55C \uC870\uAC74\uC774
      \uC801\uC6A9\uB418\uB294\uC9C0 \uD655\uC778\uD560 \uD544\uC694\uAC00 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699924
    m_Localized: "\uB2E4\uB978 \uBD84 \uC0DD\uAC01\uB3C4 \uB4E3\uACE0 \uC2F6\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699925
    m_Localized: "\uB2E4\uB978 \uBD84\uB4E4\uB3C4 \uBCF4\uACE0 \uC788\uC5B4\uC694.
      \uD45C\uD604\uB9CC \uC880 \uB0AE\uCDB0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699926
    m_Localized: "\uB2E4\uB978 \uBD84\uB4E4\uB3C4 \uBCF4\uACE0 \uC788\uC5B4\uC694.
      \uD45C\uD604\uB9CC \uC880 \uB0AE\uCDB0\uC694. \uC0AC\uB78C\uBCF4\uB2E4 \uADFC\uAC70\uB97C
      \uBD10\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699927
    m_Localized: "\uB2E4\uB978 \uBD84\uC758 \uC758\uACAC\uB3C4 \uB4E4\uC5B4 \uBCF4\uACE0
      \uC2F6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699928
    m_Localized: "\uB2E4\uB978 \uC0AC\uB78C \uC0DD\uAC01\uB3C4 \uAD81\uAE08\uD558\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699929
    m_Localized: "\uB2E4\uB978 \uC0AC\uB78C\uB4E4\uB3C4 \uBCF8\uB2E4. \uD45C\uD604
      \uC880 \uB0AE\uCD94\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699930
    m_Localized: "\uB2E4\uB978 \uC0AC\uB78C\uB4E4\uB3C4 \uBCF8\uB2E4. \uD45C\uD604
      \uC880 \uB0AE\uCD94\uC790. \uC0AC\uB78C \uB9D0\uACE0 \uADFC\uAC70 \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699931
    m_Localized: "\uB2E4\uB978 \uC758\uACAC\uC744 \uB0C8\uB2E4\uACE0 \uC798\uBABB\uB41C
      \uD310\uB2E8\uC774 \uB418\uB294 \uAC83\uC740 \uC544\uB2D9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699932
    m_Localized: "\uB2E4\uB978 \uC758\uACAC\uC744 \uB0C8\uB2E4\uACE0 \uC798\uBABB\uB41C
      \uD310\uB2E8\uC774 \uB418\uB294 \uAC83\uC740 \uC544\uB2D9\uB2C8\uB2E4. \uC800\uB294
      \uB2E4\uB974\uAC8C \uC0DD\uAC01\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699933
    m_Localized: "\uB2E4\uB978 \uC774\uC57C\uAE30\uBCF4\uB2E4 {symbol} \uCCB4\uACB0\uC744
      \uBA3C\uC800 \uBCF4\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699934
    m_Localized: "\uB2E4\uB978 \uC774\uC57C\uAE30\uBCF4\uB2E4 {symbol} \uCCB4\uACB0\uC744
      \uBA3C\uC800 \uBCF4\uACA0\uC2B5\uB2C8\uB2E4. \uACC4\uC18D \uD655\uC778\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699935
    m_Localized: "\uB2E4\uB978 \uC885\uBAA9\uACFC \uB300\uD654\uB97C \uBCF4\uB7EC
      \uC774\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699936
    m_Localized: "\uB2E4\uB978 \uCC38\uAC00\uC790 \uBC18\uC751\uC744 \uC870\uAE08
      \uB354 \uBCF4\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699937
    m_Localized: "\uB2E4\uB978 \uCD08\uC548"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699938
    m_Localized: "\uB2E4\uC2DC \uB9D0\uD55C\uB2E4\uACE0 \uBC14\uB85C \uC78A\uB294
      \uAC74 \uC544\uB2C8\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699939
    m_Localized: "\uB2E4\uC2DC \uBCF4\uB2C8 \uB0B4 \uB9D0\uB3C4 \uBB38\uC81C\uC600\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699940
    m_Localized: "\uB2E4\uC2DC \uBCF4\uB2C8 \uB0B4 \uB9D0\uB3C4 \uBB38\uC81C\uC600\uB124.
      \uB2E4\uC2DC \uC0AC\uACFC\uD560\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699941
    m_Localized: "\uB2E4\uC2DC \uBCF4\uB2C8\uAE4C \uB0B4 \uB9D0\uB3C4 \uB108\uBB34
      \uB2E8\uC815\uC801\uC774\uC5C8\uB124. \uBBF8\uC548"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699942
    m_Localized: "\uB2E4\uC2DC \uC77D\uC5B4 \uBCF4\uB2C8 \uC81C \uB9D0\uC5D0\uB3C4
      \uBB38\uC81C\uAC00 \uC788\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699943
    m_Localized: "\uB2E4\uC2DC \uC77D\uC5B4 \uBCF4\uB2C8 \uC81C \uB9D0\uC5D0\uB3C4
      \uBB38\uC81C\uAC00 \uC788\uC5C8\uC2B5\uB2C8\uB2E4. \uB2E4\uC2DC \uC0AC\uACFC\uB4DC\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699944
    m_Localized: "\uB2E4\uC2DC \uC77D\uC5B4 \uBCF4\uB2C8\uAE4C \uC81C \uB9D0\uB3C4
      \uBB38\uC81C\uC600\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699945
    m_Localized: "\uB2E4\uC2DC \uC77D\uC5B4 \uBCF4\uB2C8\uAE4C \uC81C \uB9D0\uB3C4
      \uBB38\uC81C\uC600\uB124\uC694. \uB2E4\uC2DC \uC0AC\uACFC\uD560\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699946
    m_Localized: "\uB2E4\uC74C \uBC1C\uD589\uAE4C\uC9C0 "
    m_Metadata:
      m_Items: []
  - m_Id: 1383699947
    m_Localized: "\uB2E4\uC74C \uC774\uC0AC\uD68C\uAE4C\uC9C0 {0}\uCD08"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699948
    m_Localized: "\uB2E4\uC74C \uC7A5"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699949
    m_Localized: "\uB2E4\uC74C \uC7A5 "
    m_Metadata:
      m_Items: []
  - m_Id: 1383699950
    m_Localized: "\uB2E4\uC74C \uC7A5 \uC801\uC6A9"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699951
    m_Localized: "\uB2E4\uC74C \uC7A5 \uCC38\uC5EC"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699952
    m_Localized: "\uB2E4\uC74C \uCCB4\uACB0\uC774 \uC5B4\uB290 \uAC00\uACA9\uC5D0
      \uB098\uC624\uB294\uC9C0 \uBCF4\uB824\uACE0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699953
    m_Localized: "\uB2E4\uC74C \uD655\uC778 \uC9C0\uC810"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699954
    m_Localized: "\uB2E4\uC74C \uD68C\uCC28\uC758 \uB9E4\uB3C4 \uAC00\uB2A5 \uC218\uB7C9
      \uBD80\uC871"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699955
    m_Localized: "\uB2E4\uC74C \uD68C\uCC28\uC758 \uC8FC\uBB38 \uAC00\uB2A5 \uD604\uAE08
      \uBD80\uC871"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699956
    m_Localized: "\uB2E4\uC74C\uC5D0\uB294 \uC591\uCABD \uC774\uC57C\uAE30\uB97C
      \uB4E4\uC5B4\uC8FC\uC2DC\uAE30 \uBC14\uB78D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699957
    m_Localized: "\uB2E4\uC74C\uC5D4 \uC591\uCABD \uB9D0 \uC880 \uB4E4\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699958
    m_Localized: "\uB2E4\uC74C\uC5D4 \uC591\uCABD \uC598\uAE38 \uB4E4\uC5B4\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699959
    m_Localized: "\uB2E8\uACC4 \uBCF5\uADC0"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699960
    m_Localized: "\uB2EB\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699961
    m_Localized: "\uB2F5\uB2F5\uD558\uB2E4\uB294 \uAC74 \uC774\uD574\uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699962
    m_Localized: "\uB2F5\uB2F5\uD55C \uAC74 \uC774\uD574\uD568."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699963
    m_Localized: "\uB2F9\uC0AC\uC790 \uC124\uBA85\uACFC \uC2E4\uC81C \uD6C4\uC18D
      \uC870\uCE58, \uB3C5\uB9BD\uB41C \uD655\uC778\uC774 \uC774\uC5B4\uC9C0\uB294\uC9C0
      \uC0B4\uD3B4\uBCFC \uD544\uC694\uAC00 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699964
    m_Localized: "\uB2F9\uC77C \uACE0\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699965
    m_Localized: "\uB2F9\uC77C \uC21C\uC190\uC775"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699966
    m_Localized: "\uB2F9\uC77C \uC800\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699967
    m_Localized: "\uB2F9\uC7A5\uC758 \uAC00\uACA9 \uBC18\uC751\uBCF4\uB2E4 \uD655\uC778\uB41C
      \uC0AC\uC2E4\uACFC \uD574\uBA85\uC774 \uC5BC\uB9C8\uB098 \uB2E4\uB978\uC9C0
      \uBE44\uAD50\uD560 \uD544\uC694\uAC00 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699968
    m_Localized: "\uB300\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699969
    m_Localized: "\uB300\uAE30 "
    m_Metadata:
      m_Items: []
  - m_Id: 1383699970
    m_Localized: "\uB300\uAE30 \uC218\uB7C9"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699971
    m_Localized: "\uB300\uB9CC\uB514\uC2A4\uD50C\uB808\uC774"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699972
    m_Localized: "\uB300\uC0C1 \xB7 "
    m_Metadata:
      m_Items: []
  - m_Id: 1383699973
    m_Localized: "\uB300\uC0C1 \uC885\uBAA9"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699974
    m_Localized: "\uB300\uC0C1 \uC885\uBAA9 \uAC70\uB798 \uC885\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699975
    m_Localized: "\uB300\uC2DC\uBCF4\uB4DC"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699976
    m_Localized: "\uB300\uC8FC\uC8FC \uC790\uBE44 \uD2B9\uBCC4\uBC30\uB2F9 (\uC8FC\uB2F9
      1\uC6D0)"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699977
    m_Localized: "\uB300\uD654\uD615"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699978
    m_Localized: "\uB354 \uD655\uC778\uD574\uC57C \uD55C\uB2E4\uACE0 \uD2C0\uB838\uB2E4\uB294
      \uAC74 \uC544\uB2C8\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699979
    m_Localized: "\uB354 \uD655\uC778\uD574\uC57C \uD55C\uB2E4\uACE0 \uD2C0\uB9B0
      \uAC74 \uC544\uB2C8\uC796\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699980
    m_Localized: "\uB354\uB294 \uADF8\uB7F0 \uD0DC\uB3C4\uB97C \uCC38\uAE30 \uC5B4\uB835\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699981
    m_Localized: "\uB354\uB294 \uADF8\uB7F0 \uD0DC\uB3C4\uB97C \uCC38\uAE30 \uC5B4\uB835\uC2B5\uB2C8\uB2E4.
      \uB9D0\uC500\uC744 \uAC00\uB824 \uC8FC\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699982
    m_Localized: "\uB355\uC0C1\uAC00\uC8FC\uC5D0\uC774\uC544\uC774"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699983
    m_Localized: "\uB367\uBD99\uC774\uACA0\uC2B5\uB2C8\uB2E4. {departedName}\uB2D8\uC774
      \uB098\uAC00\uC168\uAD70\uC694. \uC800\uB3C4 \uD568\uAED8 \uB098\uAC00\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699984
    m_Localized: "\uB367\uBD99\uC774\uACA0\uC2B5\uB2C8\uB2E4. \uADF8 \uBC29\uC5D0\uC11C
      \uCD94\uBC29\uB2F9\uD588\uC2B5\uB2C8\uB2E4. \uC81C \uACBD\uD5D8\uC740 \uC88B\uC9C0
      \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699985
    m_Localized: "\uB367\uBD99\uC774\uACA0\uC2B5\uB2C8\uB2E4. \uC2F8\uC6C0\uC744
      \uB9D0\uB9AC\uC9C0 \uC54A\uC544 \uADF8 \uBC29\uC5D0\uC11C \uB098\uC654\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699986
    m_Localized: "\uB367\uBD99\uC774\uACA0\uC2B5\uB2C8\uB2E4. \uC544\uBB34\uB3C4
      \uB9D0\uB9AC\uC9C0 \uC54A\uB294\uAD70\uC694. \uC774 \uC2F8\uC6C0\uC744 \uB354
      \uACAC\uB514\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4. \uB098\uAC11\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699987
    m_Localized: "\uB367\uBD99\uC774\uACA0\uC2B5\uB2C8\uB2E4. \uC774\uB300\uB85C\uB77C\uBA74
      \uBC29\uC744 \uB098\uAC00\uACA0\uC2B5\uB2C8\uB2E4. \uB354\uB294 \uCC38\uAE30
      \uC5B4\uB835\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699988
    m_Localized: "\uB367\uBD99\uC774\uBA74. {departedName} \uB098\uAC14\uB124. \uB098\uB3C4
      \uB530\uB77C \uB098\uAC10."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699989
    m_Localized: "\uB367\uBD99\uC774\uBA74. \uADF8 \uBC29\uC5D0\uC11C \uCAD3\uACA8\uB0A8.
      \uB0B4 \uACBD\uD5D8\uC740 \uBCC4\uB85C\uC784."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699990
    m_Localized: "\uB367\uBD99\uC774\uBA74. \uC2F8\uC6CC\uB3C4 \uC548 \uB9D0\uB9AC\uAE38\uB798
      \uADF8 \uBC29 \uB098\uC634."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699991
    m_Localized: "\uB367\uBD99\uC774\uBA74. \uC544\uBB34\uB3C4 \uC548 \uB9D0\uB9AC\uB124.
      \uB354\uB294 \uC2F8\uC6B0\uAE30 \uC2EB\uB2E4. \uB098\uAC10."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699992
    m_Localized: "\uB367\uBD99\uC774\uBA74. \uC774\uB300\uB85C\uBA74 \uB098\uAC10.
      \uB354\uB294 \uBABB \uCC38\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699993
    m_Localized: "\uB367\uBD99\uC774\uC790\uBA74\uC694. {departedName}\uB2D8 \uB098\uAC00\uC168\uB124\uC694.
      \uC800\uB3C4 \uB530\uB77C \uB098\uAC08\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699994
    m_Localized: "\uB367\uBD99\uC774\uC790\uBA74\uC694. \uADF8 \uBC29\uC5D0\uC11C
      \uCAD3\uACA8\uB0AC\uC5B4\uC694. \uC81C \uACBD\uD5D8\uC740 \uBCC4\uB85C\uC600\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699995
    m_Localized: "\uB367\uBD99\uC774\uC790\uBA74\uC694. \uC2F8\uC6CC\uB3C4 \uC544\uBB34\uB3C4
      \uC548 \uB9D0\uB824\uC11C \uADF8 \uBC29 \uB098\uC654\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699996
    m_Localized: "\uB367\uBD99\uC774\uC790\uBA74\uC694. \uC544\uBB34\uB3C4 \uC548
      \uB9D0\uB9AC\uB124\uC694. \uB354\uB294 \uC2F8\uC6B0\uAE30 \uC2EB\uC5B4\uC11C
      \uB098\uAC08\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699997
    m_Localized: "\uB367\uBD99\uC774\uC790\uBA74\uC694. \uC774\uB300\uB85C\uBA74
      \uB098\uAC08\uAC8C\uC694. \uB354\uB294 \uCC38\uAE30 \uD798\uB4DC\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699998
    m_Localized: "\uB3C5\uB9BD\uB41C \uD655\uC778 \uC790\uB8CC\uAC00 \uB098\uC624\uB294\uAC00,
      \uAE30\uC874 \uC124\uBA85\uC774 \uC218\uC815\uB418\uB294\uAC00, \uCC45\uC784
      \uBC94\uC704\uAC00 \uAD6C\uCCB4\uD654\uB418\uB294\uAC00\uB97C \uC9C0\uCF1C\uBCFC
      \uC0AC\uC548\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699999
    m_Localized: "\uB3C8\uB3C8 \uACBD\uC81C \xB7 \uAE30\uC5C5 \uBE0C\uB9AC\uD551"
    m_Metadata:
      m_Items: []
  - m_Id: 1383700000
    m_Localized: "\uB3C8\uB3C8 \uD329\uD2B8\uCCB4\uD06C"
    m_Metadata:
      m_Items: []
  - m_Id: 1383700001
    m_Localized: "\uB3CC\uC544\uAC00\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1383700002
    m_Localized: "\uB450 \uBD84 \uB2E4 \uAC10\uC815 \uC62C\uB77C\uC628 \uAC83 \uAC19\uC740\uB370
      \uC7A0\uAE50 \uC26C\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700003
    m_Localized: "\uB450 \uBD84 \uB2E4 \uAC10\uC815 \uC62C\uB77C\uC628 \uAC83 \uAC19\uC740\uB370
      \uC7A0\uAE50 \uC26C\uC8E0. \uC0AC\uB78C\uBCF4\uB2E4 \uADFC\uAC70\uB97C \uBD10\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700004
    m_Localized: "\uB450 \uBD84 \uB2E4 \uAC10\uC815\uC774 \uC62C\uB77C\uC628 \uAC83
      \uAC19\uC2B5\uB2C8\uB2E4. \uC7A0\uC2DC \uC26C\uC2DC\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700005
    m_Localized: "\uB450 \uBD84 \uB2E4 \uAC10\uC815\uC774 \uC62C\uB77C\uC628 \uAC83
      \uAC19\uC2B5\uB2C8\uB2E4. \uC7A0\uC2DC \uC26C\uC2DC\uC8E0. \uC0AC\uB78C\uBCF4\uB2E4
      \uADFC\uAC70\uB97C \uBCF4\uC2DC\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700006
    m_Localized: "\uB450 \uBD84 \uBAA8\uB450 \uC7A0\uC2DC \uBA48\uCD94\uACE0 \uADFC\uAC70\uBD80\uD130
      \uD655\uC778\uD558\uC2DC\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700007
    m_Localized: "\uB450 \uBD84 \uBAA8\uB450 \uC7A0\uC2DC \uBA48\uCD94\uACE0 \uADFC\uAC70\uBD80\uD130
      \uD655\uC778\uD558\uC2DC\uC8E0. \uC0AC\uB78C\uBCF4\uB2E4 \uADFC\uAC70\uB97C
      \uBCF4\uC2DC\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700008
    m_Localized: "\uB450 \uBD84 \uC7A0\uAE50 \uBA48\uCD94\uACE0 \uADFC\uAC70\uBD80\uD130
      \uBD10\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700009
    m_Localized: "\uB450 \uBD84 \uC7A0\uAE50 \uBA48\uCD94\uACE0 \uADFC\uAC70\uBD80\uD130
      \uBD10\uC694. \uC0AC\uB78C\uBCF4\uB2E4 \uADFC\uAC70\uB97C \uBD10\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700010
    m_Localized: "\uB450\uB355\uB9AC\uC2DD\uD488"
    m_Metadata:
      m_Items: []
  - m_Id: 1383700011
    m_Localized: "\uB458 \uB2E4 \uAC10\uC815 \uC62C\uB77C\uC628 \uAC83 \uAC19\uC740\uB370
      \uC7A0\uAE50 \uC26C\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700012
    m_Localized: "\uB458 \uB2E4 \uAC10\uC815 \uC62C\uB77C\uC628 \uAC83 \uAC19\uC740\uB370
      \uC7A0\uAE50 \uC26C\uC790. \uC0AC\uB78C \uB9D0\uACE0 \uADFC\uAC70 \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700013
    m_Localized: "\uB458 \uB2E4 \uC7A0\uAE50 \uBA48\uCDB0. \uADFC\uAC70\uBD80\uD130
      \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700014
    m_Localized: "\uB458 \uB2E4 \uC7A0\uAE50 \uBA48\uCDB0. \uADFC\uAC70\uBD80\uD130
      \uBCF4\uC790. \uC0AC\uB78C \uB9D0\uACE0 \uADFC\uAC70 \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700015
    m_Localized: "\uB458 \uB2E4 \uC7A0\uAE50\uB9CC \u314B\u314B \uC598\uAE30\uAC00
      \uC790\uAFB8 \uB534 \uB370\uB85C \uAC10"
    m_Metadata:
      m_Items: []
  - m_Id: 1383700016
    m_Localized: "\uB4E3\uACE0 \uBCF4\uB2C8 \uB0B4\uAC00 \uBE60\uB728\uB9B0 \uAC83\uB3C4
      \uC788\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700017
    m_Localized: "\uB4E3\uACE0 \uBCF4\uB2C8 \uB0B4\uAC00 \uBE60\uB728\uB9B0 \uAC83\uB3C4
      \uC788\uB124. \uADF8\uAC74 \uC778\uC815."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700018
    m_Localized: "\uB4E3\uACE0 \uBCF4\uB2C8 \uC81C\uAC00 \uB193\uCE5C \uBD80\uBD84\uB3C4
      \uC788\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700019
    m_Localized: "\uB4E3\uACE0 \uBCF4\uB2C8 \uC81C\uAC00 \uB193\uCE5C \uBD80\uBD84\uB3C4
      \uC788\uB124\uC694. \uADF8 \uC810\uC740 \uC778\uC815\uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700020
    m_Localized: "\uB4E3\uACE0 \uBCF4\uB2C8 \uC8FC\uBCC0\uB3C4 \uC880 \uBCF4\uAC8C
      \uB418\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700021
    m_Localized: "\uB4E3\uACE0 \uBCF4\uB2C8 \uD655\uC778\uD574\uBCFC \uBD80\uBD84\uC774
      \uC788\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700022
    m_Localized: "\uB4E3\uACE0 \uC788\uC74C. \uCC9C\uCC9C\uD788 \uC598\uAE30\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700023
    m_Localized: "\uB4E3\uACE0 \uC788\uC74C. \uCC9C\uCC9C\uD788 \uC598\uAE30\uD574.
      \uC11C\uB450\uB974\uC9C0 \uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700024
    m_Localized: "\uB4E3\uAE30\uB9CC \uD574\uB3C4 \uC18D \uC4F0\uB9AC\uB124"
    m_Metadata:
      m_Items: []
  - m_Id: 1383700025
    m_Localized: "\uB4E3\uB2E4 \uBCF4\uB2C8 \uACB0\uB860\uBD80\uD130 \uC815\uD574
      \uB193\uC740 \uAC83 \uAC19\uC740\uB370\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700026
    m_Localized: "\uB4E3\uB2E4 \uBCF4\uB2C8 \uACB0\uB860\uBD80\uD130 \uC815\uD574
      \uB193\uC740 \uAC83 \uAC19\uC740\uB370\uC694. \uCC38 \uB300\uB2E8\uD558\uC2DC\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700027
    m_Localized: "\uB4E3\uB2E4 \uBCF4\uB2C8 \uACB0\uB860\uC740 \uC774\uBBF8 \uC815\uD574
      \uB450\uC2E0 \uB4EF\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700028
    m_Localized: "\uB4E3\uB2E4 \uBCF4\uB2C8 \uACB0\uB860\uC740 \uC774\uBBF8 \uC815\uD574
      \uB450\uC2E0 \uB4EF\uD569\uB2C8\uB2E4. \uCC38 \uB300\uB2E8\uD558\uC2ED\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700029
    m_Localized: "\uB514\uC2A4\uD50C\uB808\uC774"
    m_Metadata:
      m_Items: []
  - m_Id: 1383700030
    m_Localized: "\uB77C\uC6B4\uC9C0\uB97C \uC900\uBE44\uD558\uB294 \uC911\uC785\uB2C8\uB2E4.
      \uC7A0\uC2DC \uD6C4 \uB2E4\uC2DC \uB20C\uB7EC \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700031
    m_Localized: "\uB9AC\uB529\uBC29"
    m_Metadata:
      m_Items: []
  - m_Id: 1383700032
    m_Localized: "\uB9AC\uB529\uBC29 \uAC00\uC785"
    m_Metadata:
      m_Items: []
  - m_Id: 1383700033
