    m_Localized: "\uB9AC\uB529\uBC29 \uAC1C\uC124 \uC644\uB8CC \xB7 \uACF5\uC6A9
      \uB77C\uC6B4\uC9C0\uC5D0\uC11C \uCCAB \uD68C\uC6D0\uC744 \uC9C1\uC811 \uCD08\uB300\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700035
    m_Localized: "\uB9AC\uB529\uBC29 \uAC1C\uC124 \uC804"
    m_Metadata:
      m_Items: []
  - m_Id: 1383700036
    m_Localized: "\uB9AC\uB529\uBC29 \uAC1C\uC124\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1383700037
    m_Localized: "\uB9AC\uB529\uBC29 \uC5F4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1383700038
    m_Localized: "\uB9AC\uB529\uBC29 \uC6B4\uC601\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 1383700039
    m_Localized: "\uB9AC\uB529\uBC29 \uC774\uC6A9\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 1383700040
    m_Localized: "\uB9AC\uB529\uBC29 \uCC38\uC5EC"
    m_Metadata:
      m_Items: []
  - m_Id: 1383700041
    m_Localized: "\uB9AC\uC11C\uCE58 \uB370\uC2A4\uD06C"
    m_Metadata:
      m_Items: []
  - m_Id: 1383700042
    m_Localized: "\uB9AC\uC11C\uCE58 \uB370\uC2A4\uD06C\n"
    m_Metadata:
      m_Items: []
  - m_Id: 1383700043
    m_Localized: "\uB9C8\uAC10 \uACB0\uC0B0 \uD50C\uB7EC\uC2A4 \uD655\uC778\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700044
    m_Localized: "\uB9C8\uAC10 \uC22B\uC790 \uBCF4\uB2C8\uAE4C \uB9C8\uC74C\uC774
      \uBB34\uAC81\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700045
    m_Localized: "\uB9C8\uAC10 \uC815\uB9AC"
    m_Metadata:
      m_Items: []
  - m_Id: 1383700046
    m_Localized: "\uB9C8\uAC10 \uCD1D\uC790\uC0B0"
    m_Metadata:
      m_Items: []
  - m_Id: 1383700047
    m_Localized: "\uB9C8\uAC10 \uD6C4"
    m_Metadata:
      m_Items: []
  - m_Id: 1383700048
    m_Localized: "\uB9C8\uAC10\uC774\uB2E4. \uB0B4\uC77C \uB2E4\uC2DC \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700049
    m_Localized: "\uB9C8\uC6B0\uC2A4 \uC7A1\uC740 \uC190\uC5D0 \uD798 \uB108\uBB34
      \uB4E4\uC5B4\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700050
    m_Localized: "\uB9C8\uC74C\uC774 \uBB34\uAC70\uC6B0\uC2DC\uACA0\uC9C0\uB9CC \uC7A0\uC2DC
      \uC26C\uC5B4 \uAC00\uC154\uB3C4 \uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700051
    m_Localized: "\uB9C8\uC74C\uC774 \uBB34\uAC70\uC6B0\uC2DC\uACA0\uC9C0\uB9CC \uC7A0\uC2DC
      \uC26C\uC5B4 \uAC00\uC154\uB3C4 \uB429\uB2C8\uB2E4. \uC11C\uB450\uB974\uC9C0
      \uB9C8\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700052
    m_Localized: "\uB9C8\uCF13\uC640\uC774\uC5B4 \xB7 \uC775\uBA85 \uC81C\uBCF4"
    m_Metadata:
      m_Items: []
  - m_Id: 1383700053
    m_Localized: "\uB9CC \uC815\uB3C4"
    m_Metadata:
      m_Items: []
  - m_Id: 1383700054
    m_Localized: "\uB9CC\uC6D0\uCBE4"
    m_Metadata:
      m_Items: []
  - m_Id: 1383700055
    m_Localized: "\uB9D0 \uB098\uC628 \uAE40\uC5D0 \uC7A0\uAE50 \uC0DD\uAC01\uC744
      \uC815\uB9AC\uD574\uBD04."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700056
    m_Localized: "\uB9D0 \uD55C\uB9C8\uB514\uB3C4 \uC2E0\uC911\uD574\uC57C\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700057
    m_Localized: "\uB9D0 \uD55C\uB9C8\uB514\uB3C4 \uC2E0\uC911\uD574\uC57C\uACA0\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700058
    m_Localized: "\uB9D0 \uD55C\uB9C8\uB514\uB3C4 \uC870\uC2EC\uD574\uC57C\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700059
    m_Localized: "\uB9D0\uAF2C\uB9AC\uB9CC \uC7A1\uACE0 \uC788\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700060
    m_Localized: "\uB9D0\uAF2C\uB9AC\uB9CC \uC7A1\uACE0 \uC788\uB124. \uB9D0 \uC880
      \uAC00\uB824."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700061
    m_Localized: "\uB9D0\uB9AC\uB294 \uAC74 \uC54C\uACA0\uB294\uB370 \uB0B4 \uC598\uAE30\uB3C4
      \uC880 \uB4E4\uC5B4\uBD10"
    m_Metadata:
      m_Items: []
  - m_Id: 1383700062
    m_Localized: "\uB9D0\uB9AC\uB7EC \uC628 \uC0AC\uB78C\uD55C\uD14C\uAE4C\uC9C0
      \uADF8\uB7EC\uB0D0 \u314B\u314B"
    m_Metadata:
      m_Items: []
  - m_Id: 1383700063
    m_Localized: "\uB9D0\uB9CC \uB4E4\uC73C\uBA74 \uB300\uB2E8\uD55C \uD655\uC2E0\uC774\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700064
    m_Localized: "\uB9D0\uB9CC \uB4E4\uC73C\uBA74 \uB300\uB2E8\uD55C \uD655\uC2E0\uC774\uB124.
      \uCC38 \uB300\uB2E8\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700065
    m_Localized: "\uB9D0\uB9CC \uB4E4\uC73C\uBA74 \uC774\uBBF8 \uACB0\uB9D0 \uBCF4\uACE0
      \uC628 \uC0AC\uB78C\uC784"
    m_Metadata:
      m_Items: []
  - m_Id: 1383700066
    m_Localized: "\uB9D0\uC500 \uB4E4\uC73C\uB2C8 \uC7A0\uC2DC \uC8FC\uBCC0\uC744
      \uB3CC\uC544\uBCF4\uAC8C \uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700067
    m_Localized: "\uB9D0\uC500\uB4DC\uB824\uC57C\uACA0\uC2B5\uB2C8\uB2E4. {departedName}\uB2D8\uC774
      \uB098\uAC00\uC168\uAD70\uC694. \uC800\uB3C4 \uD568\uAED8 \uB098\uAC00\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700068
    m_Localized: "\uB9D0\uC500\uB4DC\uB824\uC57C\uACA0\uC2B5\uB2C8\uB2E4. \uADF8
      \uBC29\uC5D0\uC11C \uCD94\uBC29\uB2F9\uD588\uC2B5\uB2C8\uB2E4. \uC81C \uACBD\uD5D8\uC740
      \uC88B\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700069
    m_Localized: "\uB9D0\uC500\uB4DC\uB824\uC57C\uACA0\uC2B5\uB2C8\uB2E4. \uC2F8\uC6C0\uC744
      \uB9D0\uB9AC\uC9C0 \uC54A\uC544 \uADF8 \uBC29\uC5D0\uC11C \uB098\uC654\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700070
    m_Localized: "\uB9D0\uC500\uB4DC\uB824\uC57C\uACA0\uC2B5\uB2C8\uB2E4. \uC544\uBB34\uB3C4
      \uB9D0\uB9AC\uC9C0 \uC54A\uB294\uAD70\uC694. \uC774 \uC2F8\uC6C0\uC744 \uB354
      \uACAC\uB514\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4. \uB098\uAC11\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700071
    m_Localized: "\uB9D0\uC500\uB4DC\uB824\uC57C\uACA0\uC2B5\uB2C8\uB2E4. \uC774\uB300\uB85C\uB77C\uBA74
      \uBC29\uC744 \uB098\uAC00\uACA0\uC2B5\uB2C8\uB2E4. \uB354\uB294 \uCC38\uAE30
      \uC5B4\uB835\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700072
    m_Localized: "\uB9D0\uC500\uB9CC \uB4E4\uC73C\uBA74 \uD655\uC2E0\uC740 \uB300\uB2E8\uD558\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700073
    m_Localized: "\uB9D0\uC500\uB9CC \uB4E4\uC73C\uBA74 \uD655\uC2E0\uC740 \uB300\uB2E8\uD558\uB124\uC694.
      \uCC38 \uB300\uB2E8\uD558\uC2DC\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700074
    m_Localized: "\uB9D0\uC500\uC740 \uB4E3\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uCC9C\uCC9C\uD788
      \uC815\uB9AC\uD574 \uBCF4\uC2DC\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700075
    m_Localized: "\uB9D0\uC500\uC740 \uB4E3\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uCC9C\uCC9C\uD788
      \uC815\uB9AC\uD574 \uBCF4\uC2DC\uC8E0. \uC11C\uB450\uB974\uC9C0 \uB9C8\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700076
    m_Localized: "\uB9D0\uC500\uC744 \uB4E3\uACE0 \uBCF4\uB2C8 \uC81C\uAC00 \uBE60\uB728\uB9B0
      \uBD80\uBD84\uC774 \uC788\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383700077
    m_Localized: "\uB9D0\uC500\uC744 \uB4E3\uACE0 \uBCF4\uB2C8 \uC81C\uAC00 \uBE60\uB728\uB9B0
      \uBD80\uBD84\uC774 \uC788\uC5C8\uC2B5\uB2C8\uB2E4. \uADF8 \uC810\uC740 \uC778\uC815\uD569\uB2C8\uB2E4."
