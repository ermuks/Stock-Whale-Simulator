  - m_Id: 4011935240192
    m_Localized: "1 \uAE30\uBCF8 \uACC4\uC88C / 2 \uC790\uB3D9 \uACC4\uC88C / 3 \uC804\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 4011935240193
    m_Localized: "AI \uC2DC\uC2A4\uD15C \uB3C4\uC785 \uC131\uACF5 - \uD6A8\uC728\uC131
      \uADF9\uB300\uD654"
