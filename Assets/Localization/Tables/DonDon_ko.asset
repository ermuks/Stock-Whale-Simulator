      m_Items: []
  - m_Id: 1383699541
    m_Localized: "\uAC70\uB798\uB7C9 "
    m_Metadata:
      m_Items: []
  - m_Id: 1383699542
    m_Localized: "\uAC70\uB798\uB7C9 (\uAE08\uC561):"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699543
    m_Localized: "\uAC70\uB798\uB7C9 \u2191"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699544
    m_Localized: "\uAC70\uB798\uB7C9 \uBCF4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699545
    m_Localized: "\uAC70\uB798\uB7C9:"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699546
    m_Localized: "\uAC70\uB798\uC18C \uD604\uAE08 \uBD80\uC871: {0:N0}\uC6D0 \uCD94\uAC00
      \uD544\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699547
    m_Localized: "\uAC70\uB798\uC911\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699548
    m_Localized: "\uAC70\uB798\uC911\uC9C0: \uBBF8\uCCB4\uACB0 \uC8FC\uBB38 \uD68C\uC218.
      \uC7AC\uAC1C \uD6C4 \uC9C1\uC811 \uB2E4\uC2DC \uC2E4\uD589\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699549
    m_Localized: "\uAC70\uB798\uD560 \uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699550
    m_Localized: "\uAC70\uB798\uD560 \uC885\uBAA9\uACFC \uACC4\uC88C\uB97C \uC900\uBE44\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699551
    m_Localized: "\uAC70\uBD80\uD55C \uC9C0\uC2DC #{0} \uBAA9\uD45C \uB3C4\uB2EC
      \uBAA9\uACA9: {1}, \uC2E0\uB8B0 +{2:0.00} (\uBBF8\uCCB4\uACB0)"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699552
    m_Localized: "\uAC70\uC808\n\uC774\uBC88 \uC218\uC2E0 \uC885\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699553
    m_Localized: "\uAC74"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699554
    m_Localized: "\uAC74 \xB7 \uC2E4\uD604 "
    m_Metadata:
      m_Items: []
  - m_Id: 1383699555
    m_Localized: "\uAC80\uC99D \uAC00\uB2A5\uD55C \uAC1C\uC120 \uACB0\uACFC\uC640
      \uD22C\uC790 \uBE44\uC6A9\uC774 \uACF5\uAC1C\uB418\uB294\uC9C0 \uD655\uC778\uD560
      \uD544\uC694\uAC00 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699556
    m_Localized: "\uAC8C\uC784 \uB0B4 \uC2DC\uC7A5\uACFC \uC9C4\uD589 \uC0C1\uD0DC\uC5D0
      \uAD00\uD55C \uC54C\uB9BC\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699557
    m_Localized: "\uACB0\uACFC \uC194\uC9C1\uD558\uAC8C \uB9D0\uD574 \uC918\uC11C
      \uACE0\uB9D9\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699558
    m_Localized: "\uACB0\uACFC \uC194\uC9C1\uD558\uAC8C \uC598\uAE30\uD574 \uC918\uC11C
      \uACE0\uB9C8\uC6CC\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699559
    m_Localized: "\uACB0\uACFC \uC88B\uB2E4\uACE0 \uB0B4\uC77C \uC218\uB7C9\uBD80\uD130
      \uB298\uB9AC\uC9C4 \uB9D0\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699560
    m_Localized: "\uACB0\uACFC \uC88B\uC558\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699561
    m_Localized: "\uACB0\uACFC\uAC00 \uC88B\uC73C\uC168\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699562
    m_Localized: "\uACB0\uACFC\uB294 \uC544\uC9C1\uC778\uB370 \uC124\uBA85\uBD80\uD130
      \uD558\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699563
    m_Localized: "\uACB0\uACFC\uB294 \uC544\uC9C1\uC778\uB370 \uC124\uBA85\uBD80\uD130
      \uD558\uB124. \uCC38 \uB300\uB2E8\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699564
    m_Localized: "\uACB0\uACFC\uB791 \uD310\uB2E8\uC744 \uB098\uB220\uC11C \uC801\uC5B4\uBD10\uC57C\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699565
    m_Localized: "\uACB0\uACFC\uB97C \uC194\uC9C1\uD558\uAC8C \uB9D0\uC500\uD574
      \uC8FC\uC154\uC11C \uAC10\uC0AC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699566
    m_Localized: "\uACB0\uACFC\uBCF4\uB2E4 \uC124\uBA85\uC774 \uBA3C\uC800 \uB098\uC624\uB294
      \uB290\uB08C\uC778\uB370\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699567
    m_Localized: "\uACB0\uACFC\uBCF4\uB2E4 \uC124\uBA85\uC774 \uBA3C\uC800 \uB098\uC624\uB294
      \uB290\uB08C\uC778\uB370\uC694. \uCC38 \uB300\uB2E8\uD558\uC2DC\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699568
    m_Localized: "\uACB0\uACFC\uBCF4\uB2E4 \uC124\uBA85\uC774 \uBA3C\uC800 \uB098\uC624\uC2DC\uB294\uAD70\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699569
    m_Localized: "\uACB0\uACFC\uBCF4\uB2E4 \uC124\uBA85\uC774 \uBA3C\uC800 \uB098\uC624\uC2DC\uB294\uAD70\uC694.
      \uCC38 \uB300\uB2E8\uD558\uC2ED\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699570
    m_Localized: "\uACB0\uB860 \uC548 \uC11C\uB450\uB974\uB294 \uAC74 \uC88B\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699571
    m_Localized: "\uACB0\uB860 \uC548 \uC11C\uB450\uB974\uB294 \uAC74 \uC88B\uB124\uC694.
      \uADF8 \uC810\uC740 \uC778\uC815\uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699572
    m_Localized: "\uACB0\uB860\uBD80\uD130 \uB0B4\uB9AC\uB294 \uAC83\uBCF4\uB2E8
      \uBB3C\uC5B4\uBCF4\uB294 \uAC8C \uB0AB\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699573
    m_Localized: "\uACB0\uB860\uBD80\uD130 \uC548 \uB0B4\uB294 \uAC74 \uC88B\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699574
    m_Localized: "\uACB0\uB860\uBD80\uD130 \uC548 \uB0B4\uB294 \uAC74 \uC88B\uB124.
      \uADF8\uAC74 \uC778\uC815."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699575
    m_Localized: "\uACB0\uB860\uBD80\uD130 \uC815\uD574 \uB193\uACE0 \uB9D0\uD558\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699576
    m_Localized: "\uACB0\uB860\uBD80\uD130 \uC815\uD574 \uB193\uACE0 \uB9D0\uD558\uB124.
      \uCC38 \uB300\uB2E8\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699577
    m_Localized: "\uACB0\uB860\uC744 \uC11C\uB450\uB974\uC9C0 \uC54A\uC73C\uC2DC\uB294
      \uC810\uC740 \uC88B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699578
    m_Localized: "\uACB0\uB860\uC744 \uC11C\uB450\uB974\uC9C0 \uC54A\uC73C\uC2DC\uB294
      \uC810\uC740 \uC88B\uC2B5\uB2C8\uB2E4. \uADF8 \uC810\uC740 \uC778\uC815\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699579
    m_Localized: "\uACB0\uC0B0\uC744 \uD655\uC778\uD558\uACE0 \uB2E4\uB978 \uC885\uBAA9\uC774\uB098
      \uC608\uC0B0\uC73C\uB85C \uB2E4\uC74C \uC791\uC5C5\uC744 \uC900\uBE44\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699580
    m_Localized: "\uACBD\uACE0"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699581
    m_Localized: "\uACBD\uC601 \uAD00\uB828 \uB17C\uB780\uC740 \uB2E8\uAE30 \uBE44\uC6A9\uBCF4\uB2E4
      \uC124\uBA85\uC744 \uC2E0\uB8B0\uD560 \uC218 \uC788\uB294\uC9C0\uAC00 \uB354
      \uC624\uB798 \uB0A8\uAE30\uB3C4 \uD55C\uB2E4. \uD6C4\uC18D \uACF5\uC2DC\uC640
      \uCC45\uC784\uC790\uC758 \uB300\uC751\uC774 \uC911\uC694\uD55C \uAD00\uCC30
      \uB300\uC0C1\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699582
    m_Localized: "\uACBD\uC601\xB7\uC2E0\uB8B0"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699583
    m_Localized: "\uACBD\uC601\uAD8C"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699584
    m_Localized: "\uACBD\uC601\uAD8C: \uC2E4\uC81C \uC9C0\uBD84 50% \uCD08\uACFC
      \uD544\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699585
    m_Localized: "\uACBD\uC601\uAD8C\uC744 \uAC00\uC9C4 \uD68C\uC0AC\uC640 \uB2E4\uB978
      \uB9E4\uC785 \uB300\uC0C1 \uC885\uBAA9\uC744 \uC120\uD0DD\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699586
    m_Localized: "\uACBD\uC601\uC9C4"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699587
    m_Localized: "\uACBD\uC601\uC9C4 \uAD50\uCCB4"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699588
    m_Localized: "\uACBD\uC601\uC9C4\uC758 \uC124\uBA85\uC774 \uC77C\uAD00\uC801\uC778\uC9C0\uB294
      \uC2E4\uC801\uACFC \uBCC4\uAC1C\uB85C \uAE30\uC5C5 \uC2E0\uB8B0\uB97C \uBC14\uAFC0
      \uC218 \uC788\uB2E4. \uC758\uC0AC\uACB0\uC815 \uAD6C\uC870\uC640 \uC2E4\uC81C
      \uCC45\uC784 \uC18C\uC7AC\uB97C \uB098\uB220 \uC77D\uC5B4\uC57C \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699589
    m_Localized: "\uACC4\uC18D \uB9D0\uAF2C\uB9AC\uB97C \uC7A1\uC73C\uC2DC\uB294\uAD70\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699590
    m_Localized: "\uACC4\uC18D \uB9D0\uAF2C\uB9AC\uB97C \uC7A1\uC73C\uC2DC\uB294\uAD70\uC694.
      \uB9D0\uC500\uC744 \uAC00\uB824 \uC8FC\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699591
    m_Localized: "\uACC4\uC18D \uB9D0\uAF2C\uB9AC\uB9CC \uC7A1\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699592
    m_Localized: "\uACC4\uC18D \uB9D0\uAF2C\uB9AC\uB9CC \uC7A1\uB124\uC694. \uB9D0
      \uC880 \uAC00\uB824\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699593
    m_Localized: "\uACC4\uC18D \uC22B\uC790\uB9CC \uBCF4\uB2E4\uAC00 \uC7A0\uC2DC
      \uC26C\uC5B4 \uAC00\uB294 \uAE30\uBD84\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699594
    m_Localized: "\uACC4\uC18D\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699595
    m_Localized: "\uACC4\uC57D"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699596
    m_Localized: "\uACC4\uC57D \uC18C\uC2DD\uC740 \uBC1C\uC8FC\uC0AC, \uACF5\uAE09\uC0AC,
      \uB0A9\uD488\uC744 \uB9E1\uB294 \uD611\uB825\uC0AC\uC758 \uC774\uD574\uB97C
      \uD568\uAED8 \uBC14\uAFC0 \uC218 \uC788\uB2E4. \uCCB4\uACB0 \uBC1C\uD45C\uC640
      \uC2E4\uC81C \uB0A9\uD488\xB7\uB300\uAE08 \uD68C\uC218 \uC0AC\uC774\uC5D0\uB294
      \uC2DC\uAC04\uC774 \uD544\uC694\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699597
    m_Localized: "\uACC4\uC57D\xB7\uACF5\uAE09\uB9DD"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699598
    m_Localized: "\uACC4\uC88C \uB2EB\uACE0 \uC2F6\uC740 \uB9C8\uC74C\uC740 \uC774\uD574\uD568..."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699599
    m_Localized: "\uACC4\uC88C \uC774\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699600
    m_Localized: "\uACC4\uC88C \uC774\uCCB4"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699601
    m_Localized: "\uACC4\uC88C \uC7A0\uAE40"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699602
    m_Localized: "\uACC4\uC88C\uB791 \uB108\uB791 \uAC19\uC740 \uAC74 \uC544\uB2C8\uC796\uC544.
      \uC228 \uC880 \uC26C\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699603
    m_Localized: "\uACC4\uD68D \uBC1C\uD45C \uC774\uD6C4 \uC2E4\uC81C \uC9D1\uD589\uACFC
      \uD6C4\uC18D \uBCF4\uACE0 \uC0AC\uC774\uC758 \uAC04\uACA9\uC744 \uC0B4\uD3B4\uBCFC
      \uD544\uC694\uAC00 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699604
    m_Localized: "\uACC4\uD68D \uC885\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699605
    m_Localized: "\uACE0 \uD558\uB124\uC694. \uC9C1\uC811 \uD655\uC778\uD55C \uC598\uAE30\uB294
      \uC544\uB2D9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699606
    m_Localized: "\uACE0\uAC00:"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699607
    m_Localized: "\uACE0\uAC1D \uD55C \uACF3\uC5D0 \uC758\uC874\uB3C4\uAC00 \uCEE4\uC9C0\uB294\uC9C0,
      \uB9E4\uCD9C \uB2E4\uBCC0\uD654\uB85C \uC774\uC5B4\uC9C0\uB294\uC9C0 \uC9C0\uCF1C\uBCFC
      \uD544\uC694\uAC00 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699608
    m_Localized: "\uACE0\uB798"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699609
    m_Localized: "\uACE0\uC6A9"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699610
    m_Localized: "\uACE0\uC704\uD5D8"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699611
    m_Localized: "\uACF5\uAC1C \uBE44\uC728\uC740 10~90% \uC815\uC218\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699612
    m_Localized: "\uACF5\uAC1C \uC885\uBAA9 \uC0C1\uD0DC \uC548\uB0B4"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699613
    m_Localized: "\uACF5\uAC1C\uB418\uBA74 \uD22C\uC790\uC790\uB9C8\uB2E4 \uB2E4\uB974\uAC8C
      \uBC1B\uC544\uB4E4\uC785\uB2C8\uB2E4.\n\uD6C4\uC18D \uD655\uC778 \uBCF4\uB3C4\uAC00
      \uB098\uC62C \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699614
    m_Localized: "\uACF5\uAE09"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699615
    m_Localized: "\uACF5\uAE09\uC0AC\uC758 \uC131\uACFC\uB97C \uC790\uAE30 \uD68C\uC0AC\uC758
      \uC131\uC7A5\uC73C\uB85C \uC5F0\uACB0\uD558\uB294 \uD22C\uC790\uC790\uB3C4
      \uC788\uC9C0\uB9CC, \uAC70\uB798 \uAD00\uACC4\uC758 \uAC15\uB3C4\uB97C \uACFC\uC7A5\uD558\uB294
      \uD574\uC11D\uB3C4 \uB098\uC62C \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699616
    m_Localized: "\uACF5\uC6A9 \uB77C\uC6B4\uC9C0 \xB7 \uBA54\uC2DC\uC9C0\uB97C \uB20C\uB7EC
      \uCC38\uC5EC\uC790 \uC120\uD0DD"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699617
    m_Localized: "\uACF5\uC6A9 \uB77C\uC6B4\uC9C0 \uB610\uB294 \uB9AC\uB529\uBC29\uC744
      \uC120\uD0DD\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699618
    m_Localized: "\uACF5\uC6A9 \uB77C\uC6B4\uC9C0\uC5D0\uC11C \uB2C9\uB124\uC784
      \uC120\uD0DD \u2192 \uB0B4 \uB9AC\uB529\uBC29 \u2192 \uCCAB \uD68C\uC6D0 \uCD08\uB300"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699619
    m_Localized: "\uACF5\uD3EC"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699620
    m_Localized: "\uACFC\uAC70 \uBE44\uC2B7\uD55C \uBCC0\uD654\uB85C \uC190\uC2E4\uC744
      \uACAA\uC740 \uD22C\uC790\uC790\uB294 \uC774\uBC88\uC5D0\uB3C4 \uD655\uC778\uC744
      \uC624\uB798 \uAE30\uB2E4\uB9B4 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699621
    m_Localized: "\uACFC\uBC18 \uC9C0\uBD84\uC744 \uD655\uBCF4\uD55C \uAE30\uC5C5\uC5D0\uC11C
      \uACBD\uC601 \uACB0\uC815\uC744 \uB0B4\uB9B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699622
    m_Localized: "\uACFC\uC5F4"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699623
    m_Localized: "\uAD00\uB828 \uAE30\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699624
    m_Localized: "\uAD00\uB828 \uAE30\uC5C5\uC758 \uC2E4\uC801\uC5D0 \uC601\uD5A5\uC744
      \uC904 \uB9CC\uD07C \uC911\uC694\uD55C \uAC70\uB798\uC778\uC9C0 \uD655\uC778\uB418\uC9C0
      \uC54A\uC740 \uBD80\uBD84\uC774 \uB0A8\uC544 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699625
    m_Localized: "\uAD00\uB828 \uB2F9\uC0AC\uC790\uC758 \uBC18\uB860\uACFC \uD655\uC778\uB418\uC9C0
      \uC54A\uC740 \uC8FC\uC7A5\uC744 \uAD6C\uBD84\uD574\uC11C \uC77D\uC5B4\uC57C
      \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699626
    m_Localized: "\uAD00\uB9DD"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699627
    m_Localized: "\uAD00\uC138"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699628
    m_Localized: "\uAD00\uC2EC\uC774 \uC2E4\uC81C \uACE0\uAC1D \uC99D\uAC00\uB85C
      \uC774\uC5B4\uC9C0\uB294\uC9C0, \uCD08\uAE30 \uAE30\uB300\uAC00 \uC904\uC5B4\uB4DC\uB294\uC9C0
      \uC9C0\uCF1C\uBCFC \uC0AC\uC548\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699629
    m_Localized: "\uAD00\uC804 \uAC00\uB2A5 \xB7 \uD0DC\uBE14\uB9BF 2\uC758 \uC131\uC7A5\xB7\uAD8C\uD55C\uC5D0\uC11C
      \uB9AC\uB529\uBC29\uC744 \uAC1C\uC124\uD558\uC138\uC694.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699630
    m_Localized: "\uAD00\uCC30"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699631
    m_Localized: "\uAD00\uCC30 \u2192 \uBE44\uAD50 \u2192 \uD310\uB2E8"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699632
    m_Localized: "\uAD00\uCC30. \uD310\uB2E8. \uADF8\uB9AC\uACE0 \uD55C \uBC88\uC758
      \uC120\uD0DD."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699633
    m_Localized: "\uAD00\uCC30\uD55C \uC704\uD5D8\uACFC \uC790\uC2E0\uC758 \uACBD\uD5D8\uC744
      \uC7AC\uD3C9\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699634
    m_Localized: "\uAD00\uCE21\uB41C \uBCC0\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699635
    m_Localized: "\uAD1C\uD788 \uB9D0\uC744 \uC138\uAC8C \uD588\uC5B4\uC694. \uC5EC\uAE30\uC11C
      \uBA48\uCD9C\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699636
    m_Localized: "\uAD1C\uD788 \uB9D0\uC744 \uC138\uAC8C \uD588\uC5B4\uC694. \uC5EC\uAE30\uC11C
      \uBA48\uCD9C\uAC8C\uC694. \uB2E4\uC2DC \uC0AC\uACFC\uD560\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699637
    m_Localized: "\uAD1C\uD788 \uC138\uAC8C \uB9D0\uD588\uB124. \uADF8\uB9CC\uD560\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699638
    m_Localized: "\uAD1C\uD788 \uC138\uAC8C \uB9D0\uD588\uB124. \uADF8\uB9CC\uD560\uAC8C.
      \uB2E4\uC2DC \uC0AC\uACFC\uD560\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699639
    m_Localized: "\uAD6C\uB9E4 \uACBD\uD5D8\uACFC \uD22C\uC790 \uC218\uC775 \uACBD\uD5D8\uC774
      \uC11E\uC5EC \uD3C9\uAC00\uB97C \uC65C\uACE1\uD558\uC9C0 \uC54A\uB294\uC9C0
      \uC0B4\uD3B4\uBD10\uC57C \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699640
    m_Localized: "\uAD6C\uC5B4\uCCB4\xB7\uADFC\uC0AC \uC190\uC775"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699641
    m_Localized: "\uAD6D\uBBFC\uAE08\uC735"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699642
    m_Localized: "\uAD81\uAE08\uD558\uB124\uC694. {symbol}\uC5D0\uC11C \uB208\uC5EC\uACA8\uBCFC
      \uAC8C \uC788\uC744\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699643
    m_Localized: "\uAD81\uAE08\uD55C\uB370 {symbol} \uBB50\uBD80\uD130 \uBCF4\uBA74
      \uB428?"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699644
    m_Localized: "\uADDC\uC81C"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699645
    m_Localized: "\uADF8 \uAC00\uB2A5\uC131\uB3C4 \uC0DD\uAC01\uD574 \uBCFC\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699646
    m_Localized: "\uADF8 \uAC00\uB2A5\uC131\uB3C4 \uC0DD\uAC01\uD574 \uBCFC\uAC8C\uC694.
      \uADF8 \uC810\uC740 \uC778\uC815\uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699647
    m_Localized: "\uADF8 \uAC00\uB2A5\uC131\uB3C4 \uC5FC\uB450\uC5D0 \uB450\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699648
    m_Localized: "\uADF8 \uAC00\uB2A5\uC131\uB3C4 \uC5FC\uB450\uC5D0 \uB450\uACA0\uC2B5\uB2C8\uB2E4.
      \uADF8 \uC810\uC740 \uC778\uC815\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699649
    m_Localized: "\uADF8 \uACB0\uACFC\uB294 \uC778\uC815."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699650
    m_Localized: "\uADF8 \uACB0\uACFC\uB294 \uC778\uC815\uD560 \uB9CC\uD558\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699651
    m_Localized: "\uADF8 \uACB0\uACFC\uB294 \uC778\uC815\uD560 \uB9CC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699652
    m_Localized: "\uADF8 \uACB0\uACFC\uBA74 \uC18D\uC0C1\uD560 \uB9CC\uD558\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699653
    m_Localized: "\uADF8 \uACB0\uB860\uC5D0\uB294 \uB3D9\uC758\uD558\uAE30 \uC5B4\uB835\uC2B5\uB2C8\uB2E4.
      \uADFC\uAC70\uBD80\uD130 \uBCF4\uC2DC\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699654
    m_Localized: "\uADF8 \uACB0\uB860\uC5D0\uB294 \uB3D9\uC758\uD558\uAE30 \uC5B4\uB835\uC2B5\uB2C8\uB2E4.
      \uADFC\uAC70\uBD80\uD130 \uBCF4\uC2DC\uC8E0. \uC800\uB294 \uB2E4\uB974\uAC8C
      \uC0DD\uAC01\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699655
    m_Localized: "\uADF8 \uACB0\uB860\uC740 \uC544\uB2C8\uC9C0. \uADFC\uAC70\uBD80\uD130
      \uAC00\uC838\uC640."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699656
    m_Localized: "\uADF8 \uACB0\uB860\uC740 \uC544\uB2C8\uC9C0. \uADFC\uAC70\uBD80\uD130
      \uAC00\uC838\uC640. \uB09C \uB2E4\uB974\uAC8C \uBD04."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699657
    m_Localized: "\uADF8 \uACB0\uB860\uC740 \uC880 \uB2E4\uB974\uAC8C \uBD10\uC694.
      \uADFC\uAC70\uBD80\uD130 \uBCF4\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699658
    m_Localized: "\uADF8 \uACB0\uB860\uC740 \uC880 \uB2E4\uB974\uAC8C \uBD10\uC694.
      \uADFC\uAC70\uBD80\uD130 \uBCF4\uC8E0. \uC800\uB294 \uB2E4\uB974\uAC8C \uC0DD\uAC01\uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699659
    m_Localized: "\uADF8 \uAD00\uC810\uB3C4 \uCC38\uACE0\uD574\uBCFC\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699660
    m_Localized: "\uADF8 \uB9D0 \uADF8\uB300\uB85C \uBBFF\uAE30\uC5D4 \uC544\uC9C1
      \uCC1C\uCC1C\uD568"
    m_Metadata:
      m_Items: []
  - m_Id: 1383699661
    m_Localized: "\uADF8 \uB9D0 \uB4E4\uC73C\uB2C8 \uD55C \uBC88 \uB354 \uC0DD\uAC01\uD558\uAC8C
      \uB418\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699662
    m_Localized: "\uADF8 \uB9D0 \uCDE8\uC18C. \uB0B4\uAC00 \uC880 \uD765\uBD84\uD588\uC74C."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699663
    m_Localized: "\uADF8 \uB9D0 \uCDE8\uC18C. \uB0B4\uAC00 \uC880 \uD765\uBD84\uD588\uC74C.
      \uB2E4\uC2DC \uC0AC\uACFC\uD560\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699664
    m_Localized: "\uADF8 \uB9D0\uC500\uC740 \uC5B4\uC774\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699665
    m_Localized: "\uADF8 \uB9D0\uC500\uC740 \uC5B4\uC774\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4.
      \uB9D0\uC500\uC744 \uAC00\uB824 \uC8FC\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699666
    m_Localized: "\uADF8 \uB9D0\uC740 \uAC70\uB450\uACA0\uC2B5\uB2C8\uB2E4. \uAC10\uC815\uC801\uC73C\uB85C
      \uBC18\uC751\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699667
    m_Localized: "\uADF8 \uB9D0\uC740 \uAC70\uB450\uACA0\uC2B5\uB2C8\uB2E4. \uAC10\uC815\uC801\uC73C\uB85C
      \uBC18\uC751\uD588\uC2B5\uB2C8\uB2E4. \uB2E4\uC2DC \uC0AC\uACFC\uB4DC\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699668
    m_Localized: "\uADF8 \uB9D0\uC740 \uC880 \uC5B4\uC774\uC5C6\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699669
    m_Localized: "\uADF8 \uB9D0\uC740 \uC880 \uC5B4\uC774\uC5C6\uB124\uC694. \uB9D0
      \uC880 \uAC00\uB824\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699670
    m_Localized: "\uADF8 \uB9D0\uC740 \uCDE8\uC18C\uD560\uAC8C\uC694. \uAC10\uC815\uC774
      \uC55E\uC130\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699671
    m_Localized: "\uADF8 \uB9D0\uC740 \uCDE8\uC18C\uD560\uAC8C\uC694. \uAC10\uC815\uC774
      \uC55E\uC130\uB124\uC694. \uB2E4\uC2DC \uC0AC\uACFC\uD560\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699672
    m_Localized: "\uADF8 \uBC29\uC5D0\uC11C \uCAD3\uACA8\uB0A8. \uB0B4 \uACBD\uD5D8\uC740
      \uBCC4\uB85C\uC784."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699673
    m_Localized: "\uADF8 \uBC29\uC5D0\uC11C \uCAD3\uACA8\uB0AC\uC5B4\uC694. \uC81C
      \uACBD\uD5D8\uC740 \uBCC4\uB85C\uC600\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699674
    m_Localized: "\uADF8 \uBC29\uC5D0\uC11C \uCD94\uBC29\uB2F9\uD588\uC2B5\uB2C8\uB2E4.
      \uC81C \uACBD\uD5D8\uC740 \uC88B\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699675
    m_Localized: "\uADF8 \uBD80\uBD84\uC5D0\uB294 \uB3D9\uC758\uD569\uB2C8\uB2E4.
      \uB354 \uC9C0\uCF1C\uBCF4\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699676
    m_Localized: "\uADF8 \uBD80\uBD84\uC5D0\uB294 \uB3D9\uC758\uD569\uB2C8\uB2E4.
      \uB354 \uC9C0\uCF1C\uBCF4\uACA0\uC2B5\uB2C8\uB2E4. \uADF8 \uC810\uC740 \uC778\uC815\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699677
    m_Localized: "\uADF8 \uBD80\uBD84\uC740 \uB9DE\uB294 \uAC83 \uAC19\uC544\uC694.
      \uC880 \uB354 \uBCF4\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699678
    m_Localized: "\uADF8 \uBD80\uBD84\uC740 \uB9DE\uB294 \uAC83 \uAC19\uC544\uC694.
      \uC880 \uB354 \uBCF4\uC8E0. \uADF8 \uC810\uC740 \uC778\uC815\uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699679
    m_Localized: "\uADF8 \uBD80\uBD84\uC740 \uB9DE\uC9C0. \uB354 \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699680
    m_Localized: "\uADF8 \uBD80\uBD84\uC740 \uB9DE\uC9C0. \uB354 \uBCF4\uC790. \uADF8\uAC74
      \uC778\uC815."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699681
    m_Localized: "\uADF8 \uC124\uBA85\uB9CC\uC73C\uB85C\uB294 \uBC18\uB300 \uAC00\uB2A5\uC131\uC744
      \uBC30\uC81C\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699682
    m_Localized: "\uADF8 \uC124\uBA85\uB9CC\uC73C\uB85C\uB294 \uBC18\uB300 \uAC00\uB2A5\uC131\uC744
      \uBC30\uC81C\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uC800\uB294 \uB2E4\uB974\uAC8C
      \uC0DD\uAC01\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1383699683
