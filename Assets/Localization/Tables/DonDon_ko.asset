  - m_Id: 1392087602
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uADF8
      \uB9D0\uC740 \uAC70\uB450\uACA0\uC2B5\uB2C8\uB2E4. \uAC10\uC815\uC801\uC73C\uB85C
      \uBC18\uC751\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087603
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uADF8
      \uBD80\uBD84\uC5D0\uB294 \uB3D9\uC758\uD569\uB2C8\uB2E4. \uB354 \uC9C0\uCF1C\uBCF4\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087604
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uADF8
      \uC124\uBA85\uB9CC\uC73C\uB85C\uB294 \uBC18\uB300 \uAC00\uB2A5\uC131\uC744
      \uBC30\uC81C\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087605
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uADF8
      \uC18C\uC2DD\uC758 \uCD9C\uCC98\uB97C \uD655\uC778\uD558\uC168\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087606
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uADF8
      \uD310\uB2E8\uC744 \uB4B7\uBC1B\uCE68\uD560 \uADFC\uAC70\uAC00 \uC788\uB294\uC9C0
      \uAD81\uAE08\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087607
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uADF8\uB7F0
      \uC2DD\uC73C\uB85C \uC6B0\uAE30\uC2DC\uBA74 \uB300\uD654\uAC00 \uB418\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087608
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uADF8\uB807\uAC8C
      \uB2E8\uC5B8\uD558\uC2E4 \uC218 \uC788\uB2E4\uB2C8 \uBD80\uB7FD\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087609
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uADF8\uB807\uAC8C
      \uD310\uB2E8\uD558\uC2E0 \uC774\uC720\uB294 \uC774\uD574\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087610
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uAE09\uD558\uAC8C
      \uB9CC\uD68C\uD558\uB824 \uD558\uC9C0 \uC54A\uC73C\uC154\uB3C4 \uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087611
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uB0A8\uC544
      \uC788\uC5B4\uB3C4 \uB2EC\uB77C\uC9C8 \uAC83 \uAC19\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.
      \uC774\uB9CC \uB098\uAC00\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087612
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uB204\uAC00
      \uC774\uACBC\uB294\uC9C0\uBCF4\uB2E4 \uBB34\uC5C7\uC744 \uD655\uC778\uD588\uB294\uC9C0\uAC00
      \uD544\uC694\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087613
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uB204\uAD6C\uB098
      \uD655\uC778\uD560 \uC218 \uC788\uB294 \uB0B4\uC6A9\uC778\uC9C0 \uBB3B\uACE0
      \uC2F6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087614
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uB2E4\uB978
      \uC758\uACAC\uC744 \uB0C8\uB2E4\uACE0 \uC798\uBABB\uB41C \uD310\uB2E8\uC774
      \uB418\uB294 \uAC83\uC740 \uC544\uB2D9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087615
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uB2E4\uB978
      \uC774\uC57C\uAE30\uBCF4\uB2E4 {symbol} \uCCB4\uACB0\uC744 \uBA3C\uC800 \uBCF4\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087616
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uB2E4\uC2DC
      \uC77D\uC5B4 \uBCF4\uB2C8 \uC81C \uB9D0\uC5D0\uB3C4 \uBB38\uC81C\uAC00 \uC788\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087617
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uB354\uB294
      \uADF8\uB7F0 \uD0DC\uB3C4\uB97C \uCC38\uAE30 \uC5B4\uB835\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087618
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uB450
      \uBD84 \uB2E4 \uAC10\uC815\uC774 \uC62C\uB77C\uC628 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4.
      \uC7A0\uC2DC \uC26C\uC2DC\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087619
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uB450
      \uBD84 \uBAA8\uB450 \uC7A0\uC2DC \uBA48\uCD94\uACE0 \uADFC\uAC70\uBD80\uD130
      \uD655\uC778\uD558\uC2DC\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087620
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uB4E3\uB2E4
      \uBCF4\uB2C8 \uACB0\uB860\uC740 \uC774\uBBF8 \uC815\uD574 \uB450\uC2E0 \uB4EF\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087621
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uB9C8\uC74C\uC774
      \uBB34\uAC70\uC6B0\uC2DC\uACA0\uC9C0\uB9CC \uC7A0\uC2DC \uC26C\uC5B4 \uAC00\uC154\uB3C4
      \uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087622
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uB9D0\uC500\uC740
      \uB4E3\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uCC9C\uCC9C\uD788 \uC815\uB9AC\uD574
      \uBCF4\uC2DC\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087623
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uB9D0\uC500\uC744
      \uB4E3\uACE0 \uBCF4\uB2C8 \uC81C\uAC00 \uBE60\uB728\uB9B0 \uBD80\uBD84\uC774
      \uC788\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087624
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uB9D0\uC500\uC758
      \uC790\uC2E0\uAC10\uC740 \uC0C1\uB2F9\uD558\uC2DC\uAD70\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087625
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uBAA9\uC774
      \uBED0\uADFC\uD574\uC11C \uC790\uC138\uB97C \uACE0\uCCE4\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087626
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uBB3C\uC744
      \uB9C8\uC2DC\uB2C8 \uC870\uAE08 \uB0AB\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087627
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uBC16\uC774
      \uC870\uC6A9\uD558\uB2C8 \uD0A4\uBCF4\uB4DC \uC18C\uB9AC\uB9CC \uB4E4\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087628
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uBC18\uB300\uB85C
      \uC6C0\uC9C1\uC77C \uAC00\uB2A5\uC131\uC740 \uC5B4\uB5BB\uAC8C \uC0DD\uAC01\uD558\uC2ED\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087629
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uBC29\uC7A5\uB2D8
      \uB355\uC5D0 {symbol}\uC5D0\uC11C \uC2E4\uC81C {pct}% \uC218\uC775\uC744 \uC5BB\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087630
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uBC29\uC7A5\uB2D8,
      {symbol} \uB9AC\uB529 \uACB0\uACFC {pct}%\uC5D0 \uB300\uD574\uC11C\uB3C4 \uB9D0\uC500\uD574
      \uC8FC\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087631
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uBC29\uC7A5\uB2D8,
      \uB450 \uBD84\uC758 \uB300\uD654\uB97C \uD655\uC778\uD574 \uC8FC\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087632
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uBC29\uC7A5\uB2D8,
      \uC0C1\uD669\uC774 \uB354 \uCEE4\uC9C0\uAE30 \uC804\uC5D0 \uD655\uC778 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087633
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uBC29\uC7A5\uB2D8,
      \uC11C\uB85C\uB97C \uD5A5\uD55C \uACF5\uACA9\uC744 \uBA48\uCDB0 \uC8FC\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087634
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uBC29\uC7A5\uB2D8,
      \uD45C\uD604\uC774 \uC9C0\uB098\uCCD0\uC9C0\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087635
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uBC29\uC7A5\uB2D8\uAED8\uC11C
      \uC774 \uB300\uD654\uB97C \uBCF4\uACE0 \uACC4\uC2E0\uC9C0 \uAD81\uAE08\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087636
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uBC29\uC7A5\uB2D8\uC758
      \uC911\uC7AC\uAC00 \uD544\uC694\uD574 \uBCF4\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087637
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uBD88\uD544\uC694\uD558\uAC8C
      \uBAA9\uC18C\uB9AC\uB97C \uB192\uC600\uC2B5\uB2C8\uB2E4. \uC5EC\uAE30\uC11C
      \uBA48\uCD94\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087638
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uC0C1\uB300\uB97C
      \uBB34\uC2DC\uD558\uB294 \uB9D0\uC740 \uADF8\uB9CC\uD558\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087639
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uC0C1\uB300\uB97C
      \uD5A5\uD55C \uD45C\uD604\uC740 \uC801\uC808\uD558\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087640
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uC11C\uB85C\uC5D0\uAC8C
      \uD5A5\uD55C \uB9D0\uC740 \uC904\uC774\uC168\uC73C\uBA74 \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087641
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uC124\uBA85\uC740
      \uD6CC\uB96D\uD55C\uB370 \uD655\uC778\uD560 \uBD80\uBD84\uC740 \uB0A8\uC544
      \uC788\uAD70\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087642
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uC2DC\uAC04\uC744
      \uBCF4\uB2C8 \uB07C\uB2C8\uB97C \uB193\uCE60 \uBED4\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087643
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uC2DC\uC7A5\uBCF4\uB2E4
      \uBA3C\uC800 \uC815\uB2F5\uC744 \uC544\uC2DC\uB294 \uAC83\uCC98\uB7FC \uB9D0\uC500\uD558\uC2ED\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087644
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uC5B4\uB290
      \uC2DC\uC810\uC758 \uC815\uBCF4\uB97C \uAE30\uC900\uC73C\uB85C \uD558\uC2E0
      \uB9D0\uC500\uC785\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087645
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uC5EC\uAE30\uAE4C\uC9C0
      \uD558\uACA0\uC2B5\uB2C8\uB2E4. \uB354\uB294 \uC774 \uBC29\uC5D0 \uC788\uC9C0
      \uC54A\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087646
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uC758\uACAC\uC774
      \uB2E4\uB978 \uAC83\uC778\uB370 \uC81C\uAC00 \uB0A0\uCE74\uB86D\uAC8C \uBC18\uC751\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087647
    m_Localized: "\uC815\uB9D0\uB85C \uB9D0\uC500\uB4DC\uB9BD\uB2C8\uB2E4. \uC758\uACAC\uC774
      \uB2E4\uB978 \uBD80\uBD84\uC744 \uD558\uB098\uC529 \uB9D0\uC500\uD574 \uC8FC\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087648
