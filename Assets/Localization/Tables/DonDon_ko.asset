    m_Metadata:
      m_Items: []
  - m_Id: 1392087815
    m_Localized: "\uC8FC\uBB38 \uC5C6\uC774 \uAD6C\uACBD\uB9CC \uD558\uB294 \uC2DC\uAC04\uB3C4
      \uD544\uC694\uD558\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087816
    m_Localized: "\uC8FC\uBB38 \uC5C6\uC774\uB3C4 \uC2DC\uC7A5\uC740 \uACC4\uC18D
      \uC6C0\uC9C1\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087817
    m_Localized: "\uC8FC\uBB38 \uC608\uC0B0 {0:N0}\uC6D0\n\uB9E4\uC218 {1:N0}\uC6D0
      / \uB9E4\uB3C4 {2:N0}\uC6D0\n\uBB3C\uB7C9 {3:N0}\uC8FC \xB7 \uBBF8\uCCB4\uACB0
      {4}\uAC74\n\uD3C9\uAC00 \uD3EC\uD568 \uC190\uC775 {5:+#,##0;-#,##0;0}\uC6D0"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087818
    m_Localized: "\uC8FC\uBB38 \uC608\uC0B0 \uC0AC\uC6A9"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087819
    m_Localized: "\uC8FC\uBB38 \uC720\uD615  \uC9C0\uC815\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087820
    m_Localized: "\uC8FC\uBB38 \uC7A5\uCE58 \uC885\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087821
    m_Localized: "\uC8FC\uBB38 \uC885\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087822
    m_Localized: "\uC8FC\uBB38 \uD654\uBA74 \uC5F0\uACB0\uC744 \uD655\uC778\uD574
      \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087823
    m_Localized: "\uC8FC\uBB38 \uD655\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087824
    m_Localized: "\uC8FC\uBB38 \uD6C4 \uBCF4\uC720"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087825
    m_Localized: "\uC8FC\uBB38 \uD6C4 \uD604\uAE08"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087826
    m_Localized: "\uC8FC\uBB38\uD558\uC9C0 \uC54A\uC544\uB3C4 \uC2DC\uC7A5\uC740
      \uC6C0\uC9C1\uC785\uB2C8\uB2E4. W / S\uB85C \uC885\uBAA9\uC744 \uAD00\uCC30\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087827
    m_Localized: "\uC8FC\uBCC0 \uC0AC\uB78C\uC758 \uD638\uAC10\uC740 \uAD00\uC2EC\uC744
      \uB192\uC77C \uC218 \uC788\uC9C0\uB9CC \uC9C1\uC811 \uACAA\uC740 \uACBD\uD5D8\uB9CC\uD07C
      \uAC15\uD558\uAC8C \uC791\uC6A9\uD558\uC9C0 \uC54A\uC744 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
