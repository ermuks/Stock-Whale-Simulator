    m_Localized: "\uBD88\uD544\uC694\uD558\uAC8C \uBAA9\uC18C\uB9AC\uB97C \uB192\uC600\uC2B5\uB2C8\uB2E4.
      \uC5EC\uAE30\uC11C \uBA48\uCD94\uACA0\uC2B5\uB2C8\uB2E4. \uB2E4\uC2DC \uC0AC\uACFC\uB4DC\uB9BD\uB2C8\uB2E4."
