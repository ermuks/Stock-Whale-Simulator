      m_Items: []
  - m_Id: 1383700392
    m_Localized: "\uC11C\uB85C\uC5D0\uAC8C \uD5A5\uD55C \uB9D0\uC740 \uC904\uC774\uC168\uC73C\uBA74
      \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087040
    m_Localized: "\uC11C\uB85C\uC5D0\uAC8C \uD5A5\uD55C \uB9D0\uC740 \uC904\uC774\uC168\uC73C\uBA74
      \uD569\uB2C8\uB2E4. \uC0AC\uB78C\uBCF4\uB2E4 \uADFC\uAC70\uB97C \uBCF4\uC2DC\uC8E0."
    m_Metadata:
      m_Items: []
