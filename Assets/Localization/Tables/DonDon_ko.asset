    m_Localized: "\uC9C4\uC9DC. \uAC19\uC740 \uAC70 \uBD24\uB2E4\uACE0 \uACB0\uB860\uAE4C\uC9C0
      \uAC19\uC544\uC57C \uB428?"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087926
    m_Localized: "\uC9C4\uC9DC. \uACB0\uACFC\uB294 \uC544\uC9C1\uC778\uB370 \uC124\uBA85\uBD80\uD130
      \uD558\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087927
    m_Localized: "\uC9C4\uC9DC. \uACB0\uB860\uBD80\uD130 \uC548 \uB0B4\uB294 \uAC74
      \uC88B\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087928
    m_Localized: "\uC9C4\uC9DC. \uACB0\uB860\uBD80\uD130 \uC815\uD574 \uB193\uACE0
      \uB9D0\uD558\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087929
    m_Localized: "\uC9C4\uC9DC. \uAD1C\uD788 \uC138\uAC8C \uB9D0\uD588\uB124. \uADF8\uB9CC\uD560\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087930
    m_Localized: "\uC9C4\uC9DC. \uADF8 \uACB0\uB860\uC740 \uC544\uB2C8\uC9C0. \uADFC\uAC70\uBD80\uD130
      \uAC00\uC838\uC640."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087931
    m_Localized: "\uC9C4\uC9DC. \uADF8 \uB9D0 \uCDE8\uC18C. \uB0B4\uAC00 \uC880 \uD765\uBD84\uD588\uC74C."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087932
    m_Localized: "\uC9C4\uC9DC. \uADF8 \uBD80\uBD84\uC740 \uB9DE\uC9C0. \uB354 \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087933
    m_Localized: "\uC9C4\uC9DC. \uADF8 \uC124\uBA85\uC73C\uB85C \uBC18\uB300 \uAC00\uB2A5\uC131\uC774
      \uC5C6\uC5B4\uC9C0\uB294 \uAC74 \uC544\uB2D8."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087934
    m_Localized: "\uC9C4\uC9DC. \uADF8 \uC18C\uC2DD \uCD9C\uCC98\uB294 \uD655\uC778\uD568?"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087935
    m_Localized: "\uC9C4\uC9DC. \uADF8 \uD0DC\uB3C4 \uC9C4\uC9DC \uBABB \uCC38\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087936
    m_Localized: "\uC9C4\uC9DC. \uADF8 \uD310\uB2E8 \uADFC\uAC70\uAC00 \uBB50\uC784?"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087937
    m_Localized: "\uC9C4\uC9DC. \uADF8\uAC70 \uB2E4\uB978 \uC0AC\uB78C\uB3C4 \uD655\uC778
      \uAC00\uB2A5\uD55C \uAC70\uC784?"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087938
    m_Localized: "\uC9C4\uC9DC. \uADF8\uAC70 \uC5B8\uC81C \uC815\uBCF4\uC778\uB370?"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087939
    m_Localized: "\uC9C4\uC9DC. \uADF8\uAC74 \uAC00\uB2A5\uC131\uC774\uC9C0 \uD655\uC778\uB41C
      \uC0AC\uC2E4\uC740 \uC544\uB2C8\uC796\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087940
    m_Localized: "\uC9C4\uC9DC. \uADF8\uB7F4 \uAC00\uB2A5\uC131\uB3C4 \uC788\uACA0\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087941
    m_Localized: "\uC9C4\uC9DC. \uADF8\uB807\uAC8C \uBCF4\uB294 \uAC74 \uC774\uD574\uD568."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087942
    m_Localized: "\uC9C4\uC9DC. \uAE09\uD558\uAC8C \uB9CC\uD68C\uD558\uB824\uACE0\uB294
      \uD558\uC9C0 \uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087943
    m_Localized: "\uC9C4\uC9DC. \uB098\uB294 \uC5EC\uAE30\uAE4C\uC9C0\uB9CC \uD560\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087944
    m_Localized: "\uC9C4\uC9DC. \uB098\uB3C4 \uD655\uC815\uC740 \uC544\uB2D8. {symbol}
      \uB354 \uBD10\uC57C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087945
    m_Localized: "\uC9C4\uC9DC. \uB09C {symbol} {price}\uC6D0 \uCCB4\uACB0 \uBCF4\uB294
      \uC911."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087946
    m_Localized: "\uC9C4\uC9DC. \uB09C {symbol} \uB9AC\uB529 {pct}% \uC190\uC2E4\uC784.
      \uB0A8\uB4E4\uC740 \uC5B4\uB5A8\uC9C0 \uBAB0\uB77C\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087947
    m_Localized: "\uC9C4\uC9DC. \uB09C {symbol} \uB9AC\uB529\uC73C\uB85C {pct}% \uC218\uC775
      \uBD04."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087948
    m_Localized: "\uC9C4\uC9DC. \uB09C \uB2E4\uB978 \uB370\uC11C \uC2DC\uC7A5 \uBCF8\uB2E4.
      \uC774\uB9CC \uB098\uAC10."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087949
    m_Localized: "\uC9C4\uC9DC. \uB0A8\uC544 \uC788\uC5B4\uB3C4 \uB2EC\uB77C\uC9C8
      \uAC8C \uC5C6\uB124. \uB098\uAC10."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087950
    m_Localized: "\uC9C4\uC9DC. \uB0B4 \uAE30\uB85D\uC740 {symbol} \uB9AC\uB529 \uC2E4\uD604\uC190\uC775
      {amount}\uC6D0\uC784."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087951
    m_Localized: "\uC9C4\uC9DC. \uB0B4\uAC00 \uB9D0\uC774 \uC2EC\uD588\uB124. \uBBF8\uC548."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087952
    m_Localized: "\uC9C4\uC9DC. \uB204\uAC00 \uC774\uAE30\uB098 \uD558\uC9C0 \uB9D0\uACE0
      \uD655\uC778\uD55C \uAC78 \uC598\uAE30\uD558\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087953
    m_Localized: "\uC9C4\uC9DC. \uB2E4\uB974\uAC8C \uBCF8\uB2E4\uACE0 \uD2C0\uB9B0
      \uAC70\uB0D0?"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087954
    m_Localized: "\uC9C4\uC9DC. \uB2E4\uB978 \uC0AC\uB78C\uB4E4\uB3C4 \uBCF8\uB2E4.
      \uD45C\uD604 \uC880 \uB0AE\uCD94\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087955
    m_Localized: "\uC9C4\uC9DC. \uB2E4\uC2DC \uBCF4\uB2C8 \uB0B4 \uB9D0\uB3C4 \uBB38\uC81C\uC600\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087956
    m_Localized: "\uC9C4\uC9DC. \uB458 \uB2E4 \uAC10\uC815 \uC62C\uB77C\uC628 \uAC83
      \uAC19\uC740\uB370 \uC7A0\uAE50 \uC26C\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087957
    m_Localized: "\uC9C4\uC9DC. \uB458 \uB2E4 \uC7A0\uAE50 \uBA48\uCDB0. \uADFC\uAC70\uBD80\uD130
      \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087958
    m_Localized: "\uC9C4\uC9DC. \uB4E3\uACE0 \uBCF4\uB2C8 \uB0B4\uAC00 \uBE60\uB728\uB9B0
      \uAC83\uB3C4 \uC788\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087959
    m_Localized: "\uC9C4\uC9DC. \uB4E3\uACE0 \uC788\uC74C. \uCC9C\uCC9C\uD788 \uC598\uAE30\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087960
    m_Localized: "\uC9C4\uC9DC. \uB9D0\uAF2C\uB9AC\uB9CC \uC7A1\uACE0 \uC788\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087961
    m_Localized: "\uC9C4\uC9DC. \uB9D0\uB9CC \uB4E4\uC73C\uBA74 \uB300\uB2E8\uD55C
      \uD655\uC2E0\uC774\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087962
    m_Localized: "\uC9C4\uC9DC. \uB9D0\uC740 \uADF8\uB7F4\uB4EF\uD55C\uB370 \uD655\uC778\uC740
      \uB204\uAC00 \uD568?"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087963
    m_Localized: "\uC9C4\uC9DC. \uBAA9 \uBED0\uADFC\uD574\uC11C \uC790\uC138 \uC880
      \uBC14\uAFC8."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087964
    m_Localized: "\uC9C4\uC9DC. \uBB3C \uB9C8\uC2DC\uB2C8\uAE4C \uC880 \uB0AB\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087965
    m_Localized: "\uC9C4\uC9DC. \uBB50\uAC00 \uB2E4\uB978\uC9C0\uB9CC \uD558\uB098\uC529
      \uB9D0\uD574 \uBD10."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087966
    m_Localized: "\uC9C4\uC9DC. \uBC16\uC774 \uC870\uC6A9\uD574\uC11C \uD0A4\uBCF4\uB4DC
      \uC18C\uB9AC\uB9CC \uB4E4\uB9BC."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087967
    m_Localized: "\uC9C4\uC9DC. \uBC18\uB300\uB85C \uAC08 \uAC00\uB2A5\uC131\uC740
      \uC0DD\uAC01 \uC548 \uD568?"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087968
    m_Localized: "\uC9C4\uC9DC. \uBC29\uC7A5 \uB355\uC5D0 {symbol} \uC2E4\uC81C {pct}%
      \uBA39\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087969
    m_Localized: "\uC9C4\uC9DC. \uBC29\uC7A5 \uC774\uAC70 \uBCF4\uACE0 \uC788\uC74C?"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087970
    m_Localized: "\uC9C4\uC9DC. \uBC29\uC7A5, \uB0B4 {symbol} \uB9AC\uB529 \uACB0\uACFC
      {pct}%\uB3C4 \uC880 \uBD10."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087971
    m_Localized: "\uC9C4\uC9DC. \uBC29\uC7A5, \uB354 \uCEE4\uC9C0\uAE30 \uC804\uC5D0
      \uC880 \uBD10."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087972
    m_Localized: "\uC9C4\uC9DC. \uBC29\uC7A5, \uB9D0\uC774 \uB108\uBB34 \uC138\uC9C0\uC796\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087973
    m_Localized: "\uC9C4\uC9DC. \uBC29\uC7A5, \uC11C\uB85C \uACF5\uACA9\uD558\uB294
      \uAC70 \uC880 \uB9C9\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087974
    m_Localized: "\uC9C4\uC9DC. \uBC29\uC7A5, \uC9C0\uAE08 \uC2F8\uC6B0\uB294 \uAC83
      \uC880 \uBD10."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087975
    m_Localized: "\uC9C4\uC9DC. \uBC29\uC7A5\uC774 \uC880 \uB9D0\uB824\uC57C \uB418\uB294
      \uAC70 \uC544\uB2D8?"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087976
    m_Localized: "\uC9C4\uC9DC. \uBC8C\uC368 \uD655\uC2E0\uD55C\uB2E4\uACE0? \uB354
      \uBD10\uC57C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087977
    m_Localized: "\uC9C4\uC9DC. \uC0AC\uB78C \uAC74\uB4DC\uB9B0 \uAC74 \uB0B4\uAC00
      \uC798\uBABB\uD568."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087978
    m_Localized: "\uC9C4\uC9DC. \uC0AC\uB78C \uBB34\uC2DC\uD558\uB294 \uB9D0 \uC880
      \uADF8\uB9CC\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087979
    m_Localized: "\uC9C4\uC9DC. \uC0DD\uAC01 \uB2E4\uB978 \uAC74\uB370 \uB0B4\uAC00
      \uB0A0\uCE74\uB85C\uC6E0\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087980
    m_Localized: "\uC9C4\uC9DC. \uC11C\uB85C \uC0AC\uB78C \uAC74\uB4DC\uB9AC\uC9C0
      \uB9D0\uACE0 \uC598\uAE30\uB85C \uB3CC\uC544\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087981
    m_Localized: "\uC9C4\uC9DC. \uC18D \uC4F0\uB9AC\uACA0\uB2E4. \uC7A0\uAE50 \uC26C\uC5B4\uB3C4
      \uB428."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087982
    m_Localized: "\uC9C4\uC9DC. \uC2DC\uAC04 \uBCF4\uB2C8\uAE4C \uBC25\uB54C \uB193\uCE60
      \uBED4\uD588\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087983
    m_Localized: "\uC9C4\uC9DC. \uC2DC\uC7A5 \uC815\uB2F5 \uD63C\uC790 \uB2E4 \uC544\uB294
      \uAC83\uCC98\uB7FC \uB9D0\uD558\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087984
    m_Localized: "\uC9C4\uC9DC. \uC544\uC8FC \uB531 \uC798\uB77C \uB9D0\uD558\uB124.
      \uBD80\uB7FD\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087985
    m_Localized: "\uC9C4\uC9DC. \uC598\uAE30\uB3C4 \uC88B\uC740\uB370 {symbol} \uCCB4\uACB0\uBD80\uD130
      \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087986
    m_Localized: "\uC9C4\uC9DC. \uC5B4\uC774\uC5C6\uB124. \uB9D0 \uC880 \uAC00\uB824
      \uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087987
    m_Localized: "\uC9C4\uC9DC. \uC5EC\uAE30\uAE4C\uC9C0 \uD558\uC790. \uB354\uB294
      \uC5EC\uAE30 \uC548 \uC788\uC74C."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087988
    m_Localized: "\uC9C4\uC9DC. \uC6B0\uAE30\uAE30\uB9CC \uD558\uBA74 \uB300\uD654\uAC00
      \uB418\uB0D0?"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087989
    m_Localized: "\uC9C4\uC9DC. \uC774 \uB300\uD654 \uB354 \uD558\uAE30 \uC2EB\uB2E4.
      \uB098\uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087990
    m_Localized: "\uC9C4\uC9DC. \uC774 \uBD84\uC704\uAE30\uC5D0\uC11C \uC598\uAE30
      \uBABB \uD558\uACA0\uB2E4. \uB098\uAC10."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087991
    m_Localized: "\uC9C4\uC9DC. \uC815\uC2E0 \uCC28\uB824\uB77C. \uC120 \uB118\uACE0
      \uC788\uC796\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087992
    m_Localized: "\uC9C4\uC9DC. \uC9C0\uAE08 \uB108\uBB34 \uC790\uCC45\uD558\uC9C4
      \uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087993
    m_Localized: "\uC9C4\uC9DC. \uCEE4\uD53C \uB108\uBB34 \uC9C4\uD558\uAC8C \uD0D4\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087994
    m_Localized: "\uC9C4\uC9DC. \uD63C\uC790 \uB2E4 \uAC10\uB2F9\uD558\uB824 \uD558\uC9C4
      \uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087995
    m_Localized: "\uC9C4\uC9DC. \uD654\uBA74 \uC624\uB798 \uBD24\uB354\uB2C8 \uB208
      \uC544\uD504\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087996
    m_Localized: "\uC9C4\uC9DC. \uD654\uBA74 \uC7A0\uAE50 \uC548 \uBD10\uB3C4 \uB428.
      \uC228 \uC880 \uB3CC\uB824."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087997
    m_Localized: "\uC9C4\uC9DC. \uD655\uC2E0\uD55C\uB2E4\uB294 \uB9D0 \uB9D0\uACE0
      \uD655\uC778\uD560 \uAC78 \uC918."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087998
    m_Localized: "\uC9C4\uC9DC. \uD655\uC778\uBD80\uD130 \uD558\uC790\uB294 \uAC74
      \uB098\uB3C4 \uB3D9\uC758."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087999
    m_Localized: "\uC9C4\uC9DC\uB85C\uC694. {symbol} {price}\uC6D0 \uAE30\uC900\uC73C\uB85C
      \uB2E4\uC74C \uBCC0\uD654 \uBCF4\uACE0 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392088000
    m_Localized: "\uC9C4\uC9DC\uB85C\uC694. {symbol} {price}\uC6D0\uC778\uB370 \uC544\uC9C1
      \uD310\uB2E8\uC740 \uC548 \uD588\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1392088001
    m_Localized: "\uC9C4\uC9DC\uB85C\uC694. {symbol} {price}\uC6D0\uC778\uB370 \uC5B4\uB5BB\uAC8C
      \uBCF4\uC138\uC694?"
    m_Metadata:
      m_Items: []
