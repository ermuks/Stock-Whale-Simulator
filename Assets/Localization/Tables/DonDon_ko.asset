  - m_Id: 1392087079
    m_Localized: "\uC218\uC775\uB960 \uB192\uC740 \uC21C"
    m_Metadata:
      m_Items: []
  - m_Id: 1392087080
    m_Localized: "\uC218\uC775\uC744 \uACBD\uD5D8\uD55C \uC8FC\uC8FC\uB294 \uACBD\uC601\uC9C4\uC758
      \uD310\uB2E8\uC744 \uB354 \uC624\uB798 \uAE30\uB2E4\uB824\uC904 \uC218 \uC788\uB2E4.
      \uC190\uC2E4\uC744 \uACAA\uC740 \uC8FC\uC8FC\uB294 \uAC19\uC740 \uD22C\uC790
      \uACC4\uD68D\uC744 \uBE44\uC6A9 \uBD80\uB2F4\uC73C\uB85C \uBC1B\uC544\uB4E4\uC77C
      \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087081
    m_Localized: "\uC218\uC775\uC744 \uC5BB\uC5C8\uB358 \uD22C\uC790\uC790\uB294
      \uAC19\uC740 \uD68C\uC0AC\uB97C \uB354 \uC27D\uAC8C \uC2E0\uB8B0\uD560 \uC218
      \uC788\uB2E4. \uC190\uC2E4\uC744 \uACAA\uC740 \uD22C\uC790\uC790\uB294 \uC88B\uC740
      \uC18C\uC2DD\uC5D0\uB3C4 \uD655\uC778\uC744 \uB354 \uC694\uAD6C\uD560 \uC218
      \uC788\uB2E4."
