  - m_Id: 1392087519
    m_Localized: "watching how {symbol} trades around \xD0{price}."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087520
    m_Localized: "my eyes are on {symbol} fills near \xD0{price}, that's all i got."
    m_Metadata:
      m_Items: []
  - m_Id: 1392087521
    m_Localized: The {symbol} call left me with a loss of {pct}%. Others may differ.
    m_Metadata:
