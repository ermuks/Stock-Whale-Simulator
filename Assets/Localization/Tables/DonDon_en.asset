    m_Metadata:
      m_Items: []
  - m_Id: 1392088340
    m_Localized: Accounting
    m_Metadata:
      m_Items: []
  - m_Id: 1392088341
    m_Localized: It remains to be seen whether the response is more than a one-off
      announcement.
    m_Metadata:
      m_Items: []
  - m_Id: 1392088342
    m_Localized: Company income
    m_Metadata:
      m_Items: []
  - m_Id: 1392088343
