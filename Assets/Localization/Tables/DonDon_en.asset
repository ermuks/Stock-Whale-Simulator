    m_Metadata:
      m_Items: []
  - m_Id: 1383698491
    m_Localized: ' Realized P/L since taking over '
    m_Metadata:
      m_Items: []
  - m_Id: 1383698492
    m_Localized: " I'm overthinking this\u2026"
    m_Metadata:
      m_Items: []
